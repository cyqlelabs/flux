+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static ggml_backend_buffer_type types[GGML_CUDA_MAX_DEVICES]{};
+    if (!types[device].context) {
+        auto iface = ggml_backend_cuda_buffer_type_interface;
+        iface.alloc_buffer = ggml_cuda_paged_alloc;
+        iface.get_alignment = ggml_cuda_paged_alignment;
+        iface.get_alloc_size = ggml_cuda_paged_alloc_size;
+        types[device] = { iface, ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+            new ggml_backend_cuda_buffer_type_context{device, GGML_CUDA_NAME + std::to_string(device) + "_Paged"} };
+    }
+    return &types[device];
+#else
+    GGML_UNUSED(device);
+    return nullptr;
+#endif
+}
