+#if CUDA_VERSION >= 12040
+        int node = -1;
+        if (cuDeviceGetAttribute(&node, CU_DEVICE_ATTRIBUTE_HOST_NUMA_ID, prop.location.id) != CUDA_SUCCESS || node < 0) {
+            return false;
+        }
+        prop.location.type = CU_MEM_LOCATION_TYPE_HOST_NUMA;
+        prop.location.id = node;
+#else
+        return false;
+#endif
+    }
+    size_t granularity = 0;
+    return cuMemGetAllocationGranularity(&granularity, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM) == CUDA_SUCCESS &&
+        granularity && GGML_CUDA_PAGE_SIZE % granularity == 0;
