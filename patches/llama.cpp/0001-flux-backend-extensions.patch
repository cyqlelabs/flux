+// ggml_gated_delta_net_rows
+
+struct ggml_tensor * ggml_gated_delta_net_rows(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * states,
+        struct ggml_tensor  * ids,
+        int64_t               K) {
+    const int64_t S_v    = v->ne[0];
+    const int64_t H      = v->ne[1];
+    const int64_t n_seqs = v->ne[3];
+
+    GGML_ASSERT(states->type == GGML_TYPE_F32 && ggml_is_contiguous(states) && states->ne[0] == S_v*S_v*H && ggml_is_matrix(states));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_vector(ids) && ids->ne[0] == n_seqs);
+
+    // validate as the gathered form, against a view of the first rows
+    struct ggml_tensor * s0 = ggml_view_4d(ctx, states, S_v, S_v, H, n_seqs,
+            S_v*sizeof(float), S_v*S_v*sizeof(float), states->nb[1], 0);
+    struct ggml_tensor * result = ggml_gated_delta_net(ctx, q, k, v, g, beta, s0, K);
+
+    result->src[5] = states;
+    result->src[6] = ids;
+
+    return result;
+}
