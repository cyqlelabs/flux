+static bool test_paged_buffer(ggml_backend_t backend, ggml_backend_dev_t dev) {
+    auto * buft = ggml_backend_dev_growable_buffer_type(dev);
+    if (!buft) {
+        printf("%s: growable buffers unsupported\n", ggml_backend_dev_name(dev));
+        return true;
+    }
+    const size_t page = ggml_backend_buft_get_alignment(buft);
+    ggml_init_params params{ggml_tensor_overhead() * 16 + ggml_graph_overhead(), nullptr, true};
+    ggml_context_ptr storage(ggml_init(params));
+    auto * cache = ggml_new_tensor_2d(storage.get(), GGML_TYPE_F32, 256, 4 * page / 1024);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors_from_buft(storage.get(), buft));
+    ggml_backend_page_info info{};
+    if (!buffer || !ggml_backend_buffer_page_info(buffer.get(), &info) || info.device_bytes || info.host_bytes) {
+        return false;
+    }
+    if ((uintptr_t) cache->data % page || ggml_backend_buffer_commit(buffer.get(), 1, page, GGML_BACKEND_PAGE_DEVICE)) {
+        return false;
+    }
+    if (!ggml_backend_buffer_commit(buffer.get(), 0, page, GGML_BACKEND_PAGE_DEVICE)) {
+        return false;
+    }
+    if (!ggml_backend_buffer_commit(buffer.get(), page, page, GGML_BACKEND_PAGE_HOST)) {
+        printf("%s: host NUMA pages unsupported\n", ggml_backend_dev_name(dev));
+        return false;
+    }
+    const size_t count = 2 * page / sizeof(float);
+    std::vector<float> values(count);
+    for (size_t i = 0; i < count; ++i) {
+        values[i] = (float) (i % 127);
+    }
+    ggml_backend_tensor_set(cache, values.data(), 0, count * sizeof(float));
+    ggml_context_ptr graph_ctx(ggml_init(params));
+    auto * prefix = ggml_view_2d(graph_ctx.get(), cache, 256, 2 * page / 1024, cache->nb[1], 0);
+    auto * scaled = ggml_scale(graph_ctx.get(), prefix, 2.0f);
+    auto * rows = ggml_new_tensor_2d(graph_ctx.get(), GGML_TYPE_F32, 256, 2);
+    auto * indices = ggml_new_tensor_1d(graph_ctx.get(), GGML_TYPE_I32, 2);
+    auto * writes = ggml_set_rows(graph_ctx.get(), cache, rows, indices);
+    auto * graph = ggml_new_graph(graph_ctx.get());
+    ggml_build_forward_expand(graph, scaled);
+    ggml_build_forward_expand(graph, writes);
+    ggml_backend_buffer_ptr work(ggml_backend_alloc_ctx_tensors(graph_ctx.get(), backend));
+    if (!work) {
+        return false;
+    }
+    std::vector<float> row_values(512, 7.0f);
+    const int32_t row_ids[] = { (int32_t) (page / 1024 - 1), (int32_t) (page / 1024) };
+    ggml_backend_tensor_set(rows, row_values.data(), 0, row_values.size() * sizeof(float));
+    ggml_backend_tensor_set(indices, row_ids, 0, sizeof(row_ids));
+    if (ggml_backend_graph_compute(backend, graph) != GGML_STATUS_SUCCESS) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    std::vector<float> result(count);
+    ggml_backend_tensor_get(scaled, result.data(), 0, count * sizeof(float));
+    for (size_t i = 0; i < count; ++i) {
+        if (result[i] != 2.0f * values[i]) {
+            return false;
+        }
+    }
+    for (int32_t row : row_ids) {
+        std::fill(values.begin() + row * 256, values.begin() + (row + 1) * 256, 7.0f);
+    }
+    for (auto location : {GGML_BACKEND_PAGE_HOST, GGML_BACKEND_PAGE_DEVICE}) {
+        if (!ggml_backend_buffer_move(buffer.get(), 0, 2 * page, location)) {
+            return false;
+        }
+        ggml_backend_tensor_get(cache, result.data(), 0, count * sizeof(float));
+        if (result != values) {
+            return false;
+        }
+    }
+    ggml_backend_buffer_clear(buffer.get(), 0);
+    ggml_backend_tensor_get(cache, result.data(), 0, count * sizeof(float));
+    if (std::any_of(result.begin(), result.end(), [](float x) { return x != 0; })) {
+        return false;
+    }
+    if (!ggml_backend_buffer_release(buffer.get(), 0, 2 * page) ||
+        !ggml_backend_buffer_page_info(buffer.get(), &info) || info.device_bytes || info.host_bytes || info.capacity != 4 * page) {
+        return false;
+    }
+    if (!ggml_backend_buffer_commit(buffer.get(), 0, page, GGML_BACKEND_PAGE_DEVICE)) {
+        return false;
+    }
+    ggml_backend_tensor_get(cache, result.data(), 0, page);
+    return std::all_of(result.begin(), result.begin() + page / sizeof(float), [](float x) { return x == 0; });
+}
