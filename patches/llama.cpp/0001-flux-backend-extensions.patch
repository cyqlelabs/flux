+// ssm_conv_hist: one thread per channel and a chunk of up to 32 tokens; the sum runs in the order of ssm_conv_f32,
+// so the result is bitwise the same as ssm_conv (+ silu) over the concatenated history and inputs
+template <bool apply_silu, int d_conv>
+static __global__ void ssm_conv_hist_f32(const float * __restrict__ hist, const float * __restrict__ x, const float * __restrict__ c,
+                                         float * __restrict__ dst, const int64_t d_inner, const int64_t n_t, const int n_snap,
+                                         const int64_t hist_nb2, const int64_t x_nb2, const int64_t dst_nb1) {
+    constexpr int n_hist = d_conv - 1;
