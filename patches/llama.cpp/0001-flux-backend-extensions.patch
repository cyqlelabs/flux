+
+bool llama_host_memory(size_t * available, size_t * total) {
+#if defined(_WIN32)
+    MEMORYSTATUSEX st;
+    st.dwLength = sizeof(st);
+    if (!GlobalMemoryStatusEx(&st)) {
+        return false;
+    }
+    *available = (size_t) st.ullAvailPhys;
+    *total     = (size_t) st.ullTotalPhys;
+    return true;
+#elif defined(__linux__)
+    // MemAvailable counts the page cache the kernel can reclaim, which mapped weights live in
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (!f) {
+        return false;
+    }
+    char line[256];
+    unsigned long long avail_kb = 0, total_kb = 0;
+    while (fgets(line, sizeof(line), f)) {
+        sscanf(line, "MemAvailable: %llu kB", &avail_kb);
+        sscanf(line, "MemTotal: %llu kB", &total_kb);
+    }
+    fclose(f);
+    *available = (size_t) avail_kb * 1024;
+    *total     = (size_t) total_kb * 1024;
+    return avail_kb > 0 && total_kb > 0;
+#else
+    GGML_UNUSED(available);
+    GGML_UNUSED(total);
+    return false;
+#endif
+}
