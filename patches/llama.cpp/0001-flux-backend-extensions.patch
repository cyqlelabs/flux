+static ggml_backend_buffer_t ggml_cuda_paged_alloc(ggml_backend_buffer_type_t buft, size_t size) {
+    auto * type_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    if (size > SIZE_MAX - GGML_CUDA_PAGE_SIZE) {
