+// flux: pinned host-to-device copy rate of a device in bytes/s, measured once per process; 0 when the device has
+// no host buffer type or the probe buffers do not fit
+static double llama_h2d_rate(ggml_backend_dev_t dev) {
+    static std::mutex mutex;
+    static std::map<ggml_backend_dev_t, double> rates;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (const auto it = rates.find(dev); it != rates.end()) {
+        return it->second;
+    }
+    const size_t size = 16u << 20;
+    double rate = 0.0;
+    ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(dev);
+    ggml_backend_buffer_t hbuf = host_buft ? ggml_backend_buft_alloc_buffer(host_buft, size) : nullptr;
+    ggml_backend_buffer_t dbuf = hbuf ? ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(dev), size) : nullptr;
+    if (dbuf) {
+        ggml_init_params ip = { ggml_tensor_overhead(), nullptr, true };
+        ggml_context * ctx = ggml_init(ip);
+        ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, size);
+        if (ggml_backend_tensor_alloc(dbuf, t, ggml_backend_buffer_get_base(dbuf)) == GGML_STATUS_SUCCESS) {
+            const void * src = ggml_backend_buffer_get_base(hbuf);
+            int64_t best = INT64_MAX;
+            // the first copy warms the path up
+            for (int i = 0; i < 4; ++i) {
+                const int64_t t0 = ggml_time_us();
+                ggml_backend_tensor_set(t, src, 0, size);
+                if (i > 0) {
+                    best = std::min(best, ggml_time_us() - t0);
+                }
+            }
+            rate = size / (std::max<int64_t>(best, 1) * 1e-6);
+        }
+        ggml_free(ctx);
+    }
+    ggml_backend_buffer_free(dbuf);
+    ggml_backend_buffer_free(hbuf);
+    rates[dev] = rate;
+    return rate;
+}
