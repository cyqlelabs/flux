+bool llama_kv_cache::collect_commit(uint32_t s0, uint32_t s1, uint32_t cells, std::vector<llama_kv_page_request> & requests) {
+    if (cells > get_size()) {
+        return false;
+    }
+    cells = std::min(get_size(), GGML_PAD(cells, std::max(n_pad, 256u)));
+    for (auto & region : page_regions) {
+        auto * tensor = region.tensor;
+        const size_t prefix = GGML_PAD(size_t(cells)*tensor->nb[1], region.page_size);
+        const size_t base = (char *) tensor->data - (char *) ggml_backend_buffer_get_base(tensor->buffer);
+        for (uint32_t s = s0; s <= s1; ++s) {
+            const size_t old = region.committed[s];
+            if (prefix <= old) {
+                continue;
+            }
+            auto * target = &region;
+            const size_t floor = GGML_PAD(size_t(std::min(get_size(), page_floor_cells))*tensor->nb[1], region.page_size);
+            const size_t head = std::min(prefix, floor);
+            if (old < head) {
+                requests.push_back({tensor->buffer, base + s*tensor->nb[2] + old, head - old, region.cls, true,
+                        [target, s, head] { target->committed[s] = head; }, 1});
+            }
+            const size_t tail = std::max(old, head);
+            if (tail < prefix) {
+                requests.push_back({tensor->buffer, base + s*tensor->nb[2] + tail, prefix - tail, region.cls, true,
+                        [target, s, prefix] { target->committed[s] = prefix; }, 2});
+            }
+        }
+    }
+    return true;
+}
