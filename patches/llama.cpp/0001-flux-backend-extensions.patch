+        struct ggml_tensor  * ids) {
+    GGML_ASSERT(counts->type == GGML_TYPE_F32 && ggml_is_vector(counts) && ggml_is_contiguous(counts));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[2] == 1 && ids->ne[3] == 1);
+
+    struct ggml_tensor * result = ggml_view_tensor(ctx, counts);
+
+    result->op     = GGML_OP_COUNT_IDS;
+    result->src[0] = counts;
+    result->src[1] = ids;
+
+    return result;
+}
+
+// ggml_moe_host_post
+
+static void ggml_set_op_params_moe_host(struct ggml_tensor * t, int layer, struct ggml_moe_host_exec * exec) {
+    int32_t params[4] = { layer, 0, 0, 0 };
+    memcpy(params + 2, &exec, sizeof(exec));
+    ggml_set_op_params(t, params, sizeof(params));
+}
+
+struct ggml_tensor * ggml_moe_host_post(
+        struct ggml_context       * ctx,
+        struct ggml_tensor        * x,
+        struct ggml_tensor        * ids,
+        struct ggml_tensor        * w,
+        int                         layer,
+        struct ggml_moe_host_exec * exec) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && w->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(ids) && ggml_is_contiguous(w));
+    GGML_ASSERT(ggml_n_dims(x) <= 2 && ggml_n_dims(ids) <= 2);
+    GGML_ASSERT(ids->ne[1] == x->ne[1] && ggml_nelements(w) == ggml_nelements(ids));
+    GGML_ASSERT(x->ne[1] <= exec->n_tok_max);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+
+    ggml_set_op_params_moe_host(result, layer, exec);
+
+    result->op     = GGML_OP_MOE_HOST_POST;
+    result->src[0] = x;
+    result->src[1] = ids;
+    result->src[2] = w;
+
+    return result;
+}
+
+// ggml_moe_host_wait
+
+struct ggml_tensor * ggml_moe_host_wait(
+        struct ggml_context       * ctx,
+        struct ggml_tensor        * acc,
+        struct ggml_tensor        * ticket,
+        int                         layer,
+        struct ggml_moe_host_exec * exec) {
+    GGML_ASSERT(acc->type == GGML_TYPE_F32 && ggml_is_contiguous(acc) && ggml_n_dims(acc) <= 2);
+    GGML_ASSERT(ticket->type == GGML_TYPE_I32 && ggml_nelements(ticket) == 1);
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, acc->ne);
+
+    ggml_set_op_params_moe_host(result, layer, exec);
+
+    result->op     = GGML_OP_MOE_HOST_WAIT;
+    result->src[0] = acc;
+    result->src[1] = ticket;
+
+    return result;
+}
