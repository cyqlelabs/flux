+bool llama_kv_cache::collect_reservation(llama_seq_id seq, uint32_t cells, std::vector<llama_kv_page_request> & requests) {
+    if (page_regions.empty()) {
+        return true;
+    }
+    if (n_swa > 0) {
+        cells = std::min(cells, get_size());
+    }
+    if (seq < 0 || size_t(seq) >= seq_to_stream.size() || cells > get_size()) {
+        return false;
+    }
+    const uint32_t stream = seq_to_stream[seq];
+    if (!collect_commit(stream, stream, cells, requests)) {
+        return false;
+    }
+    // The zero-byte request changes the floor only after the whole engine's
+    // target, indexer and draft page transaction succeeds.
+    if (!page_regions.empty()) {
+        requests.push_back({page_regions.front().tensor->buffer, 0, 0, page_regions.front().cls, true,
+                [this, stream, cells] { reserved_cells[stream] = std::max(reserved_cells[stream], cells); }});
+    }
+    return true;
+}
