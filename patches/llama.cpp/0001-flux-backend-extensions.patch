+static bool ggml_cuda_paged_commit(ggml_backend_buffer_t buffer, size_t offset, size_t size, ggml_backend_page_location location) {
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    std::lock_guard<std::mutex> lock(ctx->paged->mutex);
+    ggml_cuda_set_device(ctx->device);
+    if (cudaDeviceSynchronize() != cudaSuccess) {
+        return false;
+    }
+    std::vector<size_t> added;
+    for (size_t i = offset / GGML_CUDA_PAGE_SIZE; i < (offset + size) / GGML_CUDA_PAGE_SIZE; ++i) {
+        auto & page = ctx->paged->pages[i];
+        if (page.handle) {
+            continue;
+        }
+        CUmemGenericAllocationHandle handle = 0;
+        const CUdeviceptr addr = (CUdeviceptr) ctx->dev_ptr + i * GGML_CUDA_PAGE_SIZE;
+        bool mapped = false;
+        if (ggml_cuda_page_create(ctx->device, location, handle)) {
+            mapped = cuMemMap(addr, GGML_CUDA_PAGE_SIZE, 0, handle, 0) == CUDA_SUCCESS;
+        }
+        if (!mapped || ggml_cuda_page_access(ctx->device, addr) != CUDA_SUCCESS || cuMemsetD8(addr, 0, GGML_CUDA_PAGE_SIZE) != CUDA_SUCCESS) {
+            if (mapped) {
+                CU_CHECK(cuMemUnmap(addr, GGML_CUDA_PAGE_SIZE));
+            }
+            if (handle) {
+                CU_CHECK(cuMemRelease(handle));
+            }
+            // Failed admission must not retain the pages it just allocated.
+            for (size_t j : added) {
+                CU_CHECK(cuMemUnmap((CUdeviceptr) ctx->dev_ptr + j * GGML_CUDA_PAGE_SIZE, GGML_CUDA_PAGE_SIZE));
+                CU_CHECK(cuMemRelease(ctx->paged->pages[j].handle));
+                ctx->paged->pages[j] = {};
+            }
+            return false;
+        }
+        page = { handle, location };
+        added.push_back(i);
+    }
+    return true;
+}
+
+static bool ggml_cuda_paged_release(ggml_backend_buffer_t buffer, size_t offset, size_t size) {
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    std::lock_guard<std::mutex> lock(ctx->paged->mutex);
+    ggml_cuda_set_device(ctx->device);
+    if (cudaDeviceSynchronize() != cudaSuccess) {
+        return false;
+    }
+    for (size_t i = offset / GGML_CUDA_PAGE_SIZE; i < (offset + size) / GGML_CUDA_PAGE_SIZE; ++i) {
+        auto & page = ctx->paged->pages[i];
+        if (page.handle) {
+            CU_CHECK(cuMemUnmap((CUdeviceptr) ctx->dev_ptr + i * GGML_CUDA_PAGE_SIZE, GGML_CUDA_PAGE_SIZE));
+            CU_CHECK(cuMemRelease(page.handle));
+            page = {};
+        }
+    }
+    return true;
+}
+
+static bool ggml_cuda_paged_move(ggml_backend_buffer_t buffer, size_t offset, size_t size, ggml_backend_page_location location) {
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    std::lock_guard<std::mutex> lock(ctx->paged->mutex);
+    ggml_cuda_set_device(ctx->device);
+    if (cudaDeviceSynchronize() != cudaSuccess) {
+        return false;
+    }
+    for (size_t i = offset / GGML_CUDA_PAGE_SIZE; i < (offset + size) / GGML_CUDA_PAGE_SIZE; ++i) {
+        if (!ctx->paged->pages[i].handle) {
+            return false;
+        }
+    }
+    for (size_t i = offset / GGML_CUDA_PAGE_SIZE; i < (offset + size) / GGML_CUDA_PAGE_SIZE; ++i) {
+        auto & page = ctx->paged->pages[i];
+        if (page.location == location) {
+            continue;
+        }
+        CUmemGenericAllocationHandle handle = 0;
+        CUdeviceptr scratch = 0;
+        const CUdeviceptr addr = (CUdeviceptr) ctx->dev_ptr + i * GGML_CUDA_PAGE_SIZE;
+        if (!ggml_cuda_page_create(ctx->device, location, handle)) {
+            return false;
+        }
+        if (cuMemAddressReserve(&scratch, GGML_CUDA_PAGE_SIZE, GGML_CUDA_PAGE_SIZE, 0, 0) != CUDA_SUCCESS) {
+            CU_CHECK(cuMemRelease(handle));
+            return false;
+        }
+        const bool mapped = cuMemMap(scratch, GGML_CUDA_PAGE_SIZE, 0, handle, 0) == CUDA_SUCCESS;
+        const bool copied = mapped && ggml_cuda_page_access(ctx->device, scratch) == CUDA_SUCCESS &&
+            cuMemcpy(scratch, addr, GGML_CUDA_PAGE_SIZE) == CUDA_SUCCESS;
+        if (mapped) {
+            CU_CHECK(cuMemUnmap(scratch, GGML_CUDA_PAGE_SIZE));
+        }
+        CU_CHECK(cuMemAddressFree(scratch, GGML_CUDA_PAGE_SIZE));
+        if (!copied) {
+            CU_CHECK(cuMemRelease(handle));
+            return false;
+        }
+        CU_CHECK(cuMemUnmap(addr, GGML_CUDA_PAGE_SIZE));
+        const bool remapped = cuMemMap(addr, GGML_CUDA_PAGE_SIZE, 0, handle, 0) == CUDA_SUCCESS;
+        if (!remapped || ggml_cuda_page_access(ctx->device, addr) != CUDA_SUCCESS) {
+            if (remapped) {
+                CU_CHECK(cuMemUnmap(addr, GGML_CUDA_PAGE_SIZE));
+            }
+            CU_CHECK(cuMemMap(addr, GGML_CUDA_PAGE_SIZE, 0, page.handle, 0));
+            CU_CHECK(ggml_cuda_page_access(ctx->device, addr));
+            CU_CHECK(cuMemRelease(handle));
+            return false;
+        }
+        CU_CHECK(cuMemRelease(page.handle));
+        page = { handle, location };
+    }
+    return true;
+}
