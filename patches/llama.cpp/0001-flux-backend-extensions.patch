+void llama_model_qwen4exp::graph::build_mtp() {
+    const int il = hparams.n_layer();
+    const int64_t hc = hparams.dsv4_hc_mult;
+    const int64_t hc_dim = hc * n_embd;
+    const auto & layer = model.layers[il];
+    // a model loaded without load_mtp has no MTP tensors: refuse the MTP context (see the trunk graph)
+    if (!layer.nextn.e_proj || !layer.nextn.h_proj || !layer.nextn.enorm || !layer.nextn.hnorm ||
+            !layer.nextn.hc_head_norm || !layer.nextn.hc_head_down || !layer.nextn.hc_head_up ||
+            !layer.hc_attn_norm || !layer.hc_attn_down || !layer.hc_attn_up || !layer.hc_attn_inject ||
+            !layer.hc_ffn_norm || !layer.hc_ffn_down || !layer.hc_ffn_up || !layer.hc_ffn_inject) {
+        throw std::runtime_error("qwen4exp: the MTP context needs the MTP tensors (load the model with load_mtp)");
+    }
+
+    auto inp = std::make_unique<llm_graph_input_embd_h>(hc_dim);
+    inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
+    inp->embd   = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hc_dim, n_tokens);
+    inp->h      = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hc_dim, n_tokens);
+    ggml_set_input(inp->tokens);
+    ggml_set_input(inp->embd);
+    ggml_set_input(inp->h);
+    ggml_set_name(inp->h, "mtp_h_input");
+
+    ggml_tensor * e = ggml_get_rows(ctx0, model.tok_embd, inp->tokens);
+    e = build_norm(e, layer.nextn.enorm, nullptr, LLM_NORM_RMS, il);
+    e = build_lora_mm(layer.nextn.e_proj, e);
+    e = ggml_reshape_3d(ctx0, e, n_embd, 1, n_tokens);
+
+    // The entry norm spans all HC streams; fc_hidden then acts on each stream.
+    ggml_tensor * h = build_norm(inp->h, layer.nextn.hnorm, nullptr, LLM_NORM_RMS, il);
+    h = ggml_reshape_2d(ctx0, h, n_embd, hc * n_tokens);
+    h = build_lora_mm(layer.nextn.h_proj, h);
+    h = ggml_reshape_3d(ctx0, h, n_embd, hc, n_tokens);
+    ggml_tensor * residual = ggml_add(ctx0, h, e);
+    cb(residual, "mtp_hc_input", il);
+    res->add_input(std::move(inp));
+
+    int sections[4];
+    std::copy(std::begin(hparams.rope_sections), std::begin(hparams.rope_sections) + 4, sections);
+    ggml_tensor * inp_pos = build_inp_pos();
+    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    auto * inp_attn = build_attn_inp_kv();
+
+    ggml_tensor * inject = nullptr;
+    ggml_tensor * cur = build_hc_mix(residual,
+            layer.hc_attn_norm, layer.hc_attn_down, layer.hc_attn_up, layer.hc_attn_inject, &inject, il);
+    // Strata MTP uses all causal cells, without the trunk's QSA indexer.
+    cur = build_layer_attn(inp_attn, nullptr, cur, inp_pos, sections, il);
+    residual = build_hc_combine(residual, cur, inject, il);
+    cur = build_hc_mix(residual,
+            layer.hc_ffn_norm, layer.hc_ffn_down, layer.hc_ffn_up, layer.hc_ffn_inject, &inject, il);
+    cur = build_layer_ffn(cur, il);
+    residual = build_hc_combine(residual, cur, inject, il);
+
+    ggml_tensor * hidden = ggml_reshape_2d(ctx0, residual, hc_dim, n_tokens);
+    if (cparams.embeddings_nextn) {
+        res->t_h_nextn = cparams.embeddings_nextn_masked && inp_out_ids
+                ? ggml_get_rows(ctx0, hidden, inp_out_ids) : hidden;
+        cb(res->t_h_nextn, "h_nextn", -1);
+        ggml_build_forward_expand(gf, res->t_h_nextn);
+    }
+    if (inp_out_ids) {
+        hidden = ggml_get_rows(ctx0, hidden, inp_out_ids);
+        residual = ggml_reshape_3d(ctx0, hidden, n_embd, hc, hidden->ne[1]);
+    }
+    res->t_embd = hidden;
+    cur = build_hc_mix(residual,
+            layer.nextn.hc_head_norm, layer.nextn.hc_head_down, layer.nextn.hc_head_up, nullptr, nullptr, il);
+    cb(cur, "mtp_head_mixed", il);
+
+    // a reduced draft vocabulary computes the logits of its first tokens only
+    ggml_tensor * output   = model.output;
+    ggml_tensor * output_s = model.output_s;
+    const int64_t n_rows = n_rows_draft(output->ne[1]);
+    if (n_rows < output->ne[1]) {
+        output = ggml_view_2d(ctx0, output, output->ne[0], n_rows, output->nb[1], 0);
+        if (output_s && output_s->ne[0] == model.output->ne[1]) {
+            output_s = ggml_view_1d(ctx0, output_s, n_rows, 0);
+        }
+    }
+    cur = build_lora_mm(output, cur, output_s);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+    ggml_build_forward_expand(gf, cur);
+}
