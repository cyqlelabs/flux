+// flux: a pool that takes allocations from a lent arena first (ggml_backend_cuda_lend_pool) and records the most
+// bytes it held at once, which bounds the prompt chunks a lender can afford
+struct ggml_cuda_pool_lent : public ggml_cuda_pool {
+    std::unique_ptr<ggml_cuda_pool> inner;
+
+    char * arena      = nullptr;
+    size_t arena_size = 0;
+    size_t arena_used = 0;
+    int    arena_live = 0; // allocations in the arena: a free out of order keeps its bytes taken until none is live
+
+    size_t used = 0;
+    size_t peak = 0;
+
+    explicit ggml_cuda_pool_lent(std::unique_ptr<ggml_cuda_pool> inner) : inner(std::move(inner)) {
+    }
+
+    void * alloc(size_t size, size_t * actual_size) override {
+        const size_t alignment = 128;
+        const size_t padded    = alignment * ((size + alignment - 1) / alignment);
+        void * ptr;
+        if (arena && arena_used + padded <= arena_size) {
+            ptr = arena + arena_used;
+            arena_used += padded;
+            arena_live++;
+            *actual_size = padded;
+        } else {
+            ptr = inner->alloc(size, actual_size);
+        }
+        used += *actual_size;
+        peak  = std::max(peak, used);
+        return ptr;
+    }
+
+    void free(void * ptr, size_t size) override {
+        used -= size;
+        if (arena && (char *) ptr >= arena && (char *) ptr < arena + arena_size) {
+            if ((char *) ptr + size == arena + arena_used) {
+                arena_used -= size;
+            }
+            if (--arena_live == 0) {
+                arena_used = 0;
+            }
+            return;
+        }
+        inner->free(ptr, size);
+    }
+};
