+int64_t llm_graph_context::n_rows_draft(int64_t n_rows) const {
+    if (cparams.n_vocab_draft == 0 || cparams.n_vocab_draft >= n_rows) {
+        return n_rows;
+    }
+    for (const auto & entry : samplers) {
+        if (!llama_sampler_vocab_prefix_ok(entry.second)) {
+            return n_rows;
+        }
+    }
+    return cparams.n_vocab_draft;
