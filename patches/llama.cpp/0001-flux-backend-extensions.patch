+    GGML_ASSERT(residual->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 && inject->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(residual) && ggml_is_contiguous(x) && ggml_is_contiguous(inject));
+    GGML_ASSERT(residual->ne[3] == 1);
+    GGML_ASSERT(ggml_nelements(x) == residual->ne[0]*residual->ne[2]);
+    GGML_ASSERT(ggml_nelements(inject) == residual->ne[1]*residual->ne[2]);
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, residual->ne);
+
+    ggml_set_op_params_f32(result, 0, scale);
