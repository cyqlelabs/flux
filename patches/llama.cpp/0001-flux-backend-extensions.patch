+static bool ggml_cuda_paged_info(ggml_backend_buffer_t buffer, ggml_backend_page_info * info) {
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    std::lock_guard<std::mutex> lock(ctx->paged->mutex);
+    *info = { GGML_CUDA_PAGE_SIZE, ctx->paged->capacity, 0, 0 };
+    for (const auto & page : ctx->paged->pages) {
+        if (page.handle) {
+            (page.location == GGML_BACKEND_PAGE_HOST ? info->host_bytes : info->device_bytes) += GGML_CUDA_PAGE_SIZE;
+        }
+    }
+    return true;
+}
