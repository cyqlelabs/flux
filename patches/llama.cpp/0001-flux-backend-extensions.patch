+    while (fgets(line, sizeof(line), f)) {
+        sscanf(line, "MemAvailable: %llu kB", &avail_kb);
+        sscanf(line, "MemTotal: %llu kB", &total_kb);
+    }
+    fclose(f);
+    *available = (size_t) avail_kb * 1024;
+    *total     = (size_t) total_kb * 1024;
+    return avail_kb > 0 && total_kb > 0;
+#else
+    GGML_UNUSED(available);
+    GGML_UNUSED(total);
+    return false;
+#endif
+}
