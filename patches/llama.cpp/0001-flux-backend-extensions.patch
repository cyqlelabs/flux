diff --git a/src/llama-kv-ledger.cpp b/src/llama-kv-ledger.cpp
new file mode 100644
index 000000000..083e0ebb9
--- /dev/null
+++ b/src/llama-kv-ledger.cpp
@@ -0,0 +1,224 @@
+#include "llama-kv-ledger.h"
+
+#include <algorithm>
+#include <fstream>
+#include <limits>
+#include <new>
+#include <optional>
+#include <stdexcept>
+#include <string>
+
+llama_kv_page_ledger::llama_kv_page_ledger(uint64_t host_budget, uint64_t host_reserve, devices_t devices) :
+        host_budget(host_budget), host_reserve(host_reserve), devices(std::move(devices)) {}
+
+// MemAvailable in bytes; without /proc/meminfo only the host budget bounds host pages. A failed read means no
+// RAM: a throw inside a commit transaction would leave a tracked page out of its rollback.
+static uint64_t llama_kv_mem_available() noexcept try {
+#ifdef __linux__
+    std::ifstream input("/proc/meminfo");
+    std::string name;
+    uint64_t kib;
+    std::string line;
+    while (input >> name >> kib) {
+        std::getline(input, line);
+        if (name == "MemAvailable:") {
+            return kib > UINT64_MAX/1024 ? UINT64_MAX : kib*1024;
+        }
+    }
+    return 0;
+#else
+    return UINT64_MAX;
+#endif
+} catch (...) {
+    return 0;
+}
+
+// `taken` counts the host bytes this transaction already committed, which MemAvailable read at its start still includes.
+bool llama_kv_page_ledger::can_host(size_t bytes, uint64_t available, uint64_t taken) const {
+    if (host_used > host_budget || bytes > host_budget - host_used) {
+        return false;
+    }
+    return available >= host_reserve && taken <= available - host_reserve && bytes <= available - host_reserve - taken;
+}
+
+void llama_kv_page_ledger::uncharge(const page & p) {
+    if (p.location == GGML_BACKEND_PAGE_HOST) {
+        host_used -= p.bytes;
+    } else {
+        device_used[p.device] -= p.bytes;
+        if (p.cls == llama_kv_page_class::full_read) {
+            full_read_used[p.device] -= p.bytes;
+        }
+    }
+}
+
+bool llama_kv_page_ledger::commit(const std::vector<llama_kv_page_request> & requests) {
+    std::lock_guard<std::mutex> lock(mutex);
+    std::vector<key> added;
+    auto rollback = [&]() {
+        for (auto it = added.rbegin(); it != added.rend(); ++it) {
+            const auto found = pages.find(*it);
+            if (!ggml_backend_buffer_release(it->first, it->second, found->second.bytes)) {
+                throw std::runtime_error("cannot roll back KV page transaction");
+            }
+            uncharge(found->second);
+            pages.erase(found);
+        }
+        return false;
+    };
+    try {
+        size_t count = 0;
+        for (const auto & request : requests) {
+            ggml_backend_page_info info{};
+            if (!ggml_backend_buffer_page_info(request.buffer, &info) || !info.page_size ||
+                    request.offset > info.capacity || request.bytes > info.capacity - request.offset ||
+                    request.offset % info.page_size || request.bytes % info.page_size ||
+                    request.bytes/info.page_size > SIZE_MAX - count) {
+                return false;
+            }
+            count += request.bytes/info.page_size;
+        }
+        added.reserve(count);
+        // read only when a page needs host memory: decode reserves every step, mostly with nothing to commit
+        std::optional<uint64_t> available;
+        uint64_t host_taken = 0;
+        std::vector<const llama_kv_page_request *> ordered;
+        ordered.reserve(requests.size());
+        for (const auto & request : requests) ordered.push_back(&request);
+        auto priority = [](const llama_kv_page_request * request) {
+            return request->cls == llama_kv_page_class::full_read ? 0 : int(request->priority);
+        };
+        std::stable_sort(ordered.begin(), ordered.end(), [&](auto * a, auto * b) { return priority(a) < priority(b); });
+        for (const auto * item : ordered) {
+            const auto & request = *item;
+            ggml_backend_page_info info{};
+            if (!ggml_backend_buffer_page_info(request.buffer, &info) || !info.page_size ||
+                    request.offset > info.capacity || request.bytes > info.capacity - request.offset ||
+                    request.offset % info.page_size || request.bytes % info.page_size) {
+                return rollback();
+            }
+            auto * buft = ggml_backend_buffer_get_type(request.buffer);
+            auto * device = ggml_backend_buft_get_device(buft);
+            const bool cpu = ggml_backend_buft_is_host(buft);
+            const auto budget = devices.find(device);
+            device_used.try_emplace(device, 0);
+            full_read_used.try_emplace(device, 0);
+            for (size_t offset = request.offset; offset < request.offset + request.bytes; offset += info.page_size) {
+                const key id{request.buffer, offset};
+                if (pages.count(id)) {
+                    continue;
+                }
+                bool committed = false;
+                ggml_backend_page_location location = GGML_BACKEND_PAGE_DEVICE;
+                const bool full = request.cls == llama_kv_page_class::full_read;
+                uint64_t limit = 0;
+                if (budget != devices.end()) {
+                    const uint64_t held_back = full ? 0 : budget->second.full_read_reserve -
+                            std::min(budget->second.full_read_reserve, full_read_used[device]);
+                    limit = budget->second.bytes - std::min(budget->second.bytes, held_back);
+                }
+                const bool device_fits = !cpu && budget != devices.end() &&
+                        device_used[device] <= limit && info.page_size <= limit - device_used[device];
+                const bool host_allowed = cpu || (!full && budget != devices.end() && budget->second.host_reads);
+                auto host_fits = [&] {
+                    if (!host_allowed) return false;
+                    if (!available) available = llama_kv_mem_available();
+                    return can_host(info.page_size, *available, host_taken);
+                };
+                // Allocate tracking metadata before mapping any physical memory.
+                const auto tracked = pages.emplace(id, page{GGML_BACKEND_PAGE_DEVICE, device, request.cls, info.page_size}).first;
+                if (device_fits && (full || request.prefer_device || !budget->second.host_reads)) {
+                    committed = ggml_backend_buffer_commit(request.buffer, offset, info.page_size, location);
+                }
+                if (!committed && host_fits()) {
+                    location = GGML_BACKEND_PAGE_HOST;
+                    committed = ggml_backend_buffer_commit(request.buffer, offset, info.page_size, location);
+                }
+                if (!committed && !full && device_fits && !request.prefer_device) {
+                    location = GGML_BACKEND_PAGE_DEVICE;
+                    committed = ggml_backend_buffer_commit(request.buffer, offset, info.page_size, location);
+                }
+                if (!committed) {
+                    pages.erase(tracked);
+                    return rollback();
+                }
+                tracked->second.location = location;
+                added.push_back(id);
+                if (location == GGML_BACKEND_PAGE_HOST) {
+                    host_used += info.page_size;
+                    host_taken += info.page_size;
+                } else {
+                    device_used[device] += info.page_size;
+                    if (full) {
+                        full_read_used[device] += info.page_size;
+                    }
+                }
+            }
+        }
+    } catch (const std::bad_alloc &) {
+        return rollback();
+    }
+    for (const auto & request : requests) {
+        if (request.accepted) {
+            request.accepted();
+        }
+    }
+    return true;
+}
+
+bool llama_kv_page_ledger::release(ggml_backend_buffer_t buffer, size_t offset, size_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex);
+    ggml_backend_page_info info{};
+    if (!ggml_backend_buffer_page_info(buffer, &info) || !info.page_size ||
+            offset > info.capacity || bytes > info.capacity - offset || offset % info.page_size || bytes % info.page_size) {
+        return false;
+    }
+    if (!ggml_backend_buffer_release(buffer, offset, bytes)) {
+        return false;
+    }
+    for (size_t at = offset; at < offset + bytes; at += info.page_size) {
+        const auto found = pages.find({buffer, at});
+        if (found != pages.end()) {
+            uncharge(found->second);
+            pages.erase(found);
+        }
+    }
+    return true;
+}
+
+uint64_t llama_kv_page_ledger::borrow(ggml_backend_dev_t device) {
+    std::lock_guard<std::mutex> lock(mutex);
+    const auto budget = devices.find(device);
+    if (budget == devices.end()) {
+        return 0;
+    }
+    // the full-read reserve stays: those caches cannot move to RAM
+    const uint64_t held = budget->second.full_read_reserve - std::min(budget->second.full_read_reserve, full_read_used[device]);
+    const uint64_t used = device_used[device] + held;
+    const uint64_t bytes = budget->second.bytes > used ? budget->second.bytes - used : 0;
+    device_used[device] += bytes;
+    return bytes;
+}
+
+void llama_kv_page_ledger::give_back(ggml_backend_dev_t device, uint64_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex);
+    device_used[device] -= std::min(device_used[device], bytes);
+}
+
+void llama_kv_page_ledger::set_host_reserve(uint64_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex);
+    host_reserve = bytes;
+}
+
+llama_kv_page_usage llama_kv_page_ledger::usage(llama_kv_page_class cls) const {
+    std::lock_guard<std::mutex> lock(mutex);
+    llama_kv_page_usage result;
+    for (const auto & entry : pages) {
+        const auto & p = entry.second;
+        if (p.cls != cls) {
+            continue;
+        }
+        (p.location == GGML_BACKEND_PAGE_HOST ? result.host_bytes : result.device_bytes) += p.bytes;
+    }
+    return result;
+}
diff --git a/src/llama-kv-ledger.h b/src/llama-kv-ledger.h
new file mode 100644
index 000000000..380fdcc35
--- /dev/null
+++ b/src/llama-kv-ledger.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <vector>
+
+enum class llama_kv_page_class { full_read, dense_attention, sparse_attention };
+
+struct llama_kv_page_request {
+    ggml_backend_buffer_t buffer;
+    size_t offset;
+    size_t bytes;
+    llama_kv_page_class cls;
+    bool prefer_device;
+    std::function<void()> accepted;
+    uint8_t priority = 2; // full-read pages precede the attention floor, then tail pages
+};
+
+struct llama_kv_device_budget {
+    uint64_t bytes = 0;
+    uint64_t full_read_reserve = 0;
+    bool host_reads = false; // the probe could map and read host pages from this GPU
+};
+
+struct llama_kv_page_usage {
+    uint64_t device_bytes = 0;
+    uint64_t host_bytes = 0;
+};
+
+// One ledger is shared by the target and draft contexts. Every transaction runs
+// while their backends are idle, before cell metadata or graph execution changes.
+class llama_kv_page_ledger {
+public:
+    using devices_t = std::map<ggml_backend_dev_t, llama_kv_device_budget>;
+
+    llama_kv_page_ledger(uint64_t host_budget, uint64_t host_reserve, devices_t devices);
+    bool commit(const std::vector<llama_kv_page_request> & requests);
+    bool release(ggml_backend_buffer_t buffer, size_t offset, size_t bytes);
+    void set_host_reserve(uint64_t bytes);
+    // the VRAM budget no page holds yet, lent to the compute of prompt chunks until give_back; pages committed
+    // meanwhile go to RAM where the device reads host pages
+    uint64_t borrow(ggml_backend_dev_t device);
+    void give_back(ggml_backend_dev_t device, uint64_t bytes);
+    llama_kv_page_usage usage(llama_kv_page_class cls) const;
+
+private:
+    struct page {
+        ggml_backend_page_location location;
+        ggml_backend_dev_t device;
+        llama_kv_page_class cls;
+        size_t bytes;
+    };
+    using key = std::pair<ggml_backend_buffer_t, size_t>;
+    uint64_t host_budget;
+    uint64_t host_reserve;
+    uint64_t host_used = 0;
+    devices_t devices;
+    std::map<ggml_backend_dev_t, uint64_t> device_used;
+    std::map<ggml_backend_dev_t, uint64_t> full_read_used;
+    std::map<key, page> pages;
+    mutable std::mutex mutex;
+
+    bool can_host(size_t bytes, uint64_t available, uint64_t taken) const;
+    void uncharge(const page & page);
+};
diff --git a/tests/test-kv-ledger.cpp b/tests/test-kv-ledger.cpp
new file mode 100644
index 000000000..aabd5c61c
--- /dev/null
+++ b/tests/test-kv-ledger.cpp
@@ -0,0 +1,101 @@
+#include "../src/llama-kv-ledger.h"
+#include "ggml-cpp.h"
+
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static void cpu_test(ggml_backend_dev_t device) {
+    auto * type = ggml_backend_dev_growable_buffer_type(device);
+    if (!type) {
+        return;
+    }
+    const size_t page = ggml_backend_buft_get_alignment(type);
+    ggml_backend_buffer_ptr buffer(ggml_backend_buft_alloc_buffer(type, 4*page));
+    require(bool(buffer), "cannot allocate ledger test buffer");
+    llama_kv_page_ledger ledger(3*page, 0, {});
+    int accepted = 0;
+    require(!ledger.commit({{buffer.get(), 0, 4*page, llama_kv_page_class::dense_attention, true, [&] { ++accepted; }}}),
+            "over-budget admission succeeded");
+    ggml_backend_page_info info{};
+    require(ggml_backend_buffer_page_info(buffer.get(), &info) && info.host_bytes == 0 && accepted == 0,
+            "failed admission did not roll back all pages");
+    require(ledger.commit({{buffer.get(), 0, 2*page, llama_kv_page_class::dense_attention, true, [&] { ++accepted; }}}),
+            "within-budget admission failed");
+    require(accepted == 1 && ledger.usage(llama_kv_page_class::dense_attention).host_bytes == 2*page,
+            "ledger did not account for the accepted transaction");
+    ledger.set_host_reserve(UINT64_MAX);
+    require(!ledger.commit({{buffer.get(), 2*page, page, llama_kv_page_class::dense_attention, true, {}}}),
+            "increased host reserve did not stop growth");
+    require(ledger.usage(llama_kv_page_class::dense_attention).host_bytes == 2*page,
+            "reserve change invalidated already admitted pages");
+    require(ledger.release(buffer.get(), 0, 2*page), "release failed");
+    require(ledger.usage(llama_kv_page_class::dense_attention).host_bytes == 0, "release retained its charge");
+}
+
+static void gpu_test(ggml_backend_dev_t device) {
+    auto * type = ggml_backend_dev_growable_buffer_type(device);
+    if (!type) {
+        return;
+    }
+    const size_t page = ggml_backend_buft_get_alignment(type);
+    ggml_backend_buffer_ptr buffer(ggml_backend_buft_alloc_buffer(type, 4*page));
+    require(bool(buffer), "cannot allocate GPU ledger test buffer");
+    llama_kv_page_ledger::devices_t devices{{device, {2*page, page, false}}};
+    llama_kv_page_ledger unsupported(4*page, 0, devices);
+    require(!unsupported.commit({{buffer.get(), 0, 2*page, llama_kv_page_class::dense_attention, true, {}}}),
+            "ineligible GPU received host pages");
+    ggml_backend_page_info info{};
+    require(ggml_backend_buffer_page_info(buffer.get(), &info) && info.host_bytes == 0 && info.device_bytes == 0,
+            "device-only failure retained pages");
+    devices[device].host_reads = true;
+    llama_kv_page_ledger ledger(2*page, 0, devices);
+    require(ledger.commit({{buffer.get(), 0, 2*page, llama_kv_page_class::dense_attention, true, {}}}),
+            "eligible GPU could not spill dense attention");
+    require(ledger.commit({{buffer.get(), 2*page, page, llama_kv_page_class::full_read, true, {}}}),
+            "dense attention consumed the full-read reserve");
+    require(ledger.commit({{buffer.get(), 3*page, page, llama_kv_page_class::sparse_attention, false, {}}}),
+            "sparse attention host placement failed");
+    require(ggml_backend_buffer_page_info(buffer.get(), &info) && info.device_bytes == 2*page && info.host_bytes == 2*page,
+            "mixed page accounting is wrong");
+    const auto full = ledger.usage(llama_kv_page_class::full_read);
+    require(full.device_bytes == page && full.host_bytes == 0, "full-read page escaped VRAM");
+    require(ledger.release(buffer.get(), 0, 4*page), "GPU release failed");
+    ggml_backend_buffer_ptr floor(ggml_backend_buft_alloc_buffer(type, page));
+    ggml_backend_buffer_ptr tail(ggml_backend_buft_alloc_buffer(type, page));
+    llama_kv_page_ledger prioritized(2*page, 0, devices);
+    require(prioritized.commit({
+                {tail.get(), 0, page, llama_kv_page_class::dense_attention, true, {}, 2},
+                {floor.get(), 0, page, llama_kv_page_class::dense_attention, true, {}, 1}}),
+            "prioritized admission failed");
+    require(ggml_backend_buffer_page_info(floor.get(), &info) && info.device_bytes == page && info.host_bytes == 0,
+            "a tail consumed VRAM reserved for another layer's floor");
+    require(ggml_backend_buffer_page_info(tail.get(), &info) && info.device_bytes == 0 && info.host_bytes == page,
+            "the lower-priority tail did not spill to RAM");
+    require(prioritized.release(floor.get(), 0, page) && prioritized.release(tail.get(), 0, page),
+            "prioritized page release failed");
+}
+
+int main() {
+    ggml_backend_load_all();
+    try {
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            auto * device = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                cpu_test(device);
+            } else if (ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                gpu_test(device);
+            }
+        }
+    } catch (const std::exception & error) {
+        fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    return 0;
+}
