+bool llama_memory_hybrid_idx::qsa_contiguous(const llama_ubatch * ubatch, uint32_t n_stream) const {
+    if (!mem_idx || !n_stream) return false;
+    const uint32_t n_tps = ubatch->n_tokens/n_stream;
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        const auto seq = ubatch->seq_id[s*n_tps][0];
+        const auto & cells = mem_idx->get_cells(seq);
+        auto & checked = contiguity_checked[seq];
+        // a hole-free prefix uses every cell below used_max_p1; a removal made on the indexer cache directly breaks that
+        if (checked.epoch != layout_epoch || checked.checked > cells.used_max_p1() || cells.get_used() != cells.used_max_p1()) {
+            checked = {layout_epoch, 0, true};
+        }
+        for (; checked.ok && checked.checked < cells.used_max_p1(); ++checked.checked) {
+            const uint32_t cell = checked.checked;
+            checked.ok = !cells.is_empty(cell) && cells.pos_get(cell) == (llama_pos) cell && cells.seq_has(cell, seq) &&
+                cells.seq_get_all(cell) == cells.seq_get_all(0);
+        }
+        if (!checked.ok) return false;
+    }
+    // M-RoPE ubatches always carry 2D positions, so is_pos_2d() is no test: image tokens share one
+    // temporal position, which the per-cell check above already rejects, and text keeps the 1D rule.
+    return true;
+}
