+static __global__ void count_ids(const char * __restrict__ ids, float * __restrict__ counts,
+        const int64_t ne0, const int64_t n, const size_t nb0, const size_t nb1, const int64_t n_counts) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+
+    const int32_t id = *(const int32_t *) (ids + (i % ne0)*nb0 + (i / ne0)*nb1);
+    if (id >= 0 && id < n_counts) {
+        atomicAdd(counts + id, 1.0f);
+    }
+}
+
+void ggml_cuda_count_ids(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * ids = dst->src[1];
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+
+    const int64_t n = ids->ne[0]*ids->ne[1];
+    if (n == 0) {
+        return;
+    }
+
+    const int bs = 256;
+    count_ids<<<(n + bs - 1) / bs, bs, 0, ctx.stream()>>>(
+        (const char *) ids->data, (float *) dst->data, ids->ne[0], n, ids->nb[0], ids->nb[1], dst->ne[0]);
+}
+
+// overlapped host experts: the GPU posts work to a host executor through pinned memory and later waits for the result
+
+static __device__ __forceinline__ uint64_t moe_host_time() {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    return clock64(); // cycles, roughly one or two per ns
+#else
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+#endif
+}
+
+static __global__ void moe_host_post(
+        const float * __restrict__ x, const int32_t * __restrict__ ids, const float * __restrict__ w, int32_t * __restrict__ ticket,
+        const ggml_moe_host_layer l, const int64_t nx, const int64_t nid, const uint32_t n_tok) {
+    // 16-byte stores: the host memory is written over the bus, where fewer and larger writes go faster
+    const int64_t nx4 = (uintptr_t) x % 16 == 0 && (uintptr_t) l.x % 16 == 0 ? nx/4 : 0;
+    for (int64_t i = threadIdx.x; i < nx4; i += blockDim.x) {
+        ((float4 *) l.x)[i] = ((const float4 *) x)[i];
+    }
+    for (int64_t i = 4*nx4 + threadIdx.x; i < nx; i += blockDim.x) {
+        l.x[i] = x[i];
+    }
+    for (int64_t i = threadIdx.x; i < nid; i += blockDim.x) {
+        l.ids[i] = ids[i];
+        l.w[i]   = w[i];
+    }
+    if (threadIdx.x == 0) {
+        *l.n_tok = n_tok;
+    }
+
+    // the host must see all data before the sequence number
+    __threadfence_system();
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        const uint32_t s = *l.seq + 1;
+        *l.seq  = s;
+        *ticket = (int32_t) s;
+        __threadfence_system();
+        *(volatile uint32_t *) l.post = s;
+    }
+}
+
+static __global__ void moe_host_wait(
+        const float * __restrict__ acc, const int32_t * __restrict__ ticket, float * __restrict__ dst,
+        const ggml_moe_host_layer l, int32_t * error, const int layer, const int64_t n, const uint64_t timeout) {
+    __shared__ int ok;
+
+    if (threadIdx.x == 0) {
+        const uint32_t s  = (uint32_t) *ticket;
+        const uint64_t t0 = moe_host_time();
+        ok = 1;
+        while (*(volatile uint32_t *) l.done != s) {
+            // never hang the GPU: after a timeout or an earlier error, go on without the host part
+            if (*(volatile int32_t *) error != 0 || moe_host_time() - t0 > timeout) {
+                if (*(volatile int32_t *) error == 0) {
+                    *(volatile int32_t *) error = layer + 1;
+                }
+                ok = 0;
+                break;
+            }
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+            __nanosleep(100);
+#endif
+        }
+        if (l.wait_ns && blockIdx.x == 0) {
+            volatile uint64_t * wait_ns = l.wait_ns;
+            *wait_ns = *wait_ns + (moe_host_time() - t0);
+        }
+        __threadfence_system();
+    }
+    __syncthreads();
+
+    // volatile loads: a cached line of out from the previous post would be stale
+    const volatile float * out = l.out;
+    for (int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x*blockDim.x) {
+        dst[i] = ok ? acc[i] + out[i] : acc[i];
+    }
+}
+
+void ggml_cuda_moe_host_post(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x   = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * w   = dst->src[2];
+
+    const int layer = ggml_get_op_params_i32(dst, 0);
+    const ggml_moe_host_exec * exec = ggml_get_op_params_moe_host_exec(dst);
+
+    moe_host_post<<<1, 512, 0, ctx.stream()>>>(
+        (const float *) x->data, (const int32_t *) ids->data, (const float *) w->data, (int32_t *) dst->data,
+        exec->layers[layer], ggml_nelements(x), ggml_nelements(ids), (uint32_t) x->ne[1]);
+}
+
+void ggml_cuda_moe_host_wait(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * acc    = dst->src[0];
+    const ggml_tensor * ticket = dst->src[1];
+
+    const int layer = ggml_get_op_params_i32(dst, 0);
+    const ggml_moe_host_exec * exec = ggml_get_op_params_moe_host_exec(dst);
+
+    const int64_t n  = ggml_nelements(dst);
+    const int     bs = 256;
+    const int     nb = (int) std::min<int64_t>((n + bs - 1) / bs, 16);
+
+    moe_host_wait<<<nb, bs, 0, ctx.stream()>>>(
+        (const float *) acc->data, (const int32_t *) ticket->data, (float *) dst->data,
+        exec->layers[layer], exec->error, layer, n, exec->timeout_ns);
+}
+
+// moe_split_ids: one warp per token, one lane per slot
+static __global__ void moe_split_ids_f32(const int32_t * ids, const float * hot, const float * cold, float * dst,
+                                         const int n_used, const int n_tok, const int64_t ids_nb1) {
+    const int t = blockIdx.x;
+    const int s = threadIdx.x;
+    const int32_t e = s < n_used ? ((const int32_t *) ((const char *) ids + t*ids_nb1))[s] : 0;
+
+    float low = s < n_used ? hot[2*e] : INFINITY;
+#pragma unroll
+    for (int offset = WARP_SIZE/2; offset > 0; offset >>= 1) {
+        low = fminf(low, __shfl_xor_sync(0xffffffff, low, offset, WARP_SIZE));
+    }
+    if (s >= n_used) {
+        return;
+    }
+
+    const int64_t n_plane = (int64_t) n_used*n_tok;
+    const int64_t i = (int64_t) t*n_used + s;
+    const bool is_cold = hot[2*e + 1]  != 0.0f;
+    const bool is_hot  = cold[2*e + 1] != 0.0f;
+    dst[i]             = is_cold ? low : hot[2*e];
+    dst[n_plane + i]   = is_hot ? -1.0f : cold[2*e];
+    dst[2*n_plane + i] = is_cold ? 0.0f : 1.0f;
+}
+
+void ggml_cuda_moe_split_ids(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * ids  = dst->src[0];
+    const ggml_tensor * hot  = dst->src[1];
+    const ggml_tensor * cold = dst->src[2];
+    const int n_used = (int) ids->ne[0];
+    const int n_tok  = (int) ids->ne[1];
+    GGML_ASSERT(n_used <= WARP_SIZE);
+    if (n_tok == 0) {
+        return;
+    }
+    moe_split_ids_f32<<<n_tok, WARP_SIZE, 0, ctx.stream()>>>((const int32_t *) ids->data, (const float *) hot->data,
+            (const float *) cold->data, (float *) dst->data, n_used, n_tok, ids->nb[1]);
+}
