+        int prefix, total;
+        scan(temp).ExclusiveSum(keep, prefix, total);
+        const int destination = written + prefix;
+        if (keep && destination < width) output[size_t(row)*width + destination] = cell;
+        __syncthreads();
+        if (tid == 0) written += total;
+        __syncthreads();
