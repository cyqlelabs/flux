+void llama_context::moe_cache_reclaim() {
+    if (moe_cache && moe_cache->lent) {
+        // the copy stream may still upload into the regions
+        ggml_backend_sched_synchronize(sched.get());
+        prompt_unlend();
+        moe_cache->reclaim();
+    }
