+void llama_memory_hybrid_idx::pooled_invalidate(llama_seq_id seq, llama_pos p0, llama_pos p1) {
+    ++pooled_epoch;
+    ++layout_epoch;
+    if (!mem_idx) return;
+    const uint32_t streams = mem_idx->get_n_stream();
+    for (auto & entry : pooled_layouts) {
+        auto & layout = entry.second;
+        for (uint32_t s = 0; s < streams; ++s) {
+            if (seq >= 0 && streams > 1 && s != (uint32_t) seq) continue;
+            const auto & cells = mem_idx->get_cells(streams == 1 ? 0 : (llama_seq_id) s);
+            for (uint32_t b = 0; b < layout.capacity; ++b) {
+                const size_t slot = size_t(s)*layout.capacity + b;
+                if (!layout.valid[slot]) continue;
+                if (p0 < 0 && p1 < 0) {
+                    layout.valid[slot] = 0;
+                    continue;
+                }
+                for (uint32_t i = 0; i < entry.first; ++i) {
+                    const uint32_t cell = layout.signature[slot][i];
+                    const auto pos = cells.pos_get(cell);
+                    if ((seq < 0 || cells.seq_has(cell, seq)) && pos >= std::max(0, p0) && (p1 < 0 || pos < p1)) {
+                        layout.valid[slot] = 0;
+                        break;
+                    }
+                }
+            }
+        }
+    }
+}
+
+uint32_t llama_memory_hybrid_idx::pooled_dirty(const llama_ubatch * ubatch, uint32_t ratio, uint32_t n_kv, uint32_t n_stream) const {
+    auto & layout = pooled_layouts.at(ratio);
+    const uint32_t n_tps = ubatch->n_tokens/n_stream;
+    std::vector<llama_seq_id> streams(n_stream);
+    for (uint32_t s = 0; s < n_stream; ++s) streams[s] = ubatch->seq_id[s*n_tps][0];
+    const size_t positions = size_t(ubatch->n_tokens)*std::max(1u, ubatch->n_pos);
+    if (layout.epoch == pooled_epoch && layout.n_kv == n_kv && layout.n_stream == n_stream &&
+        layout.n_tps == n_tps && layout.streams == streams && layout.query_positions.size() == positions &&
+        std::equal(layout.query_positions.begin(), layout.query_positions.end(), ubatch->pos)) return layout.dirty;
+    layout.streams = std::move(streams);
+    layout.query_positions.assign(ubatch->pos, ubatch->pos + positions);
+    layout.epoch = pooled_epoch;
+    layout.n_kv = n_kv;
+    layout.n_stream = n_stream;
+    layout.n_tps = n_tps;
+    const uint32_t blocks = (n_kv + ratio - 1)/ratio;
+    layout.cell_blk.resize(size_t(n_kv)*n_stream);
+    layout.blk_cells.resize(size_t(ratio)*blocks*n_stream);
+    layout.blk_pos.resize(size_t(4)*blocks*n_stream);
+    layout.bias.resize(size_t(blocks)*n_tps*n_stream);
+    ggml_tensor cell_blk{}, blk_cells{}, blk_pos{}, bias{};
+    cell_blk.ne[0] = n_kv; cell_blk.ne[1] = n_stream; cell_blk.data = layout.cell_blk.data();
+    blk_cells.data = layout.blk_cells.data();
+    blk_pos.ne[0] = size_t(4)*blocks*n_stream; blk_pos.data = layout.blk_pos.data();
+    bias.data = layout.bias.data();
+    ggml_backend_buffer_ptr host(ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 0));
+    cell_blk.buffer = host.get();
+    set_input_qsa(&cell_blk, &blk_cells, &blk_pos, &bias, ubatch, ratio, true);
+    std::vector<std::vector<uint32_t>> dirty(n_stream);
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        const uint32_t stream = mem_idx->get_n_stream() == 1 ? 0 : ubatch->seq_id[s*n_tps][0];
+        for (uint32_t b = 0; b < blocks; ++b) {
+            std::vector<int32_t> signature(ratio + 4);
+            std::copy_n(layout.blk_cells.data() + (size_t(s)*blocks + b)*ratio, ratio, signature.data());
+            for (uint32_t sec = 0; sec < 4; ++sec) signature[ratio + sec] = layout.blk_pos[(size_t(sec)*n_stream + s)*blocks + b];
+            const size_t slot = size_t(stream)*layout.capacity + b;
+            if (!layout.valid[slot] || layout.signature[slot] != signature) dirty[s].push_back(b);
+        }
+    }
+    layout.dirty = 1;
+    for (const auto & row : dirty) layout.dirty = std::max<uint32_t>(layout.dirty, row.size());
+    layout.dirty_cells.resize(size_t(ratio)*layout.dirty*n_stream);
+    layout.dirty_pos.resize(size_t(4)*layout.dirty*n_stream);
+    layout.dirty_idxs.resize(size_t(layout.dirty)*n_stream);
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        const uint32_t stream = mem_idx->get_n_stream() == 1 ? 0 : ubatch->seq_id[s*n_tps][0];
+        for (uint32_t i = 0; i < layout.dirty; ++i) {
+            const uint32_t block = i < dirty[s].size() ? dirty[s][i] : (dirty[s].empty() ? 0 : dirty[s].front());
+            const size_t at = size_t(s)*layout.dirty + i;
+            std::copy_n(layout.blk_cells.data() + (size_t(s)*blocks + block)*ratio, ratio, layout.dirty_cells.data() + at*ratio);
+            for (uint32_t sec = 0; sec < 4; ++sec) layout.dirty_pos[size_t(sec)*n_stream*layout.dirty + at] = layout.blk_pos[(size_t(sec)*n_stream + s)*blocks + block];
+            layout.dirty_idxs[at] = stream*layout.capacity + block;
+        }
+    }
+    return layout.dirty;
+}
+
+void llama_memory_hybrid_idx::set_input_pooled(
+        ggml_tensor * cell_blk, ggml_tensor * blk_cells, ggml_tensor * blk_pos, ggml_tensor * bias,
+        ggml_tensor * dirty_cells, ggml_tensor * dirty_pos, ggml_tensor * dirty_idxs,
+        const llama_ubatch * ubatch, uint32_t ratio, bool blk_bias) const {
+    GGML_ASSERT(blk_bias);
+    pooled_dirty(ubatch, ratio, cell_blk->ne[0], cell_blk->ne[1]);
+    auto & layout = pooled_layouts.at(ratio);
+    auto copy = [](ggml_tensor * tensor, const auto & data) {
+        GGML_ASSERT(ggml_nbytes(tensor) == data.size()*sizeof(data[0]));
+        ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+    };
+    copy(cell_blk, layout.cell_blk); copy(blk_cells, layout.blk_cells); copy(blk_pos, layout.blk_pos); copy(bias, layout.bias);
+    copy(dirty_cells, layout.dirty_cells); copy(dirty_pos, layout.dirty_pos); copy(dirty_idxs, layout.dirty_idxs);
+    for (size_t i = 0; i < layout.dirty_idxs.size(); ++i) {
+        const size_t slot = layout.dirty_idxs[i];
+        auto & signature = layout.signature[slot];
+        signature.resize(ratio + 4);
+        std::copy_n(layout.dirty_cells.data() + i*ratio, ratio, signature.data());
+        for (uint32_t sec = 0; sec < 4; ++sec) signature[ratio + sec] = layout.dirty_pos[size_t(sec)*layout.dirty_idxs.size() + i];
+        layout.valid[slot] = 1;
+    }
+    // Only the first spare block is read by unpooled cells. Padding blocks stay cached.
+    const uint32_t blocks = (layout.n_kv + ratio - 1)/ratio;
+    for (uint32_t s = 0; ratio > 1 && s < layout.n_stream; ++s) {
+        for (uint32_t b = 0; b < blocks; ++b) {
+            const auto * members = layout.blk_cells.data() + (size_t(s)*blocks + b)*ratio;
+            if (std::all_of(members, members + ratio, [](int32_t cell) { return cell == 0; })) {
+                const uint32_t stream = mem_idx->get_stream(layout.streams[s]);
+                layout.valid[size_t(stream)*layout.capacity + b] = 0;
+                break;
+            }
+        }
+    }
+}
