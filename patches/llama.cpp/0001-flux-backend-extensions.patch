+bool llama_kv_cache::commit(const slot_info & sinfo, uint32_t n_kv) {
+    n_kv = std::min(get_size(), GGML_PAD(n_kv, std::max(n_pad, 256u)));
+    if (page_ledger) {
+        std::vector<llama_kv_page_request> requests;
+        return collect_commit(sinfo.s0, sinfo.s1, n_kv, requests) && page_ledger->commit(requests);
+    }
+    struct change { page_region * region; uint32_t stream; size_t offset; size_t bytes; };
+    std::vector<change> changes;
+    for (auto & region : page_regions) {
+        auto * tensor = region.tensor;
+        const size_t prefix = GGML_PAD(size_t(n_kv)*tensor->nb[1], region.page_size);
+        GGML_ASSERT(prefix <= tensor->nb[2]);
+        const size_t base = (char *) tensor->data - (char *) ggml_backend_buffer_get_base(tensor->buffer);
+        for (uint32_t s = sinfo.s0; s <= sinfo.s1; ++s) {
+            const size_t old = region.committed[s];
+            if (prefix <= old) {
+                continue;
+            }
+            const size_t offset = base + s*tensor->nb[2] + old;
+            if (!ggml_backend_buffer_commit(tensor->buffer, offset, prefix - old, GGML_BACKEND_PAGE_DEVICE)) {
+                for (auto it = changes.rbegin(); it != changes.rend(); ++it) {
+                    if (!ggml_backend_buffer_release(it->region->tensor->buffer, it->offset, it->bytes)) {
+                        throw std::runtime_error("failed to roll back KV page admission");
+                    }
+                    it->region->committed[it->stream] -= it->bytes;
+                }
+                return false;
+            }
+            region.committed[s] = prefix;
+            changes.push_back({&region, s, offset, prefix - old});
+        }
+    }
+    return true;
+}
