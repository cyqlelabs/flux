+    const int64_t i  = (int64_t) blockIdx.y*blockDim.x + threadIdx.x; // channel
+    const int64_t s  = blockIdx.x;
+    const int64_t t0 = (int64_t) blockIdx.z*32;
+    if (i >= d_inner) {
