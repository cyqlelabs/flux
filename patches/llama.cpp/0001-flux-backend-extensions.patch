+        lock.unlock();
+
+        for (const job & j : jobs) {
+            const auto & l = layers[j.layer];
+            for (int k = 0; k < 4; ++k) {
+                if (l.src[k]) {
+                    const size_t nb = l.src[k]->nb[2];
+                    ggml_backend_tensor_set_async(l.backend_copy, l.pool[k], (const char *) l.src[k]->data + j.expert*nb, j.slot*nb, nb);
+                }
+            }
+        }
+        for (const auto & backend : backends_copy) {
+            ggml_backend_synchronize(backend.get());
+        }
+
+        lock.lock();
+        done.insert(done.end(), jobs.begin(), jobs.end());
+        cv_done.notify_all();
+    }
+}
+
+void llama_moe_cache::admit(const std::vector<job> & admitted) {
+    for (const job & j : admitted) {
+        auto & l = layers[j.layer];
+        l.slot[j.expert] = j.slot;
+        l.map_hot [2*j.expert + 0] = j.slot;
+        l.map_hot [2*j.expert + 1] = 0.0f;
+        l.map_cold[2*j.expert + 1] = 1.0f;
+        l.dirty = true;
+    }
+    n_flight -= (int32_t) admitted.size();
+}
+
+void llama_moe_cache::lend() {
+    if (loans.empty() || lent) {
+        return;
+    }
+
+    // no refill may land in a region once it is lent: wait for those in flight and admit them
+    std::vector<job> admitted;
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        cv_done.wait(lock, [this] { return queued.empty() && (int32_t) done.size() == n_flight; });
+        admitted.swap(done);
+    }
+    // no graph runs from here on
+    flush();
+    admit(admitted);
+
+    for (auto & ln : loans) {
+        for (const auto & [i, sl] : ln.slots) {
+            auto & l = layers[i];
+            const int32_t e = sl < l.n_slots ? l.expert[sl] : -1;
+            if (e < 0) {
+                continue;
+            }
+            ln.evicted.push_back({ i, e, sl });
+            l.expert[sl] = -1;
+            l.slot[e]    = -1;
+            l.map_hot [2*e + 0] = l.n_slots;
+            l.map_hot [2*e + 1] = 1.0f;
+            l.map_cold[2*e + 1] = 0.0f;
+            l.dirty = true;
+        }
+    }
+    llama_moe_cache_write_maps(*this);
+    lent = true;
+}
+
+void llama_moe_cache::reclaim() {
+    if (!lent) {
+        return;
+    }
+
+    // the offloaded batches are done with the regions
+    for (ggml_backend_t backend : backends) {
+        ggml_backend_synchronize(backend);
+    }
+
+    // the zero expert pads the hot part, which the next batch below the offload size may run
+    for (const auto & ln : loans) {
+        for (const auto & [i, sl] : ln.slots) {
+            const auto & l = layers[i];
+            for (ggml_tensor * t : l.pool) {
+                if (t && sl == l.n_slots) {
+                    ggml_backend_tensor_memset(t, 0, sl*t->nb[2], t->nb[2]);
+                }
+            }
+        }
+    }
+
+    std::vector<job> jobs;
+    for (auto & ln : loans) {
+        jobs.insert(jobs.end(), ln.evicted.begin(), ln.evicted.end());
+        ln.evicted.clear();
+    }
+    lent = false;
+
+    // the same experts as before the loan. A frozen cache keeps its residency for every batch, so it waits for them;
+    // otherwise the worker copies them like any refill, and update() admits them while the decode goes on
+    for (const job & j : jobs) {
+        layers[j.layer].expert[j.slot] = j.expert;
+    }
+    n_flight += (int32_t) jobs.size();
+    if (!frozen) {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            queued.insert(queued.end(), jobs.begin(), jobs.end());
+        }
+        cv.notify_one();
+        return;
+    }
+    for (const job & j : jobs) {
+        const auto & l = layers[j.layer];
+        for (int k = 0; k < 4; ++k) {
+            if (l.src[k]) {
+                const size_t nb = l.src[k]->nb[2];
+                ggml_backend_tensor_set_async(l.backend_copy, l.pool[k], (const char *) l.src[k]->data + j.expert*nb, j.slot*nb, nb);
+            }
+        }
+    }
+    for (const auto & backend : backends_copy) {
+        ggml_backend_synchronize(backend.get());
+    }
+    admit(jobs);
+    llama_moe_cache_write_maps(*this);
+}
+
+ggml_tensor * llama_moe_cache::expert_source(void * user_data, const ggml_tensor * weight, int32_t expert, int64_t * index) {
+    const auto * c = (const llama_moe_cache *) user_data;
+    const auto it = c->src_index.find(weight);
+    if (it == c->src_index.end()) {
+        return nullptr;
+    }
+    const auto & l = c->layers[it->second.first];
+    const int32_t s = l.slot[expert];
+    if (s < 0) {
+        return nullptr;
+    }
+    *index = s;
+    return l.pool[it->second.second];
+}
+
+bool llama_moe_cache::host_failed() {
+    if (!host || host_off) {
+        return false;
+    }
+    const int32_t err = reinterpret_cast<std::atomic<int32_t> *>(host->exec.error)->load(std::memory_order_relaxed);
+    if (err == 0) {
+        return false;
+    }
+
+    if (err > 0) {
+        LLAMA_LOG_ERROR("%s: layer %d: the GPU waited too long for the host experts\n", __func__, err - 1);
+    } else {
+        LLAMA_LOG_ERROR("%s: layer %d: the host experts failed\n", __func__, -err - 1);
+    }
+    LLAMA_LOG_ERROR("%s: the outputs since then are invalid; the host experts run synchronously from now on\n", __func__);
+
+    for (auto & g : graph) {
+        g.host = nullptr;
+    }
+    host_off = true;
+    host->off = true;
+
+    return true;
+}
+
+void llama_moe_cache::host_profile() {
+    uint64_t wait_ns = 0;
+    for (const auto & l : layers) {
+        volatile uint64_t * p = host->slots[l.il].wait_ns;
+        wait_ns += *p;
+        *p = 0;
+    }
+    const uint64_t compute_ns = host->prof_compute.exchange(0);
+    const uint64_t idle_ns    = host->prof_idle.exchange(0);
+    const uint64_t posts      = host->prof_posts.exchange(0);
+    const uint64_t live       = host->prof_live.exchange(0);
+    const uint64_t tier       = host->prof_tier.exchange(0);
+    const uint64_t tier_ns    = host->prof_tier_ns.exchange(0);
+    const uint64_t tier_wait  = host->prof_tier_wait.exchange(0);
+    const uint64_t tier_late  = host->prof_tier_late.exchange(0);
+
+    // opt-in output, so warn level: a default log filter keeps it
+    const double n = n_graphs_prof;
+    const int64_t n_hits    = hits    - hits_prof;
+    const int64_t n_lookups = lookups - lookups_prof;
+    LLAMA_LOG_WARN("moe host profile: passes %d posts/pass %.1f gpu_served %.1f%% gpu_wait %.2f ms/pass host_compute %.2f ms/pass host_idle %.2f ms/pass "
+            "live_slots/post %.2f tier %.2f ms/pass tier_wait %.2f ms/pass tier_slots/post %.2f tier_late %d tier_swaps %d pre_kick %.2f ms/pass "
+            "tail %.2f ms/pass graph_reused %d graph_built %d\n",
+            n_graphs_prof, posts / n, n_lookups ? 100.0 * n_hits / n_lookups : 0.0, wait_ns / n / 1e6, compute_ns / n / 1e6, idle_ns / n / 1e6,
+            posts ? (double) live / posts : 0.0,
+            tier_ns / n / 1e6, tier_wait / n / 1e6, posts ? (double) tier / posts : 0.0, (int) tier_late, n_swaps_tier_prof,
+            host->prof_pre_kick / n / 1e6, host->prof_tail / n / 1e6, host->prof_reused, host->prof_built);
+
+    n_graphs_prof       = 0;
+    n_swaps_tier_prof   = 0;
+    hits_prof           = hits;
+    lookups_prof        = lookups;
+    host->prof_pre_kick = 0;
+    host->prof_tail     = 0;
+    host->prof_reused   = 0;
+    host->prof_built    = 0;
+}
+
+//
+// flux: overlapped host experts
+//
+
+static uint32_t llama_moe_host_load(const uint32_t * p) {
+    return reinterpret_cast<const std::atomic<uint32_t> *>(p)->load(std::memory_order_acquire);
+}
+
+static void llama_moe_host_store(uint32_t * p, uint32_t v) {
+    reinterpret_cast<std::atomic<uint32_t> *>(p)->store(v, std::memory_order_release);
+}
+
+static int64_t llama_moe_host_time_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+int64_t llama_moe_host::time_ns() {
+    return llama_moe_host_time_ns();
+}
+
+static void llama_moe_host_relax() {
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#elif defined(__aarch64__)
+    __asm__ __volatile__("yield" ::: "memory");
+#endif
+}
+
+llama_moe_host::~llama_moe_host() {
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        stop = true;
+    }
+    cv.notify_all();
+    if (thread.joinable()) {
+        thread.join();
+    }
+
+    graphs.clear();
+    if (galloc) {
+        ggml_gallocr_free(galloc);
+    }
+    tiers.clear();
+    cpu.reset();
+    if (threadpool) {
+        threadpool_free(threadpool);
+    }
+}
+
+bool llama_moe_host::init(const llama_moe_cache & cache, const llama_hparams & hparams, int32_t n_threads, int64_t n_tok_max) {
+    if (cache.layers.empty() || n_tok_max < 1) {
+        return false;
+    }
+
+    const int32_t n_layer = hparams.n_layer_all;
+    slots.resize(n_layer);
+    src.resize(n_layer);
+    n_used.assign(n_layer, 0);
+    last.assign(n_layer, 0);
+    tier_layers.resize(n_layer);
+
+    // pinned layout: the error word, then per layer x, ids, w, out and the n_tok, post and done words on their own cache lines
+    const size_t align = 256;
+    struct offsets {
+        size_t x, ids, w, out, n_tok, post, done, wait;
+    };
+    std::vector<offsets> offs(n_layer);
+    size_t size = align;
+    std::map<ggml_backend_dev_t, std::vector<int32_t>> dev_layers;
+    for (const auto & l : cache.layers) {
+        ggml_tensor * w_in = l.src[3] ? l.src[3] : l.src[0];
+        const int64_t n_in  = w_in->ne[0];
+        const int64_t n_out = l.src[2]->ne[1];
+
+        src[l.il]    = { l.src[0], l.src[1], l.src[2], l.src[3] };
+        n_used[l.il] = hparams.n_expert_used(l.il);
+        order.push_back(l.il);
+        dev_layers[ggml_backend_get_device(l.backend)].push_back(l.il);
+
+        auto & o = offs[l.il];
+        o.x     = size; size += GGML_PAD(n_in*n_tok_max*sizeof(float), align);
+        o.ids   = size; size += GGML_PAD(n_used[l.il]*n_tok_max*sizeof(int32_t), align);
+        o.w     = size; size += GGML_PAD(n_used[l.il]*n_tok_max*sizeof(float), align);
+        o.out   = size; size += GGML_PAD(n_out*n_tok_max*sizeof(float), align);
+        o.n_tok = size; size += align;
+        o.post  = size; size += align;
+        o.done  = size; size += align;
+        o.wait  = size; size += align;
+    }
+    std::sort(order.begin(), order.end());
+
+    // pinned memory is device-addressable with unified addressing; with GGML_CUDA_NO_PINNED the allocation falls back to plain memory
+    ggml_backend_buffer_type_t buft_host = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(cache.layers[0].backend));
+    if (!buft_host) {
+        return false;
+    }
+    buf.reset(ggml_backend_buft_alloc_buffer(buft_host, size));
+    if (!buf || ggml_backend_buffer_get_type(buf.get()) != buft_host) {
+        return false;
+    }
+    ggml_backend_buffer_clear(buf.get(), 0);
+
+    const char * prof_env = getenv("FLUX_MOE_HOST_PROFILE");
+    prof = prof_env && atoi(prof_env) != 0;
+
+    char * base = (char *) ggml_backend_buffer_get_base(buf.get());
+    for (int32_t il : order) {
+        const auto & o = offs[il];
+        auto & s = slots[il];
+        s.x     = (float    *) (base + o.x);
+        s.ids   = (int32_t  *) (base + o.ids);
+        s.w     = (float    *) (base + o.w);
+        s.out   = (float    *) (base + o.out);
+        s.n_tok = (uint32_t *) (base + o.n_tok);
+        s.post  = (uint32_t *) (base + o.post);
+        s.done  = (uint32_t *) (base + o.done);
+        s.wait_ns = prof ? (uint64_t *) (base + o.wait) : nullptr;
+    }
+
+    exec.layers     = slots.data();
+    exec.error      = (int32_t *) base;
+    exec.n_tok_max  = n_tok_max;
+    exec.timeout_ns = 5000000000ull;
+
+    for (const auto & [dev, ils] : dev_layers) {
+        // the post counters live in device memory
+        ggml_backend_buffer_t buf_dev = ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(dev), ils.size()*sizeof(uint32_t));
+        if (!buf_dev) {
+            return false;
+        }
+        buf_seq.emplace_back(buf_dev);
+        ggml_backend_buffer_clear(buf_dev, 0);
+        uint32_t * seq = (uint32_t *) ggml_backend_buffer_get_base(buf_dev);
+        for (size_t j = 0; j < ils.size(); ++j) {
+            slots[ils[j]].seq = seq + j;
+        }
+
+        ggml_init_params params = {
+            /*.mem_size   =*/ 8*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx(ggml_init(params));
+        const int32_t il = ils[0];
+        ggml_tensor * x    = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, (src[il][3] ? src[il][3] : src[il][0])->ne[0], 1);
+        ggml_tensor * ids  = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, n_used[il], 1);
+        ggml_tensor * w    = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, n_used[il], 1);
+        ggml_tensor * post = ggml_moe_host_post(ctx.get(), x, ids, w, il, &exec);
+        ggml_tensor * wait = ggml_moe_host_wait(ctx.get(), x, post, il, &exec);
+        // the ops hand the device pointers to pinned host memory: only a local device of a backend that page-locks
+        // host memory runs them (not one behind RPC, whose support check does not see the pointers)
+        if (!ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(dev), "ggml_backend_pin_host_buffer") ||
+                !ggml_backend_dev_supports_op(dev, post) || !ggml_backend_dev_supports_op(dev, wait)) {
+            return false;
+        }
+    }
+
+    cpu.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+    if (!cpu) {
+        return false;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(cpu.get()));
+    auto * set_n_threads_fn  = (ggml_backend_set_n_threads_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+    auto * threadpool_new_fn = (decltype(ggml_threadpool_new) *) ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_new");
+    auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+    threadpool_free = (decltype(ggml_threadpool_free) *) ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_free");
+    if (set_n_threads_fn) {
+        set_n_threads_fn(cpu.get(), n_threads);
+    }
+    if (threadpool_new_fn && set_threadpool_fn && threadpool_free) {
+        ggml_threadpool_params tpp = ggml_threadpool_params_default(n_threads);
+        threadpool = threadpool_new_fn(&tpp);
+        if (threadpool) {
+            set_threadpool_fn(cpu.get(), threadpool);
+        }
+    }
+
+    galloc = ggml_gallocr_new(ggml_backend_cpu_buffer_type());
+
+    thread = std::thread([this] { run(); });
+
+    LLAMA_LOG_INFO("%s: overlapped host experts on %d threads, %.2f MiB pinned\n", __func__, n_threads, size / 1024.0 / 1024.0);
+
+    return true;
+}
+
+void llama_moe_host::kick() {
+    if (prof) {
+        prof_t_kick.store(llama_moe_host_time_ns(), std::memory_order_relaxed);
+    }
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        kicked = true;
+    }
+    cv.notify_one();
+}
+
+void llama_moe_host::run() {
+    using clock = std::chrono::steady_clock;
+
+    auto    t_active = clock::now();
+    size_t  next     = 0;
+    int64_t t_prev   = 0; // profiling: the last done, or the kick of the pass
+
+    while (!stop.load(std::memory_order_relaxed)) {
+        if (kicked.exchange(false)) {
+            t_active = clock::now();
+            if (prof) {
+                t_prev = prof_t_kick.load(std::memory_order_relaxed);
+            }
+        }
+
+        // the layers of a pass post in order, so look at the layer after the last one first
+        bool found = false;
+        for (size_t k = 0; k < order.size(); ++k) {
+            const size_t   i  = (next + k) % order.size();
+            const int32_t  il = order[i];
+            const uint32_t s  = llama_moe_host_load(slots[il].post);
+            if (s != last[il]) {
+                const int64_t t_seen = prof ? llama_moe_host_time_ns() : 0;
+                {
+                    std::lock_guard<std::mutex> lock(compute_mutex);
+                    compute(il);
+                }
+                if (prof) {
+                    const int64_t t_done = llama_moe_host_time_ns();
+                    prof_compute += t_done - t_seen;
+                    prof_t_done.store(t_done, std::memory_order_relaxed);
+                    prof_idle    += t_prev > 0 ? t_seen - t_prev : 0;
+                    prof_posts   += 1;
+                    t_prev = t_done;
+                }
+                llama_moe_host_store(slots[il].done, s);
+                last[il] = s;
+                next     = i + 1;
+                found    = true;
+                break;
+            }
+        }
+
+        if (found) {
+            t_active = clock::now();
+            continue;
+        }
+        if (clock::now() - t_active < std::chrono::milliseconds(5)) {
+            llama_moe_host_relax();
+            continue;
+        }
+
+        // idle: sleep until a kick, and look again every ms in case a graph runs without one; once the graphs no
+        // longer post, until stop
+        std::unique_lock<std::mutex> lock(mutex);
+        if (off.load()) {
+            cv.wait(lock, [this] { return stop.load(); });
+        } else {
+            cv.wait_for(lock, std::chrono::milliseconds(1), [this] { return stop.load() || kicked.load(); });
+        }
+    }
+}
+
+void llama_moe_host::compute(int32_t il) {
+    const auto & s  = slots[il];
+    const auto & tl = tier_layers[il];
+
+    const int32_t n_tok = (int32_t) *s.n_tok;
+    const int64_t n_out = src[il][2]->ne[1];
+
+    if (n_tok < 1 || n_tok > exec.n_tok_max) {
+        reinterpret_cast<std::atomic<int32_t> *>(exec.error)->store(-(il + 1), std::memory_order_relaxed);
+        return;
+    }
+
+    // split the slots that use a host expert: the tier runs its experts, the CPU the rest. A tier still busy
+    // with a late post leaves them all to the CPU.
+    const int64_t n_slot = n_used[il]*n_tok;
+    tier * t = tl.tier >= 0 && tier_ok.load(std::memory_order_acquire) ? tiers[tl.tier].get() : nullptr;
+    if (t && t->done.load(std::memory_order_acquire) != t->issued) {
+        t = nullptr;
+    }
+    int64_t live = 0;
+    tier_moved.clear();
+    if (t) {
+        const int32_t zero = (int32_t) tl.pool[2]->ne[2] - 1;
+        for (int64_t i = 0; i < n_slot; ++i) {
+            const int32_t e  = s.ids[i];
+            const int32_t ts = e >= 0 ? tl.slot[e] : -1;
+            t->ids_host[i] = ts >= 0 ? ts : zero;
+            if (ts >= 0) {
+                tier_moved.emplace_back((int32_t) i, e);
+                s.ids[i] = -1;
+            } else {
+                live += e >= 0;
+            }
+        }
+    } else {
+        // skip the CPU graph when no slot uses a host expert; only profiling counts them all
+        for (int64_t i = 0; i < n_slot && (prof || live == 0); ++i) {
+            live += s.ids[i] >= 0;
+        }
+    }
+    const int64_t n_tier = tier_moved.size();
+    if (prof) {
+        prof_live += live;
+        prof_tier += n_tier;
+    }
+
+    const int64_t t_issue = n_tier > 0 ? llama_moe_host_time_ns() : 0;
+    if (n_tier > 0) {
+        {
+            std::lock_guard<std::mutex> lock(t->mutex);
+            t->job_il    = il;
+            t->job_n_tok = n_tok;
+            t->job_seq   = ++t->issued;
+        }
+        t->cv.notify_one();
+    }
+
+    bool ok = true;
+    if (live > 0) {
+        ggml_cgraph * gf = graph(il, n_tok);
+        ok = gf && ggml_backend_graph_compute(cpu.get(), gf) == GGML_STATUS_SUCCESS;
+    }
+
+    bool late = false;
+    if (n_tier > 0) {
+        // the tier normally finishes long before the CPU graph; it is late at three times its usual latency
+        const int64_t t_wait   = llama_moe_host_time_ns();
+        const int64_t wait_ns  = t->n_lat < 2 ? 10000000 : (int64_t) (3.0*t->lat_avg_ns);
+        const int64_t deadline = t_issue + wait_ns;
+        int64_t t_ready = t_wait;
+        while (t->done.load(std::memory_order_acquire) != t->issued && (t_ready = llama_moe_host_time_ns()) < deadline) {
+            llama_moe_host_relax();
+        }
+        late = t->done.load(std::memory_order_acquire) != t->issued || !t->ok.load(std::memory_order_relaxed);
+        // a late job counts with the deadline, so a tier that is slower than it was moves the deadline out
+        const double lat = late ? (double) wait_ns : (double) (t->t_done.load(std::memory_order_relaxed) - t_issue);
+        if (t->n_lat == 1) {
+            t->lat_avg_ns = lat;
+        } else if (t->n_lat > 1) {
+            t->lat_avg_ns += 0.1*(lat - t->lat_avg_ns);
+        }
+        t->n_lat++;
+        if (prof) {
+            prof_tier_ns   += t_ready - t_issue;
+            prof_tier_wait += t_ready - t_wait;
+            prof_tier_late += late;
+        }
+    }
+
+    if (late && ok) {
+        // run the tier slots on the CPU and add the rows of the others
+        if (live > 0) {
+            tier_keep.assign(s.out, s.out + n_out*n_tok);
+        }
+        std::fill(s.ids, s.ids + n_slot, -1);
+        for (const auto & [i, e] : tier_moved) {
+            s.ids[i] = e;
+        }
+        ggml_cgraph * gf = graph(il, n_tok);
+        ok = gf && ggml_backend_graph_compute(cpu.get(), gf) == GGML_STATUS_SUCCESS;
+        for (int64_t i = 0; ok && live > 0 && i < n_out*n_tok; ++i) {
+            s.out[i] += tier_keep[i];
+        }
+    } else if (ok && n_tier > 0 && live > 0) {
+        for (int64_t i = 0; i < n_out*n_tok; ++i) {
+            s.out[i] += t->out_host[i];
+        }
+    } else if (ok && n_tier > 0) {
+        memcpy(s.out, t->out_host, n_out*n_tok*sizeof(float));
+    } else if (ok && live == 0) {
+        memset(s.out, 0, n_out*n_tok*sizeof(float));
+    }
+
+    if (!ok) {
+        LLAMA_LOG_ERROR("%s: layer %d: failed to compute the host experts\n", __func__, il);
+        memset(s.out, 0, n_out*n_tok*sizeof(float));
+        reinterpret_cast<std::atomic<int32_t> *>(exec.error)->store(-(il + 1), std::memory_order_relaxed);
+    }
+}
+
+void llama_moe_host::tier_run(tier & t) {
+    uint64_t seq = 0;
+    while (true) {
+        int32_t    il    = -1;
+        int32_t    n_tok = 0;
+        tier::copy cp    = {};
+        {
+            std::unique_lock<std::mutex> lock(t.mutex);
+            t.cv.wait(lock, [&] { return t.stop || t.job_seq != seq || !t.copies.empty(); });
+            if (t.stop) {
+                return;
+            }
+            // the executor waits for a job, so jobs go first, and copies run one expert at a time
+            if (t.job_seq != seq) {
+                il    = t.job_il;
+                n_tok = t.job_n_tok;
+                seq   = t.job_seq;
+            } else {
+                cp = t.copies.front();
+                t.copies.pop_front();
+            }
+        }
+
+        ggml_backend_t backend = t.backend.get();
+
+        if (il < 0) {
+            // the cache admits the expert into its slot at its next update, once the copy has landed
+            const auto & tl = tier_layers[cp.il];
+            for (int k = 0; k < 4; ++k) {
+                const ggml_tensor * s = src[cp.il][k];
+                if (s) {
+                    const size_t nb = s->nb[2];
+                    ggml_backend_tensor_set_async(backend, tl.pool[k], (const char *) s->data + cp.expert*nb, cp.slot*nb, nb);
+                }
+            }
+            ggml_backend_synchronize(backend);
+            std::lock_guard<std::mutex> lock(t.mutex);
+            t.copied.push_back(cp);
+            continue;
+        }
+
+        // copy the inputs in, compute and copy the rows back
+        const auto &  s = slots[il];
+        tier::graph * g = tier_graph(il, n_tok);
+        bool ok = g != nullptr;
+        if (ok) {
+            ggml_backend_tensor_set_async(backend, g->x,   s.x,        0, ggml_nbytes(g->x));
+            ggml_backend_tensor_set_async(backend, g->ids, t.ids_host, 0, ggml_nbytes(g->ids));
+            ggml_backend_tensor_set_async(backend, g->w,   s.w,        0, ggml_nbytes(g->w));
+            ok = ggml_backend_graph_compute_async(backend, g->gf) == GGML_STATUS_SUCCESS;
+            if (ok) {
+                ggml_backend_tensor_get_async(backend, g->out, t.out_host, 0, ggml_nbytes(g->out));
+            }
+            ggml_backend_synchronize(backend);
+        }
+        t.ok.store(ok, std::memory_order_relaxed);
+        t.t_done.store(llama_moe_host::time_ns(), std::memory_order_relaxed);
+        t.done.store(seq, std::memory_order_release);
+    }
+}
+
+// as in build_moe_ffn for LLM_FFN_SILU with a gate: the weighted sum over the slots of x [n_in, 1, n_tok] through
+// the experts ids [n_slot, n_tok], with weights w [1, n_slot, n_tok]; slots with id -1 or of a zero expert give zero rows
+static ggml_tensor * llama_moe_host_experts(ggml_context * ctx, ggml_tensor * const pool[4], ggml_tensor * x, ggml_tensor * ids, ggml_tensor * w) {
+    ggml_tensor * up      = pool[0];
+    ggml_tensor * gate    = pool[1];
+    ggml_tensor * down    = pool[2];
+    ggml_tensor * gate_up = pool[3];
+
+    const int64_t n_slot = ids->ne[0];
+    const int64_t n_tok  = ids->ne[1];
+    const int64_t n_out  = down->ne[1];
+
+    ggml_tensor * act;
+    if (gate_up) {
+        ggml_tensor * gu = ggml_mul_mat_id(ctx, gate_up, x, ids); // [2*n_ff, n_slot, n_tok]
+        const int64_t n_ff = gu->ne[0] / 2;
+        ggml_tensor * g = ggml_view_3d(ctx, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], 0);
+        ggml_tensor * u = ggml_view_3d(ctx, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], n_ff*gu->nb[0]);
+        act = ggml_swiglu_split(ctx, g, u);
+    } else {
+        act = ggml_swiglu_split(ctx, ggml_mul_mat_id(ctx, gate, x, ids), ggml_mul_mat_id(ctx, up, x, ids));
+    }
+    ggml_tensor * experts = ggml_mul(ctx, ggml_mul_mat_id(ctx, down, act, ids), w); // [n_out, n_slot, n_tok]
+
+    ggml_tensor * sum = ggml_view_2d(ctx, experts, n_out, n_tok, experts->nb[2], 0);
+    for (int64_t i = 1; i < n_slot; ++i) {
+        sum = ggml_add(ctx, sum, ggml_view_2d(ctx, experts, n_out, n_tok, experts->nb[2], i*experts->nb[1]));
+    }
+    return sum;
+}
+
+ggml_cgraph * llama_moe_host::graph(int32_t il, int32_t n_tok) {
+    const auto key = std::make_pair(il, n_tok);
+    if (auto it = graphs.find(key); it != graphs.end()) {
+        return it->second.second;
+    }
+
+    const auto & s = slots[il];
+
+    const int64_t n_slot = n_used[il];
+    const int64_t n_in   = (src[il][3] ? src[il][3] : src[il][0])->ne[0];
+    const int64_t n_out  = src[il][2]->ne[1];
+    const size_t  n_node = 2*n_slot + 16;
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ n_node*ggml_tensor_overhead() + ggml_graph_overhead_custom(n_node, false),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr(ggml_init(params));
+    ggml_context * ctx = ctx_ptr.get();
+
+    // the inputs and the output are the pinned buffers of the layer
+    ggml_tensor * x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_in, 1, n_tok);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_slot, n_tok);
+    ggml_tensor * w   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_slot, n_tok);
+    ggml_tensor * out = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_out, n_tok);
+    ggml_backend_tensor_alloc(buf.get(), x,   s.x);
+    ggml_backend_tensor_alloc(buf.get(), ids, s.ids);
+    ggml_backend_tensor_alloc(buf.get(), w,   s.w);
+    ggml_backend_tensor_alloc(buf.get(), out, s.out);
+
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, n_node, false);
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, llama_moe_host_experts(ctx, src[il].data(), x, ids, w), out));
+
+    if (!ggml_gallocr_alloc_graph(galloc, gf)) {
+        return nullptr;
+    }
+    // a larger buffer replaced the old one, which the graphs built so far still point into
+    const size_t size = ggml_gallocr_get_buffer_size(galloc, 0);
+    if (size != galloc_size) {
+        graphs.clear();
+        galloc_size = size;
+    }
+
+    graphs[key] = std::make_pair(std::move(ctx_ptr), gf);
+
+    return gf;
+}
+
+llama_moe_host::tier::graph * llama_moe_host::tier_graph(int32_t il, int32_t n_tok) {
+    const auto & tl = tier_layers[il];
+    tier & t = *tiers[tl.tier];
+
+    const auto key = std::make_pair(il, n_tok);
+    if (auto it = t.graphs.find(key); it != t.graphs.end()) {
+        return &it->second;
+    }
+
+    const int64_t n_slot  = n_used[il];
+    const int64_t n_in    = (tl.pool[3] ? tl.pool[3] : tl.pool[0])->ne[0];
+    const int64_t n_out   = tl.pool[2]->ne[1];
+    const int64_t n_dup   = tl.n_batch_dup;
+    const int64_t n_chunk = (n_tok + n_dup - 1) / n_dup;
+    const size_t  n_node  = n_chunk*(2*n_slot + 24) + 8;
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ n_node*ggml_tensor_overhead() + ggml_graph_overhead_custom(n_node, false),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    tier::graph g;
+    g.ctx.reset(ggml_init(params));
+    ggml_context * ctx = g.ctx.get();
+
+    // the inputs and the output are the device staging of the tier
+    g.x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_in, 1, n_tok);
+    g.ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_slot, n_tok);
+    g.w   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_slot, n_tok);
+    g.out = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_out, n_tok);
+    ggml_backend_tensor_alloc(t.buf.get(), g.x,   t.x->data);
+    ggml_backend_tensor_alloc(t.buf.get(), g.ids, t.ids->data);
+    ggml_backend_tensor_alloc(t.buf.get(), g.w,   t.w->data);
+    ggml_backend_tensor_alloc(t.buf.get(), g.out, t.out->data);
+
+    // the zero expert repeats within a token, which the kernels allow up to n_dup tokens per call
+    g.gf = ggml_new_graph_custom(ctx, n_node, false);
+    for (int64_t t0 = 0; t0 < n_tok; t0 += n_dup) {
+        const int64_t nt = std::min(n_dup, n_tok - t0);
+        ggml_tensor * x   = ggml_view_3d(ctx, g.x,   n_in, 1,      nt, g.x->nb[1],   g.x->nb[2],   t0*g.x->nb[2]);
+        ggml_tensor * ids = ggml_view_2d(ctx, g.ids, n_slot,       nt, g.ids->nb[1],               t0*g.ids->nb[1]);
+        ggml_tensor * w   = ggml_view_3d(ctx, g.w,   1,    n_slot, nt, g.w->nb[1],   g.w->nb[2],   t0*g.w->nb[2]);
+        ggml_tensor * out = ggml_view_2d(ctx, g.out, n_out,        nt, g.out->nb[1],               t0*g.out->nb[1]);
+        ggml_build_forward_expand(g.gf, ggml_cpy(ctx, llama_moe_host_experts(ctx, tl.pool, x, ids, w), out));
+    }
+
+    if (!ggml_gallocr_alloc_graph(t.galloc, g.gf)) {
+        return nullptr;
+    }
+    const size_t size = ggml_gallocr_get_buffer_size(t.galloc, 0);
+    if (size != t.galloc_size) {
+        t.graphs.clear();
+        t.galloc_size = size;
+    }
+
+    return &(t.graphs[key] = std::move(g));
+}
+
+llama_moe_host::tier::~tier() {
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        stop = true;
+    }
+    cv.notify_all();
+    if (thread.joinable()) {
+        thread.join();
+    }
+
+    graphs.clear();
+    if (galloc) {
+        ggml_gallocr_free(galloc);
+    }
+}
+
+int32_t llama_moe_host::add_tier(ggml_backend_dev_t dev, int32_t n_layers, const int32_t * layer_ids, const int32_t * offsets, const int32_t * experts, int64_t n_expert) {
+    std::lock_guard<std::mutex> lock(compute_mutex);
+
+    const char * dev_name = ggml_backend_dev_name(dev);
+    const char * func     = __func__;
+
+    auto t = std::make_unique<tier>();
+    t->dev = dev;
+
+    std::vector<tier_layer> tls(n_layers);
+    int64_t n_in_max   = 0;
+    int64_t n_out_max  = 0;
+    int64_t n_used_max = 0;
+    for (int32_t i = 0; i < n_layers; ++i) {
+        const int32_t il = layer_ids[i];
+        auto fail = [&](const char * reason) {
+            LLAMA_LOG_ERROR("%s: %s: layer %d: %s\n", func, dev_name, il, reason);
+            return -1;
+        };
+
+        if (il < 0 || il >= (int32_t) src.size() || !src[il][2]) {
+            return fail("not a cached layer");
+        }
+        if (tier_layers[il].tier >= 0 || std::find(layer_ids, layer_ids + i, il) != layer_ids + i) {
+            return fail("the layer is in a tier already");
+        }
+        const int32_t n = offsets[i + 1] - offsets[i];
+        if (offsets[i] < 0 || n < 1 || n > n_expert) {
+            return fail("invalid expert list");
+        }
+
+        auto & tl = tls[i];
+        tl.slot.assign(n_expert, -1);
+        tl.expert.assign(experts + offsets[i], experts + offsets[i + 1]);
+        for (int32_t s = 0; s < n; ++s) {
+            const int32_t e = tl.expert[s];
+            if (e < 0 || e >= n_expert || tl.slot[e] >= 0) {
+                return fail("invalid or duplicate expert");
+            }
+            tl.slot[e] = s;
+        }
+
+        n_in_max   = std::max(n_in_max,   (src[il][3] ? src[il][3] : src[il][0])->ne[0]);
+        n_out_max  = std::max(n_out_max,  src[il][2]->ne[1]);
+        n_used_max = std::max(n_used_max, n_used[il]);
+    }
+    if (n_layers == 0) {
+        return 0;
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ (4*n_layers + 4)*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    t->ctx.reset(ggml_init(params));
+    ggml_context * ctx = t->ctx.get();
+
+    // the ops that check the device kernels, in a context of their own
+    params.mem_size = 3*ggml_tensor_overhead();
+    ggml_context_ptr ctx_op;
+
+    // per layer the tier experts, then one zero expert
+    auto * dup_max_batch_fn = (int (*)(ggml_backend_dev_t, ggml_type)) ggml_backend_reg_get_proc_address(
+            ggml_backend_dev_backend_reg(dev), "ggml_backend_mmid_dup_max_batch");
+    size_t n_bytes = 0;
+    for (int32_t i = 0; i < n_layers; ++i) {
+        const int32_t il = layer_ids[i];
+        auto & tl = tls[i];
+        const int32_t n = offsets[i + 1] - offsets[i];
+        tl.n_batch_dup = INT32_MAX;
+        for (int k = 0; k < 4; ++k) {
+            ggml_tensor * s = src[il][k];
+            if (!s) {
+                continue;
+            }
+            tl.pool[k] = ggml_new_tensor_3d(ctx, s->type, s->ne[0], s->ne[1], n + 1);
+            ggml_format_name(tl.pool[k], "%s.tier", s->name);
+            n_bytes += ggml_nbytes(tl.pool[k]);
+            tl.n_batch_dup = std::min(tl.n_batch_dup, dup_max_batch_fn ? dup_max_batch_fn(dev, s->type) : 1);
+
+            ctx_op.reset(ggml_init(params));
+            ggml_tensor * x   = ggml_new_tensor_3d(ctx_op.get(), GGML_TYPE_F32, s->ne[0], 1, 1);
+            ggml_tensor * ids = ggml_new_tensor_2d(ctx_op.get(), GGML_TYPE_I32, n_used[il], 1);
+            if (!ggml_backend_dev_supports_op(dev, ggml_mul_mat_id(ctx_op.get(), tl.pool[k], x, ids))) {
+                LLAMA_LOG_ERROR("%s: %s cannot run the experts of %s\n", func, dev_name, s->name);
+                return -2;
+            }
+        }
+        tl.n_batch_dup = std::max(tl.n_batch_dup, 1);
+    }
+
+    const int64_t n_tok_max = exec.n_tok_max;
+    t->x   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_in_max*n_tok_max);
+    t->ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_used_max*n_tok_max);
+    t->w   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_used_max*n_tok_max);
+    t->out = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_out_max*n_tok_max);
+
+    t->buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(dev)));
+    if (!t->buf) {
+        LLAMA_LOG_ERROR("%s: %s: failed to allocate %.2f MiB for the tier\n", func, dev_name, n_bytes / 1024.0 / 1024.0);
+        return -2;
+    }
+    ggml_backend_buffer_clear(t->buf.get(), 0);
+    ggml_backend_buffer_set_usage(t->buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // explicit copies of pinned buffers beat mapped access over the link
+    ggml_backend_buffer_type_t buft_host = ggml_backend_dev_host_buffer_type(dev);
+    const size_t size_ids = GGML_PAD(n_used_max*n_tok_max*sizeof(int32_t), 256);
+    t->buf_host.reset(buft_host ? ggml_backend_buft_alloc_buffer(buft_host, size_ids + n_out_max*n_tok_max*sizeof(float)) : nullptr);
+    t->backend.reset(ggml_backend_dev_init(dev, nullptr));
+    t->galloc = ggml_gallocr_new(ggml_backend_dev_buffer_type(dev));
+    if (!t->buf_host || !t->backend || !t->galloc) {
+        LLAMA_LOG_ERROR("%s: %s: failed to set up the tier stream and buffers\n", func, dev_name);
+        return -2;
+    }
+    t->ids_host = (int32_t *) ggml_backend_buffer_get_base(t->buf_host.get());
+    t->out_host = (float *) ((char *) t->ids_host + size_ids);
+
+    // instantiating a CUDA graph waits for the device to go idle, which its main stream may only do after the
+    // executor has finished the post: without graphs, a new batch size does not make the tier late
+    auto * set_graphs_fn = (void (*)(ggml_backend_t, bool)) ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(dev), "ggml_backend_set_graphs");
+    if (set_graphs_fn) {
+        set_graphs_fn(t->backend.get(), false);
+    }
+
+    for (int32_t i = 0; i < n_layers; ++i) {
+        const int32_t il = layer_ids[i];
+        for (int k = 0; k < 4; ++k) {
+            ggml_tensor * s = src[il][k];
+            if (!s) {
+                continue;
+            }
+            const size_t nb = s->nb[2];
+            for (int32_t j = 0; j < offsets[i + 1] - offsets[i]; ++j) {
+                ggml_backend_tensor_set_async(t->backend.get(), tls[i].pool[k], (const char *) s->data + experts[offsets[i] + j]*nb, j*nb, nb);
+            }
+        }
+    }
+    ggml_backend_synchronize(t->backend.get());
+
+    const int32_t it = (int32_t) tiers.size();
+    tiers.push_back(std::move(t));
+    for (int32_t i = 0; i < n_layers; ++i) {
+        tls[i].tier = it;
+        tier_layers[layer_ids[i]] = std::move(tls[i]);
+    }
+
+    // size the compute buffer for the largest batch now, so that the memory breakdown shows it, then run every
+    // kernel the tier needs once (the staging is zero, so expert 0 everywhere): loading a kernel or growing the
+    // stream's memory pool later waits for the device to go idle as well
+    tier & tr = *tiers[it];
+    std::set<std::array<int32_t, 4>> types;
+    bool ok = true;
+    for (int32_t i = 0; i < n_layers && ok; ++i) {
+        const int32_t il = layer_ids[i];
+        const auto &  tl = tier_layers[il];
+        ok = tier_graph(il, (int32_t) n_tok_max) != nullptr;
+
+        std::array<int32_t, 4> key;
+        for (int k = 0; k < 4; ++k) {
+            key[k] = tl.pool[k] ? tl.pool[k]->type : -1;
+        }
+        const bool fresh = types.insert(key).second;
+        for (int32_t n = 1; ok && fresh && n <= std::min<int64_t>(tl.n_batch_dup, n_tok_max); ++n) {
+            tier::graph * g = tier_graph(il, n);
+            ok = g && ggml_backend_graph_compute(tr.backend.get(), g->gf) == GGML_STATUS_SUCCESS;
+        }
+    }
+    tr.graphs.clear();
+    if (!ok) {
+        LLAMA_LOG_ERROR("%s: %s: failed to set up the tier compute\n", func, dev_name);
+        for (int32_t j = 0; j < n_layers; ++j) {
+            tier_layers[layer_ids[j]] = tier_layer();
+        }
+        tiers.pop_back();
+        return -2;
+    }
+    tr.thread = std::thread([this, &tr] { tier_run(tr); });
+
+    LLAMA_LOG_INFO("%s: %s: %d layers, %.2f MiB experts, %.2f MiB compute\n", func, dev_name, n_layers,
+            n_bytes / 1024.0 / 1024.0, tr.galloc_size / 1024.0 / 1024.0);
+
+    return 0;
+}
+
+// the cached path of a layer runs on its device: the selection counts and the pools are device tensors, which a
+// fallback to the CPU could not write or would copy whole
+static bool llama_moe_cache_device_ok(ggml_backend_dev_t dev, const llama_moe_cache::layer & l, int64_t n_expert, int64_t n_used) {
+    ggml_init_params params = {
+        /*.mem_size   =*/ 16*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx(ggml_init(params));
+    ggml_tensor * ids    = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, n_used, 2);
+    ggml_tensor * counts = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, n_expert);
+    ggml_tensor * map    = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 2, n_expert);
+    ggml_tensor * planes = ggml_moe_split_ids(ctx.get(), ids, map, map);
+    std::vector<ggml_tensor *> ops = { ggml_count_ids(ctx.get(), counts, ids), planes, ggml_cast(ctx.get(), planes, GGML_TYPE_I32) };
+    for (ggml_tensor * src : l.src) {
+        if (src) {
+            ggml_tensor * pool = ggml_new_tensor_3d(ctx.get(), src->type, src->ne[0], src->ne[1], l.n_slots + 1);
+            ggml_tensor * x    = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, src->ne[0], n_used, 2);
+            ops.push_back(ggml_mul_mat_id(ctx.get(), pool, x, ids));
+        }
+    }
+    for (ggml_tensor * op : ops) {
+        if (!ggml_backend_dev_supports_op(dev, op)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int32_t llama_context::moe_cache_init(int32_t n_layers, const int32_t * layer_ids, const int32_t * offsets, const int32_t * experts, const int32_t * slots) {
+    // no graph may use the old cache while it is freed, and the next decode must rebuild the graph
+    synchronize();
+    if (moe_cache) {
+        for (const auto & ln : moe_cache->loans) {
+            ggml_backend_sched_lend_stage(sched.get(), ln.backend, nullptr, 0, 0);
+        }
+    }
+    moe_cache.reset();
+    sched_need_reserve = true;
+
+    if (n_layers == 0) {
+        return 0;
+    }
+    if (n_layers < 0 || !layer_ids || !offsets || !slots) {
+        LLAMA_LOG_ERROR("%s: invalid arguments\n", __func__);
+        return -1;
+    }
+
+    const auto & hparams = model.hparams;
+    const int64_t n_expert = hparams.n_expert;
+
+    auto cache = std::make_unique<llama_moe_cache>();
+
+    const char * offload_env = getenv("GGML_OP_OFFLOAD_MIN_BATCH");
+    cache->offload_min = offload_env ? atoi(offload_env) : 32;
+    const char * freeze_env = getenv("FLUX_MOE_CACHE_FREEZE");
+    cache->frozen = freeze_env && atoi(freeze_env) != 0;
+
+    cache->graph.resize(hparams.n_layer_all);
+
+    // cached layer indices per device
+    std::map<ggml_backend_dev_t, std::vector<size_t>> dev_layers;
+    std::vector<bool> seen(hparams.n_layer_all, false);
+
+    const char * func = __func__;
+    for (int32_t i = 0; i < n_layers; ++i) {
+        const int32_t il = layer_ids[i];
+        auto fail = [&](const char * reason) {
+            LLAMA_LOG_ERROR("%s: layer %d: %s\n", func, il, reason);
+            return -1;
+        };
+
+        if (il < 0 || il >= (int32_t) hparams.n_layer() || seen[il]) {
+            return fail("invalid or duplicate layer");
+        }
+        seen[il] = true;
+
+        const auto & ly = model.layers[il];
+        if (ly.ffn_up_exps_b || ly.ffn_gate_exps_b || ly.ffn_down_exps_b || ly.ffn_gate_up_exps_b ||
+            ly.ffn_up_exps_s || ly.ffn_gate_exps_s || ly.ffn_down_exps_s) {
+            return fail("per-expert biases or scales are not supported");
+        }
+        if (!ly.ffn_down_exps || (!ly.ffn_up_exps && !ly.ffn_gate_up_exps)) {
+            return fail("no routed expert tensors");
+        }
+
+        llama_moe_cache::layer l;
+        l.il      = il;
+        l.n_slots = slots[i];
+        l.src[0]  = ly.ffn_up_exps;
+        l.src[1]  = ly.ffn_gate_exps;
+        l.src[2]  = ly.ffn_down_exps;
+        l.src[3]  = ly.ffn_gate_up_exps;
+        for (ggml_tensor * t : l.src) {
+            if (t && (!t->buffer || !ggml_backend_buffer_is_host(t->buffer) || t->ne[2] != n_expert || !ggml_is_contiguous(t))) {
+                return fail("the expert tensors must be contiguous and in host memory");
+            }
+        }
+
+        ggml_backend_dev_t dev = model.dev_layer(il);
+        if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+            return fail("the layer is not on a GPU");
+        }
+        for (const auto & backend : backends) {
+            if (ggml_backend_get_device(backend.get()) == dev) {
+                l.backend = backend.get();
+            }
+        }
+        if (!l.backend) {
+            return fail("no backend for the layer device");
+        }
+
+        if (l.n_slots > 0 && !llama_moe_cache_device_ok(dev, l, n_expert, hparams.n_expert_used(il))) {
+            return fail("the layer device cannot run the ops of the cached path");
+        }
+
+        const int32_t n_init = offsets[i + 1] - offsets[i];
+        if (n_init < 0 || (n_init > 0 && !experts) || l.n_slots <= 0 || l.n_slots < n_init || l.n_slots > n_expert) {
+            return fail("invalid slot count or expert list");
+        }
+
+        l.slot.assign(n_expert, -1);
+        l.expert.assign(l.n_slots, -1);
+        l.map_hot.resize(2*n_expert);
+        l.map_cold.resize(2*n_expert);
+        l.score.assign(n_expert, 0.0f);
+        l.acc.assign(n_expert, 0.0f);
+        for (int32_t s = 0; s < n_init; ++s) {
+            const int32_t e = experts[offsets[i] + s];
+            if (e < 0 || e >= n_expert || l.slot[e] >= 0) {
+                return fail("invalid or duplicate expert");
+            }
+            l.slot[e]   = s;
+            l.expert[s] = e;
+        }
+        for (int32_t e = 0; e < n_expert; ++e) {
+            const bool cached = l.slot[e] >= 0;
+            l.map_hot [2*e + 0] = cached ? l.slot[e] : l.n_slots;
+            l.map_hot [2*e + 1] = cached ? 0.0f : 1.0f;
+            l.map_cold[2*e + 0] = e;
+            l.map_cold[2*e + 1] = cached ? 1.0f : 0.0f;
+        }
+
+        dev_layers[dev].push_back(cache->layers.size());
+        cache->layers.push_back(std::move(l));
+    }
+
+    for (const auto & [dev, ids] : dev_layers) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ 7*ids.size()*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context * ctx = ggml_init(params);
+        if (!ctx) {
+            LLAMA_LOG_ERROR("%s: failed to create the cache context\n", __func__);
+            return -1;
+        }
+        cache->ctxs.emplace_back(ctx);
+
+        // the hot part repeats experts within a token, which the device kernels allow up to some batch size
+        auto * dup_max_batch_fn = (int (*)(ggml_backend_dev_t, ggml_type)) ggml_backend_reg_get_proc_address(
+                ggml_backend_dev_backend_reg(dev), "ggml_backend_mmid_dup_max_batch");
+        int32_t n_dup_min = INT32_MAX;
+
+        // the maps first: a lent region at the end of the buffer holds only pools
+        for (size_t id : ids) {
+            auto & l = cache->layers[id];
+            auto & g = cache->graph[l.il];
+            g.map_hot  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2, n_expert);
+            g.map_cold = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2, n_expert);
+            g.counts   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_expert);
+            ggml_format_name(g.map_hot,  "blk.%d.ffn_moe_map_hot.cache",  l.il);
+            ggml_format_name(g.map_cold, "blk.%d.ffn_moe_map_cold.cache", l.il);
+            ggml_format_name(g.counts,   "blk.%d.ffn_moe_counts.cache",   l.il);
+        }
+        for (size_t id : ids) {
+            auto & l = cache->layers[id];
+            auto & g = cache->graph[l.il];
+            ggml_tensor ** pools[4] = { &g.up_exps, &g.gate_exps, &g.down_exps, &g.gate_up_exps };
+            g.n_batch_dup = INT32_MAX;
+            for (int k = 0; k < 4; ++k) {
+                if (l.src[k]) {
+                    // the slots, then one zero expert
+                    l.pool[k] = ggml_new_tensor_3d(ctx, l.src[k]->type, l.src[k]->ne[0], l.src[k]->ne[1], l.n_slots + 1);
+                    ggml_format_name(l.pool[k], "%s.cache", l.src[k]->name);
+                    GGML_ASSERT(l.pool[k]->nb[2] == l.src[k]->nb[2]);
+                    *pools[k] = l.pool[k];
+                    g.n_batch_dup = std::min(g.n_batch_dup, dup_max_batch_fn ? dup_max_batch_fn(dev, l.src[k]->type) : 1);
+                }
+            }
+            g.n_batch_dup = std::max(g.n_batch_dup, 1);
+            g.offload_min = cache->offload_min;
+            n_dup_min = std::min(n_dup_min, g.n_batch_dup);
+        }
+
+        // the staging targets of the device move into the pools: free them before the pools take their memory (if
+        // the pools cannot hold them, the next reserve allocates them again)
+        ggml_backend_t backend = cache->layers[ids[0]].backend;
+        const size_t stage_size = ggml_backend_sched_get_stage_size(sched.get(), backend);
+        if (stage_size > 0) {
+            ggml_backend_sched_lend_stage(sched.get(), backend, nullptr, 0, 0);
+        }
+
+        // measure the host link before the pools fill the device, rather than in the first update round of a decode
+        cache->round_bytes(dev, 0);
+
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(dev));
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate the expert cache on %s\n", __func__, ggml_backend_dev_name(dev));
+            return -1;
+        }
+        cache->bufs.emplace_back(buf);
+        ggml_backend_buffer_clear(buf, 0);
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+        ggml_backend_t backend_copy = ggml_backend_dev_init(dev, nullptr);
+        if (!backend_copy) {
+            LLAMA_LOG_ERROR("%s: failed to initialize a copy backend on %s\n", __func__, ggml_backend_dev_name(dev));
+            return -1;
+        }
+        cache->backends_copy.emplace_back(backend_copy);
+
+        for (size_t id : ids) {
+            auto & l = cache->layers[id];
+            l.backend_copy = backend_copy;
+            for (int32_t s = 0; s < l.n_slots; ++s) {
+                const int32_t e = l.expert[s];
+                for (int k = 0; k < 4 && e >= 0; ++k) {
+                    if (l.src[k]) {
+                        const size_t nb = l.src[k]->nb[2];
+                        ggml_backend_tensor_set_async(backend_copy, l.pool[k], (const char *) l.src[k]->data + e*nb, s*nb, nb);
+                    }
+                }
+            }
+            const auto & g = cache->graph[l.il];
+            ggml_backend_tensor_set(g.map_hot,  l.map_hot.data(),  0, ggml_nbytes(g.map_hot));
+            ggml_backend_tensor_set(g.map_cold, l.map_cold.data(), 0, ggml_nbytes(g.map_cold));
+        }
+        ggml_backend_synchronize(backend_copy);
+
+        cache->backends.push_back(cache->layers[ids[0]].backend);
+
+        // the region at the end of the pools, when they can hold it
+        const size_t align  = ggml_backend_buft_get_alignment(ggml_backend_dev_buffer_type(dev));
+        const char * base   = (const char *) ggml_backend_buffer_get_base(buf);
+        const size_t size   = ggml_backend_buffer_get_size(buf);
+        size_t pools_offset = size;
+        for (size_t id : ids) {
+            for (ggml_tensor * t : cache->layers[id].pool) {
+                if (t) {
+                    pools_offset = std::min(pools_offset, (size_t) ((const char *) t->data - base));
+                }
+            }
+        }
+        if (stage_size > 0 && stage_size <= size && (size - stage_size) / align * align >= pools_offset) {
+            llama_moe_cache::loan ln;
+            ln.backend = backend;
+            ln.buf     = buf;
+            ln.offset  = (size - stage_size) / align * align;
+            ln.size    = stage_size;
+            for (size_t id : ids) {
+                const auto & l = cache->layers[id];
+                for (int32_t sl = 0; sl <= l.n_slots; ++sl) {
+                    bool in = false;
+                    for (ggml_tensor * t : l.pool) {
+                        if (t) {
+                            const size_t b0 = (const char *) t->data - base + sl*t->nb[2];
+                            in = in || (b0 < ln.offset + ln.size && b0 + t->nb[2] > ln.offset);
+                        }
+                    }
+                    if (in) {
+                        ln.slots.emplace_back((int32_t) id, sl);
+                    }
+                }
+            }
+            LLAMA_LOG_INFO("%s: %s: the last %.2f MiB of the pools (%zu slots) stage the op-offloaded expert weights\n", __func__,
+                    ggml_backend_dev_name(dev), ln.size / 1024.0 / 1024.0, ln.slots.size());
+            cache->loans.push_back(std::move(ln));
+        }
+
+        LLAMA_LOG_INFO("%s: %s: %zu cached layers, %.2f MiB, hot part in chunks of %d+ tokens\n", __func__, ggml_backend_dev_name(dev), ids.size(),
+                ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0, n_dup_min);
+    }
+
+    // the host experts overlap with the GPU unless FLUX_MOE_HOST_SYNC=1; staging covers the batches below the op-offload batch
+    const char * host_sync_env = getenv("FLUX_MOE_HOST_SYNC");
+    if (!(host_sync_env && atoi(host_sync_env) != 0)) {
+        auto host = std::make_unique<llama_moe_host>();
+        if (host->init(*cache, hparams, cparams.n_threads, cache->offload_min - 1)) {
+            for (const auto & l : cache->layers) {
+                cache->graph[l.il].host = &host->exec;
+            }
+            cache->host = std::move(host);
+        } else {
+            LLAMA_LOG_WARN("%s: cannot overlap the host experts with the GPU, they run synchronously\n", __func__);
+        }
+    }
+
+    for (size_t i = 0; i < cache->layers.size(); ++i) {
+        for (int k = 0; k < 4; ++k) {
+            if (cache->layers[i].src[k]) {
+                cache->src_index[cache->layers[i].src[k]] = { (int32_t) i, k };
+            }
+        }
+    }
+
+    cache->worker = std::thread([c = cache.get()] { c->work(); });
+
+    // page-lock the host expert ranges in the background, in address order (about layer order; the cache has no
+    // per-layer heat yet): pageable uploads run at less than half the DMA rate, and pinning them all up front would
+    // delay the first token by many seconds
+    ggml_backend_reg_t reg_dev = ggml_backend_dev_backend_reg(ggml_backend_get_device(cache->layers[0].backend));
+    cache->pin_fn   = (bool (*)(void *, size_t)) ggml_backend_reg_get_proc_address(reg_dev, "ggml_backend_pin_host_buffer");
+    cache->unpin_fn = (void (*)(void *))         ggml_backend_reg_get_proc_address(reg_dev, "ggml_backend_unpin_host_buffer");
+    if (!cache->pin_fn || !cache->unpin_fn) {
+        if (cache->host) {
+            cache->host->tier_ok = true;
+        }
+    } else {
+        const uintptr_t page = 4096;
+        std::vector<std::pair<uintptr_t, uintptr_t>> ranges;
+        for (const auto & l : cache->layers) {
+            for (ggml_tensor * t : l.src) {
+                if (t) {
+                    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(t->buffer);
+                    const uintptr_t end  = base + ggml_backend_buffer_get_size(t->buffer);
+                    const uintptr_t b    = (uintptr_t) t->data / page * page;
+                    const uintptr_t e    = ((uintptr_t) t->data + ggml_nbytes(t) + page - 1) / page * page;
+                    ranges.emplace_back(std::max(b, base), std::min(e, end));
+                }
+            }
+        }
+        std::sort(ranges.begin(), ranges.end());
+        for (const auto & [b, e] : ranges) {
+            if (!cache->pin_ranges.empty() && b <= (uintptr_t) cache->pin_ranges.back().first + cache->pin_ranges.back().second) {
+                auto & last = cache->pin_ranges.back();
+                last.second = std::max(last.second, (size_t) (e - (uintptr_t) last.first));
+            } else {
+                cache->pin_ranges.emplace_back((void *) b, (size_t) (e - b));
+            }
+        }
+        // page-locked pages stay resident: lock at most what the OS can hand out, minus a margin for the rest of the
+        // system, and nothing when the experts do not even fit (the weights then stream from storage)
+        size_t n_ranges = 0;
+        for (const auto & r : cache->pin_ranges) {
+            n_ranges += r.second;
+        }
+        size_t mem_avail = 0, mem_total = 0;
+        size_t budget = 0;
+        if (llama_host_memory(&mem_avail, &mem_total) && n_ranges <= mem_avail) {
+            const size_t margin = std::max<size_t>(4ull << 30, mem_total / 10);
+            budget = mem_avail > margin ? mem_avail - margin : 0;
+        }
+        cache->pin_worker = std::thread([c = cache.get(), budget] {
+            const int64_t t0 = ggml_time_us();
+            size_t n_bytes = 0;
+            for (const auto & [p, n] : c->pin_ranges) {
+                if (c->pin_stop || n_bytes + n > budget) {
+                    break;
+                }
+                if (c->pin_fn(p, n)) {
+                    c->pinned.push_back(p);
+                    n_bytes += n;
+                }
+            }
+            if (c->host) {
+                c->host->tier_ok = true;
+            }
+            LLAMA_LOG_INFO("moe cache: page-locked %.2f GiB of host experts in %zu of %zu ranges (budget %.2f GiB), %.1f s\n",
+                    n_bytes / 1024.0 / 1024.0 / 1024.0, c->pinned.size(), c->pin_ranges.size(), budget / 1024.0 / 1024.0 / 1024.0,
+                    (ggml_time_us() - t0) / 1e6);
+        });
+    }
+
+    moe_cache = std::move(cache);
+
+    // lent only now: a failed init frees the pools, and the next reserve allocates the targets again
+    sched_setup();
+
+    LLAMA_LOG_INFO("%s: %d cached layers%s\n", __func__, n_layers, moe_cache->frozen ? ", frozen" : "");
+
+    return 0;
+}
+
+int32_t llama_context::moe_cache_tier(const char * device, int32_t n_layers, const int32_t * layer_ids, const int32_t * offsets, const int32_t * experts) {
+    if (!moe_cache) {
+        LLAMA_LOG_ERROR("%s: the context has no expert cache\n", __func__);
+        return -1;
+    }
+    if (!moe_cache->host || moe_cache->host_off) {
+        LLAMA_LOG_WARN("%s: the host experts run synchronously, so the tier is not used\n", __func__);
+        return 0;
+    }
+    ggml_backend_dev_t dev = device ? ggml_backend_dev_by_name(device) : nullptr;
+    if (!dev || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+        LLAMA_LOG_ERROR("%s: %s is not a GPU device\n", __func__, device ? device : "(null)");
+        return -1;
+    }
+    if (n_layers < 0 || (n_layers > 0 && (!layer_ids || !offsets || !experts))) {
+        LLAMA_LOG_ERROR("%s: invalid arguments\n", __func__);
+        return -1;
+    }
+
+    // no graph may post while the tier is added
+    synchronize();
+
+    moe_cache->round_bytes(dev, 0);
+
+    return moe_cache->host->add_tier(dev, n_layers, layer_ids, offsets, experts, model.hparams.n_expert);
+}
+
+void llama_context::moe_cache_wait_pinned() {
+    if (moe_cache && moe_cache->pin_worker.joinable()) {
+        moe_cache->pin_worker.join();
+    }
+}
+
+void llama_context::moe_cache_freeze(bool frozen) {
+    if (moe_cache) {
+        moe_cache->frozen = frozen;
+    }
+}
+
+void llama_context::moe_cache_stats(int64_t * hits, int64_t * lookups, int64_t * swaps) {
+    if (moe_cache) {
+        moe_cache->flush();
+    }
+    if (hits) {
+        *hits = moe_cache ? moe_cache->hits : 0;
+    }
+    if (lookups) {
+        *lookups = moe_cache ? moe_cache->lookups : 0;
+    }
+    if (swaps) {
+        *swaps = moe_cache ? moe_cache->swaps : 0;
+    }
+}
+
+//
+// interface implementation
+//
+
+llama_context_params llama_context_default_params() {
+    llama_context_params result = {
+        /*.n_ctx                       =*/ 512,
+        /*.n_batch                     =*/ 2048,
+        /*.n_ubatch                    =*/ 512,
+        /*.n_seq_max                   =*/ 1,
+        /*.n_rs_seq                    =*/ 0,
+        /*.n_outputs_max               =*/ 0,
+        /*.n_outputs_max_per_seq       =*/ 1,
+        /*.n_threads                   =*/ GGML_DEFAULT_N_THREADS, // TODO: better default
