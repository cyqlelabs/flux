+    auto * ctx = new ggml_backend_cuda_buffer_context(type_ctx->device, (void *) addr);
+    ctx->paged.reset(new ggml_cuda_pages(capacity));
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_buffer_interface, ctx, capacity);
