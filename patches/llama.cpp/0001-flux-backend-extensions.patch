+#include "../src/llama-kv-cache.h"
+#include "../src/llama-memory-hybrid-idx.h"
+#include "../src/llama-model.h"
+#include "../src/llama-io.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+
+struct cache_model : llama_model {
+    cache_model() : llama_model(llama_model_default_params()) {
+        arch = LLM_ARCH_LLAMA;
+        hparams.n_layer_all = 2;
+        hparams.n_embd = 64;
+        hparams.n_embd_head_k_full = 64;
+        hparams.n_embd_head_v_full = 64;
+        for (uint32_t i = 0; i < 2; ++i) {
+            hparams.n_head_arr[i] = 1;
+            hparams.n_head_kv_arr[i] = 1;
+        }
+    }
+    void load_stats(llama_model_loader &) override {}
+    void load_hparams(llama_model_loader &) override {}
+    void load_vocab(llama_model_loader &) override {}
+    bool load_tensors(llama_model_loader &) override { return false; }
+    void load_arch_hparams(llama_model_loader &) override {}
+    void load_arch_tensors(llama_model_loader &) override {}
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params &) const override { return nullptr; }
+};
+
+struct state_writer : llama_io_write_i {
+    std::vector<uint8_t> bytes;
+    void write(const void * data, size_t size) override {
+        const auto * p = (const uint8_t *) data;
+        bytes.insert(bytes.end(), p, p + size);
+    }
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        const size_t old = bytes.size();
+        bytes.resize(old + size);
+        ggml_backend_tensor_get(tensor, bytes.data() + old, offset, size);
+    }
+    size_t n_bytes() override { return bytes.size(); }
+};
+
+struct state_reader : llama_io_read_i {
+    const std::vector<uint8_t> & bytes;
+    size_t cursor = 0;
+    explicit state_reader(const std::vector<uint8_t> & bytes) : bytes(bytes) {}
+    void read(void * data, size_t size) override {
+        if (size > bytes.size() - cursor) {
+            throw std::runtime_error("truncated test state");
+        }
+        memcpy(data, bytes.data() + cursor, size);
+        cursor += size;
+    }
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        if (size > bytes.size() - cursor) {
+            throw std::runtime_error("truncated test tensor");
+        }
+        ggml_backend_tensor_set(tensor, bytes.data() + cursor, offset, size);
+        cursor += size;
+    }
+    size_t n_bytes() override { return cursor; }
+};
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static void run(bool keys_only) {
+    cache_model model;
+    llama_kv_cache kv(model, model.hparams, GGML_TYPE_F16, GGML_TYPE_F16,
+            false, false, false, 40001, 2, 1, 0, LLAMA_SWA_TYPE_NONE,
+            nullptr, nullptr, nullptr, nullptr, "", keys_only, true);
+    auto * k = kv.get_k_storage(0);
+    ggml_backend_page_info before{};
+    if (!ggml_backend_buffer_page_info(k->buffer, &before)) {
+        return; // non-Linux CPU backends allocate their ordinary buffer
+    }
+    require(kv.get_size() == 40001, "padding changed the logical context");
+    require(k->nb[2] % before.page_size == 0, "stream is not page aligned");
+    require(before.host_bytes == 0 && before.device_bytes == 0, "constructor touched cache pages");
+    size_t committed = 0;
+    size_t capacity = 0;
+    for (const auto & entry : kv.memory_breakdown()) {
+        committed += entry.second;
+    }
+    for (const auto & entry : kv.memory_capacity()) {
+        capacity += entry.second;
+    }
+    require(committed == 0 && capacity == before.capacity, "committed bytes and capacity were conflated");
+    const auto full = kv.page_requirements(UINT32_MAX);
+    const auto floor = kv.page_requirements(256);
+    size_t required = 0, floor_bytes = 0;
+    for (const auto & entry : full) {
+        require(entry.first.second == (keys_only ? llama_kv_page_class::full_read : llama_kv_page_class::dense_attention),
+                "KV placement class is wrong");
+        required += entry.second;
+        floor_bytes += floor.at(entry.first);
+    }
+    require(required == capacity && floor_bytes == (keys_only ? 4 : 8)*before.page_size,
+            "page-rounded capacity and floor are wrong");
+    cache_model dry_model;
+    dry_model.hparams.no_alloc = true;
+    llama_kv_cache dry(dry_model, dry_model.hparams, GGML_TYPE_F16, GGML_TYPE_F16,
+            false, false, false, 40001, 2, 1, 0, LLAMA_SWA_TYPE_NONE,
+            nullptr, nullptr, nullptr, nullptr, "", keys_only, true);
+    require(dry.page_requirements(UINT32_MAX) == full && dry.page_requirements(256) == floor,
+            "dry-run dummy buffers lost their page requirements");
+    kv.init_full();
+    ggml_backend_page_info info{};
+    require(ggml_backend_buffer_page_info(k->buffer, &info) && info.host_bytes == 0, "size reservation committed pages");
+
+    llama_kv_cache::slot_info slot;
+    slot.s0 = slot.s1 = 0;
+    slot.strm = {0};
+    slot.idxs = {{0, 32768}};
+    llama_pos positions[] = {0, 1};
+    int32_t counts[] = {1, 1};
+    llama_seq_id seq = 0;
+    llama_seq_id * seqs[] = {&seq, &seq};
+    llama_ubatch batch{};
+    batch.n_tokens = 2;
+    batch.n_pos = 1;
+    batch.pos = positions;
+    batch.n_seq_id = counts;
+    batch.seq_id = seqs;
+    require(kv.commit(slot, 33024), "prefix commit failed");
+    kv.apply_ubatch(slot, batch);
+    std::vector<uint8_t> row(k->nb[1], 42);
+    ggml_backend_tensor_set(k, row.data(), 32768*k->nb[1], row.size());
+    require(ggml_backend_buffer_page_info(k->buffer, &info) &&
+            info.host_bytes == (keys_only ? 6 : 12)*before.page_size, "commit did not track the active stream");
+
+    state_writer state;
+    kv.state_write(state, 0);
+    state_reader reader(state.bytes);
+    kv.state_read(reader, 1);
+    require(kv.seq_pos_max(1) == 1 && reader.n_bytes() == state.bytes.size(), "restore lost cache cells");
+    std::vector<uint8_t> restored(row.size());
+    ggml_backend_tensor_get(k, restored.data(), k->nb[2] + k->nb[1], restored.size());
+    require(restored == row, "restore lost data across stream padding");
+    require(ggml_backend_buffer_page_info(k->buffer, &info), "restored page accounting unavailable");
+
+    require(kv.seq_rm(0, 1, -1), "tail removal failed");
+    kv.release_unused_pages();
+    ggml_backend_page_info trimmed{};
+    require(ggml_backend_buffer_page_info(k->buffer, &trimmed) &&
+            trimmed.host_bytes == info.host_bytes - (keys_only ? 2 : 4)*before.page_size,
+            "tail release did not return pages");
+    require(kv.seq_rm(1, -1, -1), "stream removal failed");
+    kv.release_unused_pages();
+    kv.clear(true);
+    require(ggml_backend_buffer_page_info(k->buffer, &info) && info.host_bytes == 0 && info.device_bytes == 0,
+            "clear retained physical pages");
+    require(kv.commit(slot, 256), "recommit failed");
+    ggml_backend_tensor_get(k, restored.data(), 0, restored.size());
+    require(std::all_of(restored.begin(), restored.end(), [](uint8_t x) { return x == 0; }), "released page was not zeroed");
+}
+
+static void run_pooled() {
+    cache_model model;
+    model.hparams.indexer_head_size = 64;
+    model.hparams.dsv4_compress_ratios[0] = 4;
+    model.hparams.dsv4_compress_ratios[1] = 4;
+    llama_memory_hybrid_idx mem(model, GGML_TYPE_F16, GGML_TYPE_F16, false, 64, 1, 0,
+            LLAMA_SWA_TYPE_NONE, GGML_TYPE_F32, GGML_TYPE_F32, 1, 2, 0, false, false,
+            [](int) { return true; }, [](int) { return false; }, [](int) { return true; }, false, true);
+    require(mem.get_pooled(0) && mem.get_pooled(0)->ne[1] == 16, "pooled key capacity is wrong");
+    for (llama_seq_id seq : {0, 1}) {
+        auto & cells = const_cast<llama_kv_cells &>(mem.get_mem_idx()->get_cells(seq));
+        for (uint32_t cell = 0; cell < 8; ++cell) {
+            cells.pos_set(cell, cell);
+            cells.seq_add(cell, seq);
+        }
+    }
+    llama_pos pos = 7;
+    int32_t count = 1;
+    llama_seq_id seq = 0;
+    llama_seq_id * seqs[] = {&seq};
+    llama_ubatch batch{};
+    batch.n_tokens = 1;
+    batch.n_pos = 1;
+    batch.pos = &pos;
+    batch.n_seq_id = &count;
+    batch.seq_id = seqs;
+    auto fill = [&]() {
+        const uint32_t dirty = mem.pooled_dirty(&batch, 4, 64, 1);
+        ggml_init_params params{16*ggml_tensor_overhead(), nullptr, true};
+        ggml_context_ptr ctx(ggml_init(params));
+        auto * cell_blk = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 64, 1);
+        auto * members = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 64, 1);
+        auto * positions = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 64);
+        auto * bias = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, 16, 1, 1);
+        auto * dirty_cells = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 4*dirty, 1);
+        auto * dirty_pos = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 4*dirty);
+        auto * dirty_idxs = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, dirty);
+        ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_cpu_buffer_type()));
+        mem.set_input_pooled(cell_blk, members, positions, bias, dirty_cells, dirty_pos, dirty_idxs, &batch, 4, true);
+        std::vector<int32_t> indices(dirty);
+        ggml_backend_tensor_get(dirty_idxs, indices.data(), 0, indices.size()*sizeof(int32_t));
+        return indices;
+    };
+    require(fill().size() == 16, "initial pooled keys were not initialized");
+    mem.pooled_changed();
+    require(fill() == std::vector<int32_t>{2}, "finished blocks were recomputed");
+    seq = 1;
+    const auto other = fill();
+    require(other.size() == 16 && other.front() == 16, "pooled metadata reused the wrong stream");
+    mem.pooled_changed();
+    require(fill() == std::vector<int32_t>{18}, "second stream finished blocks were recomputed");
+    seq = 0;
+    require(mem.get_mem_idx()->seq_rm(0, 6, -1), "pooled tail removal failed");
+    mem.pooled_changed();
+    const auto removed = fill();
+    require(std::find(removed.begin(), removed.end(), 1) != removed.end(), "tail removal retained a finished key");
+    require(std::find(removed.begin(), removed.end(), 0) == removed.end(), "tail removal invalidated an earlier block");
+    require(mem.qsa_contiguous(&batch, 1), "contiguous prefix was rejected");
+    require(mem.get_mem_idx()->seq_rm(0, 2, 3), "middle cell removal failed");
+    require(!mem.qsa_contiguous(&batch, 1), "block selection accepted a hole in the cache");
+    mem.clear(true);
+    require(fill().size() == 16, "clear retained finished pooled keys");
+}
+
+int main() {
+    llama_backend_init();
+    try {
+        run(false);
+        run(true);
+        run_pooled();
+    } catch (const std::exception & error) {
+        fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    llama_backend_free();
+    return 0;
+}
