+// ggml_compute_forward_hc_gated_mean
+
+void ggml_compute_forward_hc_gated_mean(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * gate = dst->src[1];
+
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const int64_t nr     = n_embd * x->ne[2];
+    const float   inv    = 1.0f / (float) hc;
+
+    const float * xd = (const float *) x->data;
+    const float * gd = (const float *) gate->data;
+    float       * dd = (float *) dst->data;
+
+    const int64_t dr  = (nr + params->nth - 1) / params->nth;
+    const int64_t ir0 = dr * params->ith;
+    const int64_t ir1 = MIN(ir0 + dr, nr);
+
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t i0 = ir % n_embd;
+        const int64_t it = ir / n_embd;
+        const int64_t base = it * hc * n_embd + i0;
+
+        float sum = 0.0f;
+        for (int64_t ih = 0; ih < hc; ++ih) {
+            sum += xd[base + ih * n_embd] * gd[base + ih * n_embd];
+        }
+        dd[ir] = sum * inv;
+    }
+}
+
+// ggml_compute_forward_hc_inject
+
+void ggml_compute_forward_hc_inject(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * residual = dst->src[0];
+    const ggml_tensor * x        = dst->src[1];
+    const ggml_tensor * inject   = dst->src[2];
+
+    const int64_t n_embd = residual->ne[0];
+    const int64_t hc     = residual->ne[1];
+    const int64_t nr     = hc * residual->ne[2];
+    const float   scale  = ggml_get_op_params_f32(dst, 0);
+
+    const float * rd = (const float *) residual->data;
+    const float * xd = (const float *) x->data;
+    const float * jd = (const float *) inject->data;
+    float       * dd = (float *) dst->data;
+
+    const int64_t dr  = (nr + params->nth - 1) / params->nth;
+    const int64_t ir0 = dr * params->ith;
+    const int64_t ir1 = MIN(ir0 + dr, nr);
+
+    // one (stream, token) row per iteration
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t it = ir / hc;
+        const float   w  = 2.0f / (1.0f + expf(-jd[ir] * scale));
+        const float * xr = xd + it * n_embd;
+        const float * rr = rd + ir * n_embd;
+        float       * dr_ = dd + ir * n_embd;
+        for (int64_t i0 = 0; i0 < n_embd; ++i0) {
+            dr_[i0] = rr[i0] + xr[i0] * w;
+        }
+    }
+}
+
+// ggml_compute_forward_hc_mix
+
+void ggml_compute_forward_hc_mix(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x        = dst->src[0];
+    const ggml_tensor * w_norm   = dst->src[1];
+    const ggml_tensor * w_down   = dst->src[2];
+    const ggml_tensor * w_up     = dst->src[3];
+    const ggml_tensor * w_inject = dst->src[4];
+
+    // a reference for the fused GPU kernels: one thread computes it all
+    if (params->ith != 0) {
+        return;
+    }
+    GGML_ASSERT(w_down->type == GGML_TYPE_BF16);
+
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const int64_t n_t    = x->ne[2];
+    const int64_t hc_dim = hc*n_embd;
+    const int64_t n_lr   = w_down->ne[1];
+    const float   eps    = ggml_get_op_params_f32(dst, 0);
+
+    auto row = [](const ggml_tensor * w, int64_t r) { return (const ggml_bf16_t *) ((const char *) w->data + r*w->nb[1]); };
+
+    std::vector<float> xn(hc_dim), lo(n_lr), gate(hc_dim);
+    float * mixed  = (float *) dst->data;
+    float * inject = mixed + n_embd*n_t;
+
+    for (int64_t t = 0; t < n_t; ++t) {
+        const float * xt = (const float *) x->data + t*hc_dim;
+        for (int64_t h = 0; h < hc; ++h) {
+            float sum = 0.0f;
+            for (int64_t i = 0; i < n_embd; ++i) {
+                sum += xt[h*n_embd + i]*xt[h*n_embd + i];
+            }
+            const float rs = 1.0f/sqrtf(sum/n_embd + eps);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                xn[h*n_embd + i] = (rs*xt[h*n_embd + i])*((const float *) w_norm->data)[h*n_embd + i];
+            }
+        }
+        for (int64_t k = 0; k < n_lr; ++k) {
+            const ggml_bf16_t * w = row(w_down, k);
+            float sum = 0.0f;
+            for (int64_t c = 0; c < hc_dim; ++c) {
+                sum += GGML_BF16_TO_FP32(w[c])*xn[c];
+            }
+            sum *= 1.0f/hc;
+            lo[k] = sum/(1.0f + expf(-sum));
+        }
+        for (int64_t c = 0; c < hc_dim; ++c) {
+            const ggml_bf16_t * w = row(w_up, c);
+            float sum = 0.0f;
+            for (int64_t k = 0; k < n_lr; ++k) {
+                sum += GGML_BF16_TO_FP32(w[k])*lo[k];
+            }
+            gate[c] = 1.0f/(1.0f + expf(-sum));
+        }
+        for (int64_t i = 0; i < n_embd; ++i) {
+            float sum = 0.0f;
+            for (int64_t h = 0; h < hc; ++h) {
+                sum += xn[h*n_embd + i]*gate[h*n_embd + i];
+            }
+            mixed[t*n_embd + i] = sum*(1.0f/hc);
+        }
+        for (int64_t j = 0; w_inject && j < hc; ++j) {
+            const ggml_bf16_t * w = row(w_inject, j);
+            float sum = 0.0f;
+            for (int64_t c = 0; c < hc_dim; ++c) {
+                sum += GGML_BF16_TO_FP32(w[c])*xn[c];
+            }
+            inject[t*hc + j] = sum;
+        }
+    }
+}
+
+// ggml_compute_forward_ssm_conv_hist
+
+void ggml_compute_forward_ssm_conv_hist(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * hist = dst->src[0];
+    const ggml_tensor * x    = dst->src[1];
+    const ggml_tensor * c    = dst->src[2];
+
+    const int64_t d_conv  = c->ne[0];
+    const int64_t d_inner = c->ne[1];
+    const int64_t n_hist  = d_conv - 1;
+    const int64_t n_t     = x->ne[1];
+    const int64_t n_s     = x->ne[2];
+    const int     n_snap  = ggml_get_op_params_i32(dst, 0);
+    const bool    silu    = ggml_get_op_params_i32(dst, 1) != 0;
+
+    // channels per thread
+    const int64_t dr  = (d_inner + params->nth - 1) / params->nth;
+    const int64_t ir0 = dr * params->ith;
+    const int64_t ir1 = std::min(ir0 + dr, d_inner);
+
+    for (int64_t s = 0; s < n_s; ++s) {
+        const float * h  = (const float *) ((const char *) hist->data + s*hist->nb[2]);
+        const float * xs = (const float *) ((const char *) x->data    + s*x->nb[2]);
+        float       * y  = (float *)       ((char *)       dst->data  + s*dst->nb[1]);
+
+        for (int64_t i = ir0; i < ir1; ++i) {
+            // position j of the history followed by the new inputs
+            auto at = [&](int64_t j) { return j < n_hist ? h[i*n_hist + j] : xs[(j - n_hist)*d_inner + i]; };
+            const float * w = (const float *) c->data + i*d_conv;
+
+            for (int64_t t = 0; t < n_t; ++t) {
+                float sumf = 0.0f;
+                for (int64_t j = 0; j < d_conv; ++j) {
+                    sumf += at(t + j) * w[j];
+                }
+                y[t*d_inner + i] = silu ? sumf / (1.0f + expf(-sumf)) : sumf;
+            }
+            for (int k = 0; k < n_snap; ++k) {
+                const int64_t start = std::max<int64_t>(0, n_t - k);
+                float * snap = y + d_inner*n_t + k*n_hist*d_inner + i*n_hist;
+                for (int64_t j = 0; j < n_hist; ++j) {
+                    snap[j] = at(start + j);
+                }
+            }
+        }
+    }
+}
+
+// ggml_compute_forward_moe_split_ids
+
+void ggml_compute_forward_moe_split_ids(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * ids      = dst->src[0];
+    const ggml_tensor * map_hot  = dst->src[1];
+    const ggml_tensor * map_cold = dst->src[2];
+
+    if (params->ith != 0) {
+        return;
+    }
+
+    const int64_t n_used  = ids->ne[0];
+    const int64_t n_tok   = ids->ne[1];
+    const int64_t n_plane = n_used*n_tok;
+    const float * hot  = (const float *) map_hot->data;
+    const float * cold = (const float *) map_cold->data;
+    float * out = (float *) dst->data;
+
+    for (int64_t t = 0; t < n_tok; ++t) {
+        const int32_t * e = (const int32_t *) ((const char *) ids->data + t*ids->nb[1]);
+        float low = INFINITY;
+        for (int64_t s = 0; s < n_used; ++s) {
+            low = std::min(low, hot[2*e[s]]);
+        }
+        for (int64_t s = 0; s < n_used; ++s) {
+            const int64_t i = t*n_used + s;
+            out[i]             = hot[2*e[s] + 1]  != 0.0f ? low   : hot[2*e[s]];
+            out[n_plane + i]   = cold[2*e[s] + 1] != 0.0f ? -1.0f : cold[2*e[s]];
+            out[2*n_plane + i] = hot[2*e[s] + 1]  != 0.0f ? 0.0f  : 1.0f;
+        }
+    }
+}
+
+// ggml_compute_forward_count_ids
+
+void ggml_compute_forward_count_ids(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * ids = dst->src[1];
+
+    if (params->ith != 0) {
+        return;
+    }
+
+    const int64_t n = dst->ne[0];
+    float * counts = (float *) dst->data;
+
+    for (int64_t i1 = 0; i1 < ids->ne[1]; ++i1) {
+        for (int64_t i0 = 0; i0 < ids->ne[0]; ++i0) {
+            const int32_t id = *(const int32_t *) ((const char *) ids->data + i0*ids->nb[0] + i1*ids->nb[1]);
+            if (id >= 0 && id < n) {
+                counts[id] += 1.0f;
+            }
+        }
+    }
+}
