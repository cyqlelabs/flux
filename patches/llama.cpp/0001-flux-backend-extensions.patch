+static void ggml_cuda_op_profile_finish(ggml_cuda_op_profile * prof, ggml_backend_cuda_context * ctx) {
+    const size_t n = prof->nodes.size();
+    if (n == 0) {
+        return;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(ctx->stream()));
+
+    float ms = 0.0f;
+    CUDA_CHECK(cudaEventElapsedTime(&ms, prof->events[0], prof->events[2*n - 1]));
+    prof->wall_ms += ms;
+    for (size_t i = 0; i < n; ++i) {
+        CUDA_CHECK(cudaEventElapsedTime(&ms, prof->events[2*i], prof->events[2*i + 1]));
+        auto & stat = prof->keys[ggml_cuda_op_profile_key(prof->nodes[i])];
+        stat.ms    += ms;
+        stat.calls += 1;
+        prof->busy_ms += ms;
+    }
+    prof->entries += n;
+    prof->graphs  += 1;
+    prof->nodes.clear();
+
+    if (prof->graphs < 64) {
+        return;
+    }
+
+    // opt-in output, so warn level: a default log filter keeps it
+    const double g = prof->graphs;
+    GGML_LOG_WARN("cuda op profile: %s backend %d: graphs %d wall %.3f ms/graph busy %.3f ms/graph nodes %.1f/graph\n",
+            ctx->name.c_str(), prof->id, prof->graphs, prof->wall_ms / g, prof->busy_ms / g, prof->entries / g);
+
+    std::vector<std::pair<std::string, ggml_cuda_op_profile::stat>> top(prof->keys.begin(), prof->keys.end());
+    std::sort(top.begin(), top.end(), [](const auto & a, const auto & b) { return a.second.ms > b.second.ms; });
+    top.resize(std::min<size_t>(top.size(), 25));
+    for (const auto & [key, stat] : top) {
+        GGML_LOG_WARN("cuda op profile:   %8.3f ms/graph %7.1f calls/graph %9.1f us/call  %s\n",
+                stat.ms / g, stat.calls / g, 1000.0 * stat.ms / stat.calls, key.c_str());
+    }
+
+    prof->keys.clear();
+    prof->wall_ms = 0.0;
+    prof->busy_ms = 0.0;
+    prof->entries = 0;
+    prof->graphs  = 0;
+}
