+struct test_qsa_top_k : public test_case {
+    int64_t cells, queries, width, ratio;
+    bool ties;
+    test_qsa_top_k(int64_t cells, int64_t queries, int64_t width, int64_t ratio, bool ties) :
+        cells(cells), queries(queries), width(width), ratio(ratio), ties(ties) {}
+    std::string vars() override { return VARS_TO_STR5(cells, queries, width, ratio, ties); }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * scores = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, (cells + ratio - 1)/ratio, queries, 2);
+        auto * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cells, queries, 1, 2);
+        ggml_set_name(scores, "block_scores"); ggml_set_name(mask, "causal_visibility");
+        return ggml_qsa_top_k(ctx, scores, mask, ratio, width);
+    }
+    void initialize_tensors(ggml_context * ctx) override {
+        auto * scores = ggml_get_tensor(ctx, "block_scores");
+        auto * mask = ggml_get_tensor(ctx, "causal_visibility");
+        const int64_t blocks = scores->ne[0];
+        std::vector<float> values(ggml_nelements(scores));
+        std::vector<ggml_fp16_t> visibility(ggml_nelements(mask));
+        for (int64_t row = 0; row < 2*queries; ++row) {
+            const int64_t visible = row%3 == 0 ? std::min<int64_t>(cells, 7) : std::min(cells, width + row*17 + 1);
+            for (int64_t block = 0; block < blocks; ++block) values[row*blocks + block] = block*ratio >= visible/ratio*ratio ? 1e9f : (ties ? 1.0f : float((block*97)%103));
+            for (int64_t cell = 0; cell < cells; ++cell) visibility[row*cells + cell] = ggml_fp32_to_fp16(cell < visible ? 0.0f : -INFINITY);
+        }
+        ggml_backend_tensor_set(scores, values.data(), 0, values.size()*sizeof(float));
+        ggml_backend_tensor_set(mask, visibility.data(), 0, visibility.size()*sizeof(ggml_fp16_t));
+    }
+};
