+// FLUX_CUDA_OP_PROFILE=1: time each launched node with events, without CUDA graphs, and log the
+// slowest ops of each backend every 64 graphs. A fused group counts as its first node.
+struct ggml_cuda_op_profile {
+    struct stat {
+        double  ms    = 0.0;
+        int64_t calls = 0;
+    };
+
+    int id = 0;
+
+    std::vector<cudaEvent_t>         events; // start and end of each entry of the current graph
+    std::vector<const ggml_tensor *> nodes;  // first node of each entry of the current graph
+
+    std::unordered_map<std::string, stat> keys;
+    double  wall_ms = 0.0;
+    double  busy_ms = 0.0;
+    int64_t entries = 0;
+    int     graphs  = 0;
+};
+
+static bool ggml_cuda_op_profile_enabled() {
+    static const bool enabled = [] {
+        const char * env = getenv("FLUX_CUDA_OP_PROFILE");
+        return env && atoi(env) != 0;
+    }();
+    return enabled;
+}
+
+static std::mutex ggml_cuda_op_profile_mutex;
+static std::unordered_map<const ggml_backend_cuda_context *, ggml_cuda_op_profile> ggml_cuda_op_profiles;
+
+static ggml_cuda_op_profile * ggml_cuda_op_profile_get(const ggml_backend_cuda_context * ctx) {
+    if (!ggml_cuda_op_profile_enabled()) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(ggml_cuda_op_profile_mutex);
+    auto it = ggml_cuda_op_profiles.find(ctx);
+    if (it == ggml_cuda_op_profiles.end()) {
+        it = ggml_cuda_op_profiles.emplace(ctx, ggml_cuda_op_profile()).first;
+        it->second.id = (int) ggml_cuda_op_profiles.size() - 1;
+    }
+    return &it->second;
+}
+
+static void ggml_cuda_op_profile_free(const ggml_backend_cuda_context * ctx) {
+    if (!ggml_cuda_op_profile_enabled()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(ggml_cuda_op_profile_mutex);
+    auto it = ggml_cuda_op_profiles.find(ctx);
+    if (it != ggml_cuda_op_profiles.end()) {
+        for (cudaEvent_t event : it->second.events) {
+            CUDA_CHECK(cudaEventDestroy(event));
+        }
+        ggml_cuda_op_profiles.erase(it);
+    }
+}
+
+static void ggml_cuda_op_profile_record(ggml_cuda_op_profile * prof, cudaStream_t stream, size_t i_event) {
+    while (prof->events.size() <= i_event) {
+        cudaEvent_t event;
+        CUDA_CHECK(cudaEventCreate(&event));
+        prof->events.push_back(event);
+    }
+    CUDA_CHECK(cudaEventRecord(prof->events[i_event], stream));
+}
+
+// op and tensor name, with digit runs as '#' and a trailing "-#" (the layer) dropped, so layers aggregate
+static std::string ggml_cuda_op_profile_key(const ggml_tensor * node) {
+    std::string name;
+    for (const char * c = node->name; *c && *c != ' ' && name.size() < 48; ++c) {
+        if (isdigit((unsigned char) *c)) {
+            if (name.empty() || name.back() != '#') {
+                name += '#';
+            }
+        } else {
+            name += *c;
+        }
+    }
+    if (name.size() >= 2 && name.compare(name.size() - 2, 2, "-#") == 0) {
+        name.resize(name.size() - 2);
+    }
+    return name.empty() ? std::string(ggml_op_desc(node)) : std::string(ggml_op_desc(node)) + " " + name;
+}
