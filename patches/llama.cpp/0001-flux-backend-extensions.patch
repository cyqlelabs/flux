+// a function the backend of a device exports, null when it has none
+template <typename F>
+static F llama_backend_proc(ggml_backend_t backend, const char * name) {
+    ggml_backend_dev_t dev = backend ? ggml_backend_get_device(backend) : nullptr;
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    return reg ? (F) ggml_backend_reg_get_proc_address(reg, name) : nullptr;
+}
+
+void llama_context::prompt_regions_clear() {
+    for (size_t i = 0; moe_cache && i < moe_cache->loans.size(); ++i) {
+        ggml_backend_sched_lend_compute(sched.get(), moe_cache->loans[i].backend, nullptr, 0, 0);
+    }
+}
+
+void llama_context::prompt_unlend() {
+    if (!prompt_loan.on) {
+        return;
+    }
+    prompt_regions_clear();
+    for (size_t i = 0; moe_cache && i < moe_cache->loans.size(); ++i) {
+        const auto & ln = moe_cache->loans[i];
+        if (auto lend_pool = llama_backend_proc<void (*)(ggml_backend_t, void *, size_t)>(ln.backend, "ggml_backend_lend_pool")) {
+            lend_pool(ln.backend, nullptr, 0);
+        }
+    }
+    // the graph of the last chunk has tensors in the regions
+    gf_res_prev->reset();
+    prompt_loan = {};
+    prompt_return();
+}
+
+void llama_context::prompt_borrow() {
+    auto * ledger = memory ? memory->ledger() : nullptr;
+    // a loan in progress sized its regions to the loans it started with
+    if (!ledger || !prompt_borrowed.empty() || prompt_loan.on) {
+        return;
+    }
+    auto & loans = moe_cache->loans;
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend_ptrs[i]);
+        if (!dev || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+                std::any_of(loans.begin(), loans.end(), [&](const auto & ln) { return ln.backend == backend_ptrs[i]; })) {
+            continue;
+        }
+        // the planned budget is free only if nothing else took it: keep a quarter of what is free now for the
+        // allocations the backend makes on its own
+        size_t free = 0, total = 0;
+        ggml_backend_dev_memory(dev, &free, &total);
+        const size_t align = ggml_backend_buft_get_alignment(backend_buft[i]);
+        const uint64_t lent = ledger->borrow(dev);
+        const size_t bytes = std::min<uint64_t>(lent, free - free/4) / align * align;
+        ggml_backend_buffer_t buf = bytes > 0 ? ggml_backend_buft_alloc_buffer(backend_buft[i], bytes) : nullptr;
+        if (!buf) {
+            ledger->give_back(dev, lent);
+            continue;
+        }
+        ledger->give_back(dev, lent - bytes);
+        prompt_borrowed.emplace_back(dev, ggml_backend_buffer_ptr(buf));
+        llama_moe_cache::loan ln;
+        ln.backend  = backend_ptrs[i];
+        ln.buf      = buf;
+        ln.offset   = bytes;
+        ln.borrowed = true;
+        loans.push_back(std::move(ln));
+    }
+}
+
+void llama_context::prompt_return() {
+    if (prompt_borrowed.empty()) {
+        return;
+    }
+    // no graph may still use the regions, nor the scheduler keep them
+    synchronize();
+    auto & loans = moe_cache->loans;
+    for (const auto & ln : loans) {
+        if (ln.borrowed) {
+            ggml_backend_sched_lend_compute(sched.get(), ln.backend, nullptr, 0, 0);
+            if (auto lend_pool = llama_backend_proc<void (*)(ggml_backend_t, void *, size_t)>(ln.backend, "ggml_backend_lend_pool")) {
+                lend_pool(ln.backend, nullptr, 0);
+            }
+        }
+    }
+    loans.erase(std::remove_if(loans.begin(), loans.end(), [](const auto & ln) { return ln.borrowed; }), loans.end());
+    gf_res_prev->reset();
+    auto * ledger = memory->ledger();
+    for (auto & [dev, buf] : prompt_borrowed) {
+        ledger->give_back(dev, ggml_backend_buffer_get_size(buf.get()));
+    }
+    prompt_borrowed.clear();
+}
+
+// flux: prompt chunks above n_ubatch need the model's own graph and one cell stream per sequence (a cache that
+// several sequences share can place cells past their positions, beyond the bound ubatch_for takes)
+static bool llama_ubatch_grows(const llama_cparams & cparams) {
+    return cparams.ctx_type == LLAMA_CONTEXT_TYPE_DEFAULT && cparams.n_batch > cparams.n_ubatch &&
+           !(cparams.kv_unified && cparams.n_seq_max > 1);
+}
+
+uint32_t llama_context::prompt_reserve_cells() const {
+    // a paged cache reserves prompt chunks of n_ubatch at the VRAM floor: deeper ones shrink or borrow. The draft
+    // context's chunks are small enough to cover the whole cache
+    return cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? cparams.n_ctx_seq : std::max(256u, cparams.kv_floor_tokens);
+}
+
+uint32_t llama_context::ubatch_for(uint32_t n_tokens) {
+    if (!memory || (!cparams.kv_paging && n_tokens <= cparams.n_ubatch) || (!cparams.kv_paging && !llama_ubatch_grows(cparams))) {
+        return cparams.n_ubatch;
+    }
+    if (!ubatch_by_kv_built) {
+        ubatch_table_build();
+    }
+    const ubatch_fit * fit = ubatch_fit_for(n_tokens);
+    return fit ? fit->tokens : cparams.n_ubatch;
+}
+
+const llama_context::ubatch_fit * llama_context::ubatch_fit_for(uint32_t n_tokens) const {
+    // every sequence's cells after the batch: a bound on the cells its graph reads while each stream fills its cells
+    // in position order, as one sequence or one stream per sequence does
+    uint64_t end = n_tokens;
+    for (llama_seq_id s = 0; s < (llama_seq_id) cparams.n_seq_max; ++s) {
+        if (cparams.kv_paging) {
+            end = std::max(end, uint64_t(memory->seq_pos_max(s) + 1) + n_tokens);
+        } else {
+            end += (uint64_t) (memory->seq_pos_max(s) + 1);
+        }
+    }
+    if (cparams.kv_paging) end = std::min<uint64_t>(end, cparams.kv_unified ? cparams.n_ctx : cparams.n_ctx_seq);
+    for (const auto & fit : ubatch_by_kv) {
+        if (end <= fit.cells) {
+            return &fit;
+        }
+    }
+    return nullptr;
+}
+
+void llama_context::ubatch_table_build() {
+    ubatch_by_kv_built = true;
+    ubatch_by_kv.clear();
+
+    const int64_t  t_start_us = ggml_time_us();
+    const uint32_t n_seqs     = cparams.n_seq_max;
+    const uint32_t base       = std::min(cparams.n_ctx, cparams.n_ubatch);
+    const uint32_t cells      = cparams.kv_unified ? cparams.n_ctx : cparams.n_ctx_seq;
+    const uint32_t step       = 256;
+
+    // compute buffer bytes per backend of a chunk of n_tokens whose attention reads n_kv cells
+    std::vector<size_t> sizes(backend_ptrs.size());
+    auto measure = [&](uint32_t n_tokens, uint32_t n_kv) {
+        llama_kv_cache_context::reserve_n_kv = n_kv;
+        auto mctx = memory->init_full();
+        llama_kv_cache_context::reserve_n_kv = 0;
+        std::fill(sizes.begin(), sizes.end(), 0);
+        return mctx && graph_reserve(n_tokens, n_seqs, std::min(n_tokens, cparams.n_outputs_max), mctx.get(), true, sizes.data());
+    };
+
+    if (cparams.kv_paging) {
+        // the reserve sized the buffers for decode at full depth and for chunks of n_ubatch at the floor; deeper
+        // chunks shrink (or borrow through prompt loans), shallower ones grow. Host buffers may grow.
+        ubatch_gpu.resize(backend_ptrs.size());
+        for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+            auto * dev = ggml_backend_get_device(backend_ptrs[i]);
+            ubatch_gpu[i] = dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU;
+        }
+        // the limit is what sched_reserve sized, measured like the chunks: lent regions hide part of the buffers
+        if (!measure(base, std::min(cells, prompt_reserve_cells()))) throw std::runtime_error("cannot measure the prompt compute reserve");
+        ubatch_limit = sizes;
+        if (!measure(n_seqs*(cparams.n_rs_seq + 1), cells)) throw std::runtime_error("cannot measure the decode compute reserve");
+        for (size_t i = 0; i < sizes.size(); ++i) ubatch_limit[i] = std::max(ubatch_limit[i], sizes[i]);
+        auto fits = [&]() {
+            for (size_t i = 0; i < sizes.size(); ++i) {
+                if (ubatch_gpu[i] && sizes[i] > ubatch_limit[i]) return false;
+            }
+            return true;
+        };
+        auto round = [&](uint32_t n) { return std::max(n_seqs, n/n_seqs*n_seqs); };
+        std::vector<uint32_t> depths;
+        for (uint32_t depth = std::min(cells, 4096u); depth < cells; depth = std::min(cells, depth*2)) depths.push_back(depth);
+        depths.push_back(cells);
+        std::string desc;
+        for (const uint32_t depth : depths) {
+            // at a fixed depth the buffers grow linearly with the chunk: two sizes give each GPU's bytes per token
+            uint32_t smaller = round(std::min(base, cparams.n_batch));
+            while (smaller > n_seqs && !(measure(smaller, depth) && fits())) smaller = round(smaller/2);
+            if (!measure(smaller, depth) || !fits()) throw std::runtime_error("decode compute reserve cannot hold the minimum prompt chunk");
+            const std::vector<size_t> s0 = sizes;
+            ubatch_fit fit{depth, smaller, s0, std::vector<double>(sizes.size(), 0.0), smaller};
+            const uint32_t larger = round(std::min(2*smaller, cparams.n_batch));
+            uint32_t tokens = smaller;
+            if (larger > smaller && measure(larger, depth)) {
+                tokens = cparams.n_batch;
+                for (size_t i = 0; i < sizes.size(); ++i) {
+                    if (ubatch_gpu[i] && sizes[i] > s0[i]) {
+                        fit.per_token[i] = double(sizes[i] - s0[i])/(larger - smaller);
+                        const double room = std::max(0.0, double(ubatch_limit[i]) - double(s0[i]));
+                        tokens = std::min<uint32_t>(tokens, (uint32_t) std::min<double>(smaller + room/fit.per_token[i], cparams.n_batch));
+                    }
+                }
+                // the fit is linear; step down until the measured graph fits
+                tokens = round(tokens/step*step);
+                while (tokens > smaller && tokens > step && !(measure(tokens, depth) && fits())) {
+                    tokens = round(tokens - std::max(step, tokens/8/step*step));
+                }
+                tokens = std::max(tokens, smaller);
+            }
+            fit.tokens = tokens;
+            desc += format(" %u@%u", tokens, depth);
+            ubatch_by_kv.push_back(std::move(fit));
+        }
+        LLAMA_LOG_INFO("%s: paged prompt chunks by cells reached:%s (compute and f16 conversion included, measured in %.0f ms)\n", __func__,
+                desc.c_str(), (ggml_time_us() - t_start_us)/1000.0);
+        return;
+    }
+
+    // the GPUs keep the buffers the reserve sized for a chunk of n_ubatch over the whole cache; host buffers may grow
+    if (!measure(base, cells)) {
+        return;
+    }
+    const std::vector<size_t> limit = sizes;
+    std::vector<bool> gpu(backend_ptrs.size());
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend_ptrs[i]);
+        gpu[i] = dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU;
+    }
+    auto fits = [&]() {
+        for (size_t i = 0; i < sizes.size(); ++i) {
+            if (gpu[i] && sizes[i] > limit[i]) {
+                return false;
+            }
+        }
+        return true;
+    };
+
+    std::string desc;
+    std::string desc_kb;
+    bool grows = true;
+    for (uint32_t den : { 16u, 8u, 4u, 2u, 1u }) {
+        const uint32_t n_kv = den == 1 ? cells : GGML_PAD(cells/den, step);
+        if (n_kv >= cells && den > 1) {
+            continue;
+        }
+        // at a fixed depth the buffers grow linearly with the chunk: two sizes give each GPU's bytes per token
+        const uint32_t u1 = std::min(2*base, cparams.n_batch);
+        if (u1 <= base || !measure(base, n_kv)) {
+            break;
+        }
+        const std::vector<size_t> s0 = sizes;
+        if (!measure(u1, n_kv)) {
+            break;
+        }
+        ubatch_fit fit = { n_kv, base, s0, std::vector<double>(sizes.size(), 0.0), base };
+        uint32_t u = cparams.n_batch;
+        double   kb_max = 0.0;
+        for (size_t i = 0; i < sizes.size(); ++i) {
+            if (gpu[i] && sizes[i] > s0[i]) {
+                const double per_token = double(sizes[i] - s0[i]) / (u1 - base);
+                const double room      = std::max(0.0, double(limit[i]) - double(s0[i]));
+                u = std::min<uint32_t>(u, (uint32_t) std::min<double>(base + room / per_token, cparams.n_batch));
+                fit.per_token[i] = per_token;
+                kb_max = std::max(kb_max, per_token / 1024.0);
+            }
+        }
+        u = u / step * step;
+        // the fit is linear; step down until the measured graph fits. A depth that cannot grow the chunks leaves the
+        // deeper ones at n_ubatch too
+        while (grows && n_kv < cells && u > base && !(measure(u, n_kv) && fits())) {
+            u -= std::max(step, u/8 / step * step);
+        }
+        if (grows && n_kv < cells && u > base) {
+            fit.tokens = u;
+            desc += format(" %u@%u", u, n_kv);
+        } else {
+            grows = false;
+        }
+        desc_kb += format(" %.0f@%u", kb_max, n_kv);
+        ubatch_by_kv.push_back(std::move(fit));
+    }
+    ubatch_limit = limit;
+    ubatch_gpu   = gpu;
+
+    LLAMA_LOG_INFO("%s: prompt chunks by cells reached:%s; KiB per token:%s (measured in %.0f ms)\n", __func__,
+            desc.empty() ? " none above n_ubatch" : desc.c_str(), desc_kb.c_str(), (ggml_time_us() - t_start_us)/1000.0);
+}
+
+static size_t llama_moe_cache_expert_bytes(const llama_moe_cache::layer & l);
+static std::vector<std::pair<int32_t, int32_t>> llama_moe_cache_slots_in(const llama_moe_cache & c, const llama_moe_cache::loan & ln, size_t lo, size_t hi);
+
+// whether chunks of n_lent tokens with the regions lent pay against chunks of n_base: the fewer chunks upload fewer
+// bytes than the evicted experts add to each chunk, plus copying them back after the prompt, all over the same host
+// links. Experts an earlier batch of the prompt evicted are out either way
+static bool llama_moe_cache_loan_pays(const llama_moe_cache & c, const std::vector<size_t> & bytes, uint32_t n_base, uint32_t n_lent) {
+    if (n_lent >= n_base) {
+        return false;
+    }
+    double upload = 0.0;
+    for (const auto & l : c.layers) {
+        const auto n_res = std::count_if(l.slot.begin(), l.slot.end(), [](int32_t s) { return s >= 0; });
+        upload += double(l.slot.size() - n_res) * llama_moe_cache_expert_bytes(l);
+    }
+    double evict = 0.0;
+    for (size_t j = 0; j < c.loans.size(); ++j) {
+        const auto & ln = c.loans[j];
+        if (bytes[j] <= ln.prompt) {
+            continue;
+        }
+        for (const auto & [li, sl] : llama_moe_cache_slots_in(c, ln, ln.offset - bytes[j], ln.offset - ln.prompt)) {
+            const auto & l = c.layers[li];
+            if (sl < l.n_slots && l.expert[sl] >= 0) {
+                evict += llama_moe_cache_expert_bytes(l);
+            }
+        }
+    }
+    return n_lent*(upload + evict) + evict < n_base*upload;
+}
+
+size_t llama_context::backend_index(ggml_backend_t backend) const {
+    size_t i = 0;
+    while (i < backend_ptrs.size() && backend_ptrs[i] != backend) {
+        ++i;
+    }
+    return i;
+}
+
+double llama_context::scratch_per_token(const ubatch_fit & fit, size_t i) const {
+    // before a full prompt chunk ran, as many bytes as its compute buffer takes (several times the scratch on the
+    // GPUs measured so far)
+    return i < pool_per_token.size() && pool_per_token[i] > 0.0 ? pool_per_token[i] : fit.per_token[i];
+}
+
+uint32_t llama_context::prompt_chunk_max(const ubatch_fit & fit) const {
+    const uint32_t base = fit.base_tokens;
+    uint32_t u = cparams.n_batch;
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        const double k = fit.per_token[i];
+        if (!ubatch_gpu[i] || k <= 0.0) {
+            continue;
+        }
+        // a GPU keeps to its compute buffer, as in ubatch_for, unless its cache lends: then the lent bytes also
+        // back the scratch of the chunk
+        const double room = std::max(0.0, double(ubatch_limit[i]) - double(fit.base[i]));
+        double u_i = base + room / k;
+        for (const auto & ln : moe_cache->loans) {
+            if (ln.backend == backend_ptrs[i]) {
+                u_i = (double(ln.offset - ln.pools) + room + k*base) / (k + scratch_per_token(fit, i));
+            }
+        }
+        u = (uint32_t) std::min<double>(u, std::max(0.0, u_i));
+    }
+    return u;
+}
+
+bool llama_context::prompt_regions_fit(const ubatch_fit & fit, uint32_t n_tokens, const std::vector<size_t> & compute) {
+    const auto & loans = moe_cache->loans;
+    for (size_t j = 0; j < loans.size(); ++j) {
+        const auto & ln = loans[j];
+        ggml_backend_sched_lend_compute(sched.get(), ln.backend, compute[j] > 0 ? ln.buf : nullptr, ln.offset - compute[j], compute[j]);
+    }
+
+    std::vector<size_t> sizes(backend_ptrs.size(), 0);
+    llama_kv_cache_context::reserve_n_kv = fit.cells;
+    auto mctx = memory->init_full();
+    llama_kv_cache_context::reserve_n_kv = 0;
+    if (!mctx || !graph_reserve(n_tokens, cparams.n_seq_max, std::min(n_tokens, cparams.n_outputs_max), mctx.get(), true, sizes.data())) {
+        return false;
+    }
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        bool lends = false;
+        for (size_t j = 0; j < loans.size(); ++j) {
+            lends = lends || (loans[j].backend == backend_ptrs[i] && compute[j] > 0);
+        }
+        if (ubatch_gpu[i] && (sizes[i] == SIZE_MAX || (!lends && sizes[i] > ubatch_limit[i]))) {
+            return false;
+        }
+    }
+    for (const auto & ln : loans) {
+        if (ggml_backend_sched_get_lent_size(sched.get(), ln.backend) == SIZE_MAX) {
+            return false;
+        }
+    }
+    return true;
+}
+
+uint32_t llama_context::prompt_chunk(uint32_t n_tokens, uint32_t chunk) {
+    const ubatch_fit * fit = moe_cache && !moe_cache->loans.empty() && llama_ubatch_grows(cparams) && n_tokens > chunk ? ubatch_fit_for(n_tokens) : nullptr;
+    if (!fit) {
+        return chunk;
+    }
+
+    prompt_borrow();
+    const auto   & loans = moe_cache->loans;
+    const uint32_t step  = 256;
+
+    uint32_t u = prompt_chunk_max(*fit) / step * step;
+    if (u <= chunk) {
+        if (!prompt_loan.on) {
+            prompt_return();
+        }
+        return chunk;
+    }
+    // as few chunks as u allows, evened out
+    {
+        const uint32_t n = (n_tokens + u - 1) / u;
+        u = std::min(u, GGML_PAD((n_tokens + n - 1) / n, step));
+    }
+
+    // each region as large as its lender allows next to the scratch of a chunk of n tokens
+    std::vector<size_t> compute(loans.size(), 0);
+    std::vector<size_t> scratch(loans.size(), 0);
+    auto regions_for = [&](uint32_t n) {
+        for (size_t j = 0; j < loans.size(); ++j) {
+            const size_t i = backend_index(loans[j].backend);
+            if (i < backend_ptrs.size()) {
+                const size_t align = ggml_backend_buft_get_alignment(backend_buft[i]);
+                const size_t lend  = loans[j].offset - loans[j].pools;
+                scratch[j] = std::min(GGML_PAD((size_t) (scratch_per_token(*fit, i) * n), align), lend);
+                compute[j] = (lend - scratch[j]) / align * align;
+            }
+        }
+    };
+
+    // the fit is linear; step down until the measured graph fits, then shrink each compute region to what the graph
+    // takes (the allocator then places the same tensors at the same offsets), checked once more
+    bool ok = false;
+    while (u > chunk) {
+        regions_for(u);
+        if ((ok = prompt_regions_fit(*fit, u, compute))) {
+            break;
+        }
+        u -= std::max(step, u/8 / step * step);
+    }
+    if (ok) {
+        // the chunks of the batch read fewer cells than the measured graph, so the allocator packs their tensors
+        // differently: the largest of them may need room next to what the measured graph used
+        std::vector<size_t> largest(loans.size(), 0);
+        auto * gf = gf_res_reserve->get_gf();
+        for (int k = 0; k < ggml_graph_n_nodes(gf); ++k) {
+            ggml_tensor * node = ggml_graph_node(gf, k);
+            ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched.get(), node);
+            for (size_t j = 0; j < loans.size(); ++j) {
+                if (loans[j].backend == backend) largest[j] = std::max(largest[j], ggml_nbytes(node));
+            }
+        }
+        for (size_t j = 0; j < loans.size(); ++j) {
+            const size_t i    = backend_index(loans[j].backend);
+            const size_t used = ggml_backend_sched_get_lent_size(sched.get(), loans[j].backend);
+            if (i < backend_ptrs.size() && used != SIZE_MAX) {
+                compute[j] = std::min(compute[j], GGML_PAD(used + largest[j], ggml_backend_buft_get_alignment(backend_buft[i])));
+            }
+        }
+        if (!prompt_regions_fit(*fit, u, compute)) {
+            regions_for(u);
+            ok = prompt_regions_fit(*fit, u, compute);
+        }
+    }
+
+    std::vector<size_t> bytes(loans.size());
+    for (size_t j = 0; j < loans.size(); ++j) {
+        bytes[j] = compute[j] + scratch[j];
+    }
+    if (!ok || !llama_moe_cache_loan_pays(*moe_cache, bytes, (n_tokens + chunk - 1) / chunk, (n_tokens + u - 1) / u)) {
+        // the base chunks fit the compute buffers; experts an earlier batch evicted stay out until the reclaim
+        if (prompt_loan.on) {
+            prompt_unlend();
+        } else {
+            prompt_regions_clear();
+            prompt_return();
+        }
+        return chunk;
+    }
+
+    prompt_lend(u, compute, scratch);
+    return u;
+}
+
+void llama_context::prompt_lend(uint32_t n_tokens, const std::vector<size_t> & compute, const std::vector<size_t> & scratch) {
+    auto & loans = moe_cache->loans;
+    std::vector<size_t> bytes(loans.size());
+    for (size_t j = 0; j < loans.size(); ++j) {
+        bytes[j] = compute[j] + scratch[j];
+    }
+    moe_cache->lend_prompt(bytes);
+
+    // the compute regions are lent as the last check left them, nearest the stage regions; the scratch before them
+    for (size_t j = 0; j < loans.size(); ++j) {
+        const auto & ln = loans[j];
+        if (auto lend_pool = llama_backend_proc<void (*)(ggml_backend_t, void *, size_t)>(ln.backend, "ggml_backend_lend_pool")) {
+            char * base = (char *) ggml_backend_buffer_get_base(ln.buf);
+            lend_pool(ln.backend, scratch[j] > 0 ? base + ln.offset - bytes[j] : nullptr, scratch[j]);
+        }
+    }
+
+    if (!prompt_loan.on || prompt_loan.tokens != n_tokens || prompt_loan.compute != compute || prompt_loan.scratch != scratch) {
+        for (size_t j = 0; j < loans.size(); ++j) {
+            LLAMA_LOG_INFO("%s: %s: prompt chunks of %u tokens borrow %.0f MiB of the expert cache (%.0f MiB compute, %.0f MiB scratch)\n",
+                    __func__, ggml_backend_name(loans[j].backend), n_tokens, bytes[j] / 1048576.0, compute[j] / 1048576.0, scratch[j] / 1048576.0);
+        }
+    }
+    prompt_loan.on      = true;
+    prompt_loan.tokens  = n_tokens;
+    prompt_loan.compute = compute;
+    prompt_loan.scratch = scratch;
+}
+
+bool llama_context::prompt_loan_widen() {
+    if (!prompt_loan.on) {
+        return false;
+    }
+    const auto & loans = moe_cache->loans;
+    std::vector<size_t> compute = prompt_loan.compute;
+    bool grew = false;
+    for (size_t j = 0; j < loans.size(); ++j) {
+        const size_t i = backend_index(loans[j].backend);
+        if (i >= backend_ptrs.size()) {
+            continue;
+        }
+        const size_t align = ggml_backend_buft_get_alignment(backend_buft[i]);
+        const size_t whole = (loans[j].offset - loans[j].pools - prompt_loan.scratch[j]) / align * align;
+        grew = grew || whole > compute[j];
+        compute[j] = std::max(compute[j], whole);
+    }
+    if (!grew) {
+        return false;
+    }
+    // the region evicts more experts, which the graphs still queued may read
+    synchronize();
+    for (size_t j = 0; j < loans.size(); ++j) {
+        ggml_backend_sched_lend_compute(sched.get(), loans[j].backend, compute[j] > 0 ? loans[j].buf : nullptr, loans[j].offset - compute[j], compute[j]);
+    }
+    prompt_lend(prompt_loan.tokens, compute, prompt_loan.scratch);
+    return true;
+}
+
+int32_t llama_context::set_offload_tuning(bool enable) {
+    offload_tuning = false;
+    h2d_rates.clear();
+    if (enable) {
+        if (!cparams.op_offload) {
+            LLAMA_LOG_ERROR("%s: op offload is off\n", __func__);
+            return -1;
+        }
+        for (auto & backend : backends) {
+            ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+            if (dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                h2d_rates.emplace_back(backend.get(), 0.0);
+            }
+        }
+        if (h2d_rates.empty()) {
+            LLAMA_LOG_ERROR("%s: no GPU to offload to\n", __func__);
+            return -1;
+        }
+        offload_tuning = true;
+        // with several GPUs, op offload picks one by host link speed (sched_setup, graph_get_cb); without a measured
+        // rate for each, it keeps the upstream choice
+        for (auto & [backend, rate] : h2d_rates) {
+            rate = h2d_rates.size() > 1 ? llama_h2d_rate(ggml_backend_get_device(backend)) : 0.0;
+            if (rate > 0.0) {
+                LLAMA_LOG_INFO("%s: %10s host-to-device rate = %6.2f GB/s\n", __func__, ggml_backend_name(backend), rate / 1e9);
+            }
+        }
+        if (h2d_rates.size() < 2 || std::any_of(h2d_rates.begin(), h2d_rates.end(), [](const auto & r) { return r.second <= 0.0; })) {
+            h2d_rates.clear();
+        }
+    }
+    // reserve now, so a dry run reports the staging targets
+    sched_need_reserve = true;
+    sched_reserve();
+    return 0;
+}
+
+// flux: the scheduler's prefetch share for a setting of the trial: ahead once a chunk uses half of a layer's experts,
+// so it never uploads more than twice what the layer reads; otherwise only after the router
+static float llama_prefetch_share(bool ahead) {
+    return ahead ? 0.5f : 2.0f;
+}
+
+void llama_context::prefetch_chunk_done(double us_per_token) {
+    auto & p = prefetch;
+    if (p.chosen) {
+        // links and loads change: measure again now and then
+        if (++p.chunks >= 64) {
+            p = prefetch_trial{};
+            ggml_backend_sched_set_prefetch_share(sched.get(), llama_prefetch_share(p.ahead));
+        }
+        return;
+    }
+    p.us_per_token[p.ahead] += us_per_token;
+    p.n[p.ahead]++;
+    if (p.n[0] >= 2 && p.n[1] >= 2) {
+        const double behind = p.us_per_token[0] / p.n[0];
+        const double ahead  = p.us_per_token[1] / p.n[1];
+        p.ahead  = ahead < behind;
+        p.chosen = true;
+        p.chunks = 0;
+        LLAMA_LOG_INFO("%s: prompt chunks upload experts %s their router (%.0f vs %.0f us per token)\n", __func__,
+                p.ahead ? "ahead of" : "after", std::min(ahead, behind), std::max(ahead, behind));
+    } else {
+        // chunks slow down as the context fills: ahead, after, after, ahead gives both the same mean depth
+        static const int32_t order[4] = { 1, 0, 0, 1 };
+        p.ahead = order[(p.n[0] + p.n[1]) % 4];
+    }
+    ggml_backend_sched_set_prefetch_share(sched.get(), llama_prefetch_share(p.ahead));
+}
+
+void llama_context::staging_batch_done(double us_per_token) {
+    auto & t = staging;
+    if (t.chosen) {
+        if (++t.batches >= 8) {
+            t = staging_trial{};
+        }
+        return;
+    }
+    t.us_per_token[t.on] += us_per_token;
+    t.n[t.on]++;
+    if (t.n[0] >= 2 && t.n[1] >= 2) {
+        const double unstaged = t.us_per_token[0] / t.n[0];
+        const double staged   = t.us_per_token[1] / t.n[1];
+        t.on      = staged < unstaged;
+        t.chosen  = true;
+        t.batches = 0;
+        LLAMA_LOG_INFO("%s: deep prompt chunks %s their host KV pages (%.0f vs %.0f us per token)\n", __func__,
+                t.on ? "stage" : "read in place", std::min(staged, unstaged), std::max(staged, unstaged));
+    } else {
+        // batches slow down as the context fills: in place, staged, staged, in place gives both the same mean depth
+        static const int32_t order[4] = { 0, 1, 1, 0 };
+        t.on = order[(t.n[0] + t.n[1]) % 4];
+    }
+}
+
+void llama_context::sched_setup() {
+    ggml_backend_sched_set_staging(sched.get(), offload_tuning);
+    ggml_backend_sched_set_prefetch_share(sched.get(), llama_prefetch_share(prefetch.ahead));
+    for (size_t i = 0; moe_cache && i < moe_cache->loans.size(); ++i) {
+        const auto & ln = moe_cache->loans[i];
+        ggml_backend_sched_lend_stage(sched.get(), ln.backend, ln.buf, ln.offset, ln.size);
