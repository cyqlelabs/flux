+// ssm_conv_hist: one thread per channel and a chunk of up to 32 tokens; the sum runs in the order of ssm_conv_f32,
+// so the result is bitwise the same as ssm_conv (+ silu) over the concatenated history and inputs
+template <bool apply_silu, int d_conv>
+static __global__ void ssm_conv_hist_f32(const float * __restrict__ hist, const float * __restrict__ x, const float * __restrict__ c,
+                                         float * __restrict__ dst, const int64_t d_inner, const int64_t n_t, const int n_snap,
+                                         const int64_t hist_nb2, const int64_t x_nb2, const int64_t dst_nb1) {
+    constexpr int n_hist = d_conv - 1;
+
+    const int64_t i  = (int64_t) blockIdx.y*blockDim.x + threadIdx.x; // channel
+    const int64_t s  = blockIdx.x;
+    const int64_t t0 = (int64_t) blockIdx.z*32;
+    if (i >= d_inner) {
+        return;
+    }
+
+    const float * h  = (const float *) ((const char *) hist + s*hist_nb2) + i*n_hist;
+    const float * xs = (const float *) ((const char *) x    + s*x_nb2) + i;
+    float       * y  = (float *)       ((char *)       dst  + s*dst_nb1);
+
+    // position j of the history followed by the new inputs
+    auto at = [&](int64_t j) { return j < n_hist ? h[j] : xs[(j - n_hist)*d_inner]; };
+
+    float w[d_conv];
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        w[j] = c[i*d_conv + j];
+    }
+
+    float win[d_conv];
+#pragma unroll
+    for (int j = 0; j < n_hist; ++j) {
+        win[j] = at(t0 + j);
+    }
+
+    const float b = 0.0f;
+    const int64_t t1 = min(t0 + 32, n_t);
+    for (int64_t t = t0; t < t1; ++t) {
+        win[n_hist] = xs[t*d_inner];
+
+        float sumf = 0.0f;
+#pragma unroll
+        for (int j = 0; j < d_conv; ++j) {
+            sumf += win[j] * w[j];
+        }
+        sumf += b;
+        y[t*d_inner + i] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+
+#pragma unroll
+        for (int j = 0; j < n_hist; ++j) {
+            win[j] = win[j + 1];
+        }
+    }
+
+    if (blockIdx.z == 0) {
+        for (int k = 0; k < n_snap; ++k) {
+            const int64_t start = max((int64_t) 0, n_t - k);
+            float * snap = y + d_inner*n_t + (int64_t) k*n_hist*d_inner + i*n_hist;
+#pragma unroll
+            for (int j = 0; j < n_hist; ++j) {
+                snap[j] = at(start + j);
+            }
+        }
+    }
+}
+
+void ggml_cuda_op_ssm_conv_hist(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * hist = dst->src[0];
+    const ggml_tensor * x    = dst->src[1];
+    const ggml_tensor * c    = dst->src[2];
+
+    const int64_t d_conv  = c->ne[0];
+    const int64_t d_inner = c->ne[1];
+    const int64_t n_t     = x->ne[1];
+    const int64_t n_s     = x->ne[2];
+    const int     n_snap  = ggml_get_op_params_i32(dst, 0);
+    const bool    silu    = ggml_get_op_params_i32(dst, 1) != 0;
+
+    const int threads = 128;
+    const dim3 blocks(n_s, (d_inner + threads - 1)/threads, (n_t + 31)/32);
+    cudaStream_t stream = ctx.stream();
+
+    const float * hist_d = (const float *) hist->data;
+    const float * x_d    = (const float *) x->data;
+    const float * c_d    = (const float *) c->data;
+    float       * dst_d  = (float *) dst->data;
+
+    auto launch = [&](auto D) {
+        constexpr int kD = decltype(D)::value;
+        if (silu) {
+            ssm_conv_hist_f32<true, kD><<<blocks, threads, 0, stream>>>(hist_d, x_d, c_d, dst_d, d_inner, n_t, n_snap,
+                    hist->nb[2], x->nb[2], dst->nb[1]);
+        } else {
+            ssm_conv_hist_f32<false, kD><<<blocks, threads, 0, stream>>>(hist_d, x_d, c_d, dst_d, d_inner, n_t, n_snap,
+                    hist->nb[2], x->nb[2], dst->nb[1]);
+        }
+    };
+
+    switch (d_conv) {
+        case 3: launch(std::integral_constant<int, 3>{}); break;
+        case 4: launch(std::integral_constant<int, 4>{}); break;
+        case 5: launch(std::integral_constant<int, 5>{}); break;
+        default: GGML_ABORT("ssm_conv_hist supports kernel sizes 3, 4 and 5");
+    }
+}
