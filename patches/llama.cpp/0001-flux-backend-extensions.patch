+// backend samplers whose outputs index the logits row, so a prefix of the vocabulary keeps candidate index == token id
+static bool llama_sampler_vocab_prefix_ok(llama_sampler * smpl) {
+    const char * name = llama_sampler_name(smpl);
+    if (strcmp(name, "chain") == 0) {
+        for (int i = 0; i < llama_sampler_chain_n(smpl); ++i) {
+            if (!llama_sampler_vocab_prefix_ok(llama_sampler_chain_get(smpl, i))) {
+                return false;
+            }
+        }
+        return true;
+    }
+    // backend samplers prefix their name with '+' or '-' once initialized, and '?' marks an empty one
+    if (*name == '+' || *name == '-') {
+        ++name;
+    }
+    if (*name == '?') {
+        return true;
+    }
+    static const char * ok[] = { "top-k", "top-p", "min-p", "temp", "temp-ext", "dist", "greedy" };
+    for (const char * s : ok) {
+        if (strcmp(name, s) == 0) {
+            return true;
+        }
+    }
+    return false;
