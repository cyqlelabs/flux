+// ggml_compute_forward_ssm_conv_hist
+
+void ggml_compute_forward_ssm_conv_hist(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * hist = dst->src[0];
+    const ggml_tensor * x    = dst->src[1];
+    const ggml_tensor * c    = dst->src[2];
+
+    const int64_t d_conv  = c->ne[0];
+    const int64_t d_inner = c->ne[1];
+    const int64_t n_hist  = d_conv - 1;
+    const int64_t n_t     = x->ne[1];
+    const int64_t n_s     = x->ne[2];
+    const int     n_snap  = ggml_get_op_params_i32(dst, 0);
+    const bool    silu    = ggml_get_op_params_i32(dst, 1) != 0;
+
+    // channels per thread
+    const int64_t dr  = (d_inner + params->nth - 1) / params->nth;
+    const int64_t ir0 = dr * params->ith;
+    const int64_t ir1 = std::min(ir0 + dr, d_inner);
+
+    for (int64_t s = 0; s < n_s; ++s) {
+        const float * h  = (const float *) ((const char *) hist->data + s*hist->nb[2]);
+        const float * xs = (const float *) ((const char *) x->data    + s*x->nb[2]);
+        float       * y  = (float *)       ((char *)       dst->data  + s*dst->nb[1]);
+
+        for (int64_t i = ir0; i < ir1; ++i) {
+            // position j of the history followed by the new inputs
+            auto at = [&](int64_t j) { return j < n_hist ? h[i*n_hist + j] : xs[(j - n_hist)*d_inner + i]; };
+            const float * w = (const float *) c->data + i*d_conv;
+
+            for (int64_t t = 0; t < n_t; ++t) {
+                float sumf = 0.0f;
+                for (int64_t j = 0; j < d_conv; ++j) {
+                    sumf += at(t + j) * w[j];
+                }
+                y[t*d_inner + i] = silu ? sumf / (1.0f + expf(-sumf)) : sumf;
+            }
+            for (int k = 0; k < n_snap; ++k) {
+                const int64_t start = std::max<int64_t>(0, n_t - k);
+                float * snap = y + d_inner*n_t + k*n_hist*d_inner + i*n_hist;
+                for (int64_t j = 0; j < n_hist; ++j) {
+                    snap[j] = at(start + j);
+                }
+            }
+        }
+    }
+}
+
+// ggml_compute_forward_moe_split_ids
+
+void ggml_compute_forward_moe_split_ids(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * ids      = dst->src[0];
+    const ggml_tensor * map_hot  = dst->src[1];
+    const ggml_tensor * map_cold = dst->src[2];
+
+    if (params->ith != 0) {
+        return;
+    }
+
+    const int64_t n_used  = ids->ne[0];
+    const int64_t n_tok   = ids->ne[1];
+    const int64_t n_plane = n_used*n_tok;
+    const float * hot  = (const float *) map_hot->data;
+    const float * cold = (const float *) map_cold->data;
+    float * out = (float *) dst->data;
+
+    for (int64_t t = 0; t < n_tok; ++t) {
+        const int32_t * e = (const int32_t *) ((const char *) ids->data + t*ids->nb[1]);
+        float low = INFINITY;
+        for (int64_t s = 0; s < n_used; ++s) {
+            low = std::min(low, hot[2*e[s]]);
+        }
+        for (int64_t s = 0; s < n_used; ++s) {
+            const int64_t i = t*n_used + s;
+            out[i]             = hot[2*e[s] + 1]  != 0.0f ? low   : hot[2*e[s]];
+            out[n_plane + i]   = cold[2*e[s] + 1] != 0.0f ? -1.0f : cold[2*e[s]];
+            out[2*n_plane + i] = hot[2*e[s] + 1]  != 0.0f ? 0.0f  : 1.0f;
+        }
+    }
+}
+
+// ggml_compute_forward_count_ids
+
+void ggml_compute_forward_count_ids(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * ids = dst->src[1];
+
+    if (params->ith != 0) {
+        return;
+    }
+
+    const int64_t n = dst->ne[0];
+    float * counts = (float *) dst->data;
+
+    for (int64_t i1 = 0; i1 < ids->ne[1]; ++i1) {
+        for (int64_t i0 = 0; i0 < ids->ne[0]; ++i0) {
+            const int32_t id = *(const int32_t *) ((const char *) ids->data + i0*ids->nb[0] + i1*ids->nb[1]);
+            if (id >= 0 && id < n) {
+                counts[id] += 1.0f;
+            }
+        }
+    }
+}
