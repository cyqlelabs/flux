+
+// ggml_hc_mix
+
+struct ggml_tensor * ggml_hc_mix(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * w_norm,
+        struct ggml_tensor  * w_down,
+        struct ggml_tensor  * w_up,
+        struct ggml_tensor  * w_inject,
+        float                 eps) {
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const int64_t n_t    = x->ne[2];
+    const int64_t hc_dim = hc*n_embd;
+    const int64_t n_lr   = w_down->ne[1];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && w_norm->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(w_norm) && x->ne[3] == 1);
+    GGML_ASSERT(ggml_nelements(w_norm) == hc_dim);
+    GGML_ASSERT(w_down->ne[0] == hc_dim && ggml_is_matrix(w_down));
+    GGML_ASSERT(w_up->ne[0] == n_lr && w_up->ne[1] == hc_dim && ggml_is_matrix(w_up));
+    GGML_ASSERT(w_down->type == w_up->type);
+    if (w_inject) {
+        GGML_ASSERT(w_inject->type == w_down->type && w_inject->ne[0] == hc_dim && w_inject->ne[1] == hc && ggml_is_matrix(w_inject));
+    }
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd*n_t + (w_inject ? hc*n_t : 0));
+
+    ggml_set_op_params_f32(result, 0, eps);
+
+    result->op     = GGML_OP_HC_MIX;
+    result->src[0] = x;
+    result->src[1] = w_norm;
+    result->src[2] = w_down;
+    result->src[3] = w_up;
+    result->src[4] = w_inject;
+
+    return result;
+}
+
+// ggml_ssm_conv_hist
+
+struct ggml_tensor * ggml_ssm_conv_hist(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * hist,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * c,
+        int                   n_snap,
+        bool                  silu) {
+    GGML_ASSERT(hist->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(hist) && ggml_is_contiguous(x) && ggml_is_contiguous(c));
+    GGML_ASSERT(ggml_is_matrix(c) && c->ne[0] >= 2);
+    GGML_ASSERT(n_snap >= 0);
+
+    const int64_t d_conv  = c->ne[0];
+    const int64_t d_inner = c->ne[1];
+    const int64_t n_t     = x->ne[1];
+    const int64_t n_s     = x->ne[2];
+
+    GGML_ASSERT(hist->ne[0] == d_conv - 1 && hist->ne[1] == d_inner && hist->ne[2] == n_s && hist->ne[3] == 1);
+    GGML_ASSERT(x->ne[0] == d_inner && x->ne[3] == 1);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_inner*n_t + n_snap*(d_conv - 1)*d_inner, n_s);
+
+    ggml_set_op_params_i32(result, 0, n_snap);
+    ggml_set_op_params_i32(result, 1, silu ? 1 : 0);
+
+    result->op     = GGML_OP_SSM_CONV_HIST;
+    result->src[0] = hist;
+    result->src[1] = x;
+    result->src[2] = c;
+
+    return result;
+}
