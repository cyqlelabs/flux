+// Qwen4-Exp hyper-connections: elementwise, one thread per output value.
+
+static __global__ void hc_gated_mean_f32(
+        const float * x, const float * gate, float * dst, const int64_t n_embd, const int hc, const int64_t n, const float inv) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t base = (i / n_embd) * hc * n_embd + i % n_embd;
+    float sum = 0.0f;
+    for (int h = 0; h < hc; ++h) {
+        sum += x[base + h * n_embd] * gate[base + h * n_embd];
+    }
+    dst[i] = sum * inv;
+}
+
+static __global__ void hc_inject_f32(
+        const float * residual, const float * x, const float * inject, float * dst,
+        const int64_t n_embd, const int hc, const int64_t n, const float scale) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t row = i / n_embd; // (stream, token)
+    const float   w   = 2.0f / (1.0f + expf(-inject[row] * scale));
+    dst[i] = residual[i] + x[(row / hc) * n_embd + i % n_embd] * w;
+}
+
+void ggml_cuda_op_hc_gated_mean(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * gate = dst->src[1];
+    const int64_t n  = ggml_nelements(dst);
+    const int     hc = (int) x->ne[1];
+    const int     bs = 256;
+    hc_gated_mean_f32<<<(n + bs - 1) / bs, bs, 0, ctx.stream()>>>(
+        (const float *) x->data, (const float *) gate->data, (float *) dst->data, x->ne[0], hc, n, 1.0f / (float) hc);
+}
+
+void ggml_cuda_op_hc_inject(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * residual = dst->src[0];
+    const ggml_tensor * x        = dst->src[1];
+    const ggml_tensor * inject   = dst->src[2];
+    const int64_t n  = ggml_nelements(dst);
+    const int     bs = 256;
+    hc_inject_f32<<<(n + bs - 1) / bs, bs, 0, ctx.stream()>>>(
+        (const float *) residual->data, (const float *) x->data, (const float *) inject->data, (float *) dst->data,
+        residual->ne[0], (int) residual->ne[1], n, ggml_get_op_params_f32(dst, 0));
+}
+
+//
+// hc_mix: three kernels in place of rms_norm, mul, the down/up/inject matmuls, scale, silu, sigmoid and the gated mean
+//
+
+// eight bf16 of a 16-byte load as floats
+static __device__ __forceinline__ void hc_bf16x8(const uint4 v, float * f) {
+    const uint32_t w[4] = { v.x, v.y, v.z, v.w };
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        f[2*i + 0] = __uint_as_float(w[i] << 16);
+        f[2*i + 1] = __uint_as_float(w[i] & 0xffff0000u);
+    }
+}
+
+// xn = rms_norm(x) per stream * w_norm; one block per (stream, token)
+static __global__ void hc_mix_norm(const float * x, const float * w_norm, float * xn, const int n_embd, const float eps) {
+    const int h  = blockIdx.x;
+    const int t  = blockIdx.y;
+    const int hc = gridDim.x;
+
+    const float * xr = x  + ((int64_t) t*hc + h)*n_embd;
+    float       * yr = xn + ((int64_t) t*hc + h)*n_embd;
+    const float * wr = w_norm + (int64_t) h*n_embd;
+
+    float sum = 0.0f;
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        sum += xr[i]*xr[i];
+    }
+    sum = warp_reduce_sum(sum);
+    __shared__ float s_sum[32];
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    if (lane == 0) {
+        s_sum[warp] = sum;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        sum = lane < (int) (blockDim.x / WARP_SIZE) ? s_sum[lane] : 0.0f;
+        sum = warp_reduce_sum(sum);
+        if (lane == 0) {
+            s_sum[0] = sum;
+        }
+    }
+    __syncthreads();
+
+    const float rs = rsqrtf(s_sum[0]/n_embd + eps);
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        yr[i] = (rs*xr[i])*wr[i];
+    }
+}
+
+// rows [0, n_lr) of w_down give lo = silu(scale * w_down xn), rows [n_lr, n_lr + n_inj) of w_inject give inject;
+// a block takes R rows for every token, its threads striding over the 16-byte chunks of a row
+template <int n_t, int R>
+static __global__ void hc_mix_down(const uint16_t * w_down, const uint16_t * w_inj, const float * xn, float * lo, float * inject,
+                                   const int K, const int n_lr, const int n_inj, const float scale) {
+    const int row0 = blockIdx.x*R;
+
+    const uint16_t * w[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        const int row = row0 + r;
+        w[r] = row < n_lr ? w_down + (int64_t) row*K : row < n_lr + n_inj ? w_inj + (int64_t) (row - n_lr)*K : nullptr;
+    }
+
+    float acc[R][n_t] = {};
+    for (int c = threadIdx.x*8; c < K; c += blockDim.x*8) {
+        float xv[n_t][8];
+#pragma unroll
+        for (int t = 0; t < n_t; ++t) {
+            const float4 a = *(const float4 *) (xn + (int64_t) t*K + c);
+            const float4 b = *(const float4 *) (xn + (int64_t) t*K + c + 4);
+            xv[t][0] = a.x; xv[t][1] = a.y; xv[t][2] = a.z; xv[t][3] = a.w;
+            xv[t][4] = b.x; xv[t][5] = b.y; xv[t][6] = b.z; xv[t][7] = b.w;
+        }
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            if (!w[r]) {
+                continue;
+            }
+            float wv[8];
+            hc_bf16x8(*(const uint4 *) (w[r] + c), wv);
+#pragma unroll
+            for (int t = 0; t < n_t; ++t) {
+#pragma unroll
+                for (int e = 0; e < 8; ++e) {
+                    acc[r][t] += wv[e]*xv[t][e];
+                }
+            }
+        }
+    }
+
+    __shared__ float s_acc[32][R*n_t];
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+#pragma unroll
+        for (int t = 0; t < n_t; ++t) {
+            const float v = warp_reduce_sum(acc[r][t]);
+            if (lane == 0) {
+                s_acc[warp][r*n_t + t] = v;
+            }
+        }
+    }
+    __syncthreads();
+
+    const int n_warps = blockDim.x / WARP_SIZE;
+    for (int i = threadIdx.x; i < R*n_t; i += blockDim.x) {
+        float sum = 0.0f;
+        for (int k = 0; k < n_warps; ++k) {
+            sum += s_acc[k][i];
+        }
+        const int row = row0 + i / n_t;
+        const int t   = i % n_t;
+        if (row < n_lr) {
+            const float v = sum*scale;
+            lo[(int64_t) t*n_lr + row] = v/(1.0f + expf(-v));
+        } else if (row < n_lr + n_inj) {
+            inject[(int64_t) t*n_inj + row - n_lr] = sum;
+        }
+    }
+}
+
+// mixed[d] = mean_h(xn[h, d] * sigmoid(w_up[h, d] . lo)); a warp takes one d, its lanes h*8 + k the 16-byte chunks
+// k, k + 8, ... of the row of stream h. lo sits in shared memory as two float4 planes, so the eight lanes of a row
+// read consecutive 16 bytes
+template <int n_t, int hc>
+static __global__ void __launch_bounds__(256) hc_mix_up(const uint16_t * w_up, const float * lo, const float * xn, float * mixed,
+                                                         const int n_embd, const int n_lr) {
+    static_assert(hc*8 == WARP_SIZE, "a warp holds the streams of one output");
+    extern __shared__ float4 s_lo4[]; // [2][n_t][n_lr/8]
+    const int n_ch = n_lr/8;
+    for (int i = threadIdx.x; i < 2*n_t*n_ch; i += blockDim.x) {
+        const int half = i % 2, j = (i/2) % n_ch, t = i/(2*n_ch);
+        s_lo4[(half*n_t + t)*n_ch + j] = *(const float4 *) (lo + (int64_t) t*n_lr + j*8 + half*4);
+    }
+    __syncthreads();
+
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int h = lane / 8;
+    const int k = lane % 8;
+    const int d = blockIdx.x*(blockDim.x / WARP_SIZE) + warp;
+    if (d >= n_embd) {
+        return;
+    }
+
+    const uint4 * w = (const uint4 *) (w_up + ((int64_t) h*n_embd + d)*n_lr);
+    float acc[n_t] = {};
+    for (int j = k; j < n_ch; j += 8) {
+        float wv[8];
+        hc_bf16x8(__ldg(w + j), wv);
+#pragma unroll
+        for (int t = 0; t < n_t; ++t) {
+            const float4 a = s_lo4[(0*n_t + t)*n_ch + j];
+            const float4 b = s_lo4[(1*n_t + t)*n_ch + j];
+            acc[t] += wv[0]*a.x + wv[1]*a.y + wv[2]*a.z + wv[3]*a.w + wv[4]*b.x + wv[5]*b.y + wv[6]*b.z + wv[7]*b.w;
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < n_t; ++t) {
+        float v = acc[t];
+        v += __shfl_xor_sync(0xffffffff, v, 1);
+        v += __shfl_xor_sync(0xffffffff, v, 2);
+        v += __shfl_xor_sync(0xffffffff, v, 4);
+        const float gate = 1.0f/(1.0f + expf(-v));
+        float g = xn[(int64_t) t*hc*n_embd + (int64_t) h*n_embd + d]*gate;
+        g += __shfl_xor_sync(0xffffffff, g, 8);
+        g += __shfl_xor_sync(0xffffffff, g, 16);
+        if (lane == 0) {
+            mixed[(int64_t) t*n_embd + d] = g*(1.0f/hc);
+        }
+    }
+}
+
+bool ggml_cuda_hc_mix_supported(const ggml_tensor * op) {
+    const ggml_tensor * x      = op->src[0];
+    const ggml_tensor * w_down = op->src[2];
+    const ggml_tensor * w_up   = op->src[3];
+    const ggml_tensor * w_inj  = op->src[4];
+    const int64_t hc_dim = x->ne[0]*x->ne[1];
+    // zero tokens (a micro-batch without outputs) is an empty node the backend skips; rejecting it would
+    // move the op to the CPU and copy its weights to host memory on every such pass. hc_mix_up keeps lo for
+    // up to HC_MIX_MAX_T tokens in shared memory, within the 48 KiB a launch gets without opting in
+    return w_down->type == GGML_TYPE_BF16 && ggml_is_contiguous(w_down) && ggml_is_contiguous(w_up) &&
+        (!w_inj || ggml_is_contiguous(w_inj)) && x->ne[1] == 4 && x->ne[2] <= HC_MIX_MAX_T &&
+        hc_dim % 8 == 0 && w_down->ne[1] % 8 == 0 && x->ne[0] % 4 == 0 &&
+        w_down->ne[1]*HC_MIX_MAX_T*sizeof(float) <= 48*1024;
+}
+
+void ggml_cuda_op_hc_mix(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x      = dst->src[0];
+    const ggml_tensor * w_norm = dst->src[1];
+    const ggml_tensor * w_down = dst->src[2];
+    const ggml_tensor * w_up   = dst->src[3];
+    const ggml_tensor * w_inj  = dst->src[4];
+
+    constexpr int hc = 4;
+    const int n_embd = (int) x->ne[0];
+    const int n_t    = (int) x->ne[2];
+    const int hc_dim = hc*n_embd;
+    const int n_lr   = (int) w_down->ne[1];
+    const int n_inj  = w_inj ? hc : 0;
+    const float eps  = ggml_get_op_params_f32(dst, 0);
+
+    cudaStream_t stream = ctx.stream();
+    ggml_cuda_pool_alloc<float> xn(ctx.pool(), (size_t) hc_dim*n_t);
+    ggml_cuda_pool_alloc<float> lo(ctx.pool(), (size_t) n_lr*n_t);
+
+    float * mixed  = (float *) dst->data;
+    float * inject = mixed + (int64_t) n_embd*n_t;
+
+    hc_mix_norm<<<dim3(hc, n_t), 256, 0, stream>>>((const float *) x->data, (const float *) w_norm->data, xn.get(), n_embd, eps);
+
+    constexpr int R = 4;
+    const int n_rows = n_lr + n_inj;
+
+    auto launch = [&](auto T) {
+        constexpr int kT = decltype(T)::value;
+        hc_mix_down<kT, R><<<(n_rows + R - 1)/R, 256, 0, stream>>>((const uint16_t *) w_down->data,
+                w_inj ? (const uint16_t *) w_inj->data : nullptr, xn.get(), lo.get(), inject, hc_dim, n_lr, n_inj, 1.0f/hc);
+        // s_lo4: two float4 planes of n_lr/8 per token
+        hc_mix_up<kT, hc><<<(n_embd + 7)/8, 8*WARP_SIZE, kT*n_lr*sizeof(float), stream>>>((const uint16_t *) w_up->data, lo.get(), xn.get(),
+                mixed, n_embd, n_lr);
+    };
+
+    switch (n_t) {
+        case 1: launch(std::integral_constant<int, 1>{}); break;
+        case 2: launch(std::integral_constant<int, 2>{}); break;
+        case 3: launch(std::integral_constant<int, 3>{}); break;
+        case 4: launch(std::integral_constant<int, 4>{}); break;
+        case 5: launch(std::integral_constant<int, 5>{}); break;
+        case 6: launch(std::integral_constant<int, 6>{}); break;
+        case 7: launch(std::integral_constant<int, 7>{}); break;
+        case 8: launch(std::integral_constant<int, 8>{}); break;
+        default: GGML_ABORT("hc_mix supports up to %d tokens", HC_MIX_MAX_T);
+    }
+}
