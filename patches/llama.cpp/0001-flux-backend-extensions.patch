+            GGML_ASSERT(std::abs(llama_get_logits_ith(serial.get(), 0)[j] - logits[i * vocab + j]) < 1e-5f);
+        }
+        for (int j = 0; j < width; ++j) {
+            GGML_ASSERT(std::abs(llama_get_embeddings_nextn_ith(serial.get(), 0)[j] - draft_hidden[i * width + j]) < 1e-5f);
+        }
+    }
+    GGML_ASSERT(llama_memory_seq_rm(llama_get_memory(serial.get()), 0, 3, -1));
+    GGML_ASSERT(llama_decode(serial.get(), one) == 0);
+    for (int j = 0; j < vocab; ++j) {
+        GGML_ASSERT(std::abs(llama_get_logits_ith(serial.get(), 0)[j] - logits[3 * vocab + j]) < 1e-5f);
+    }
+
+    // Exercise the real draft-mtp process/draft/accept hooks against the tiny trunk.
+    llama_memory_clear(llama_get_memory(target.get()), true);
+    llama_memory_clear(llama_get_memory(draft.get()), true);
+    llama_set_embeddings_nextn(target.get(), true, false);
+    common_params_speculative sp;
