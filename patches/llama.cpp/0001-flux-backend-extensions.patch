+static void ggml_cuda_op_profile_finish(ggml_cuda_op_profile * prof, ggml_backend_cuda_context * ctx) {
+    const size_t n = prof->nodes.size();
+    if (n == 0) {
+        return;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(ctx->stream()));
+
+    float ms = 0.0f;
+    CUDA_CHECK(cudaEventElapsedTime(&ms, prof->events[0], prof->events[2*n - 1]));
