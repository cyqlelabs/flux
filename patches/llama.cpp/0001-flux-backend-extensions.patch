+    };
+    if (!ggml_backend_buffer_is_cuda(buffer)) {
+        return nullptr;
+    }
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    return ctx->paged ? &paging : nullptr;
