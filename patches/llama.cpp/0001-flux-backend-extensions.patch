+static __global__ void count_ids(const char * __restrict__ ids, float * __restrict__ counts,
+        const int64_t ne0, const int64_t n, const size_t nb0, const size_t nb1, const int64_t n_counts) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+
+    const int32_t id = *(const int32_t *) (ids + (i % ne0)*nb0 + (i / ne0)*nb1);
+    if (id >= 0 && id < n_counts) {
+        atomicAdd(counts + id, 1.0f);
+    }
+}
+
+void ggml_cuda_count_ids(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * ids = dst->src[1];
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+
+    const int64_t n = ids->ne[0]*ids->ne[1];
+    if (n == 0) {
+        return;
+    }
+
+    const int bs = 256;
+    count_ids<<<(n + bs - 1) / bs, bs, 0, ctx.stream()>>>(
+        (const char *) ids->data, (float *) dst->data, ids->ne[0], n, ids->nb[0], ids->nb[1], dst->ne[0]);
+}
