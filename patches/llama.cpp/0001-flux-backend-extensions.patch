+static bool ggml_cuda_page_create(int device, ggml_backend_page_location location, CUmemGenericAllocationHandle & handle) {
+    CUmemAllocationProp prop{};
+    return ggml_cuda_page_prop(device, location, prop) && cuMemCreate(&handle, GGML_CUDA_PAGE_SIZE, &prop, 0) == CUDA_SUCCESS;
+}
