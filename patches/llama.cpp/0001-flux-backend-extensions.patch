+    for (auto & region : page_regions) {
+        auto * tensor = region.tensor;
+        const size_t base = (char *) tensor->data - (char *) ggml_backend_buffer_get_base(tensor->buffer);
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            const size_t used = std::max(v_cells[s].used_max_p1(), reserved_cells[s]);
+            const size_t padded_cells = std::min<size_t>(get_size(), GGML_PAD(used, std::max(n_pad, 256u)));
+            const size_t keep = used == 0 ? 0 : std::min(tensor->nb[2],
+                    GGML_PAD(padded_cells*tensor->nb[1], region.page_size) + region.page_size);
+            const size_t old = region.committed[s];
+            if (old > keep && release_pages(tensor->buffer, base + s*tensor->nb[2] + keep, old - keep)) {
