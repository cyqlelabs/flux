+// flux: adaptive GPU expert cache of a context (see llama_moe_cache_init)
+// a cached layer keeps its full expert tensors in host memory (the cold part) and gets GPU slot pools (the hot part)
+// the host counts the expert selections, swaps experts between graph computes and refills slots from a worker thread
+struct llama_moe_cache {
+    struct layer {
+        int32_t il      = -1;
+        int32_t n_slots = 0;
+
+        ggml_tensor * src [4] = {}; // host expert tensors: up, gate, down, gate_up
+        ggml_tensor * pool[4] = {}; // GPU slot pools, in the same order
+
+        ggml_backend_t backend      = nullptr; // compute backend of the layer device
+        ggml_backend_t backend_copy = nullptr; // refill stream of the layer device
+
+        std::vector<int32_t> slot;     // [n_expert] slot of a resident expert, -1 if not resident
+        std::vector<int32_t> expert;   // [n_slots] expert in the slot or being copied to it, -1 if free
+        std::vector<float>   map_hot;  // [2, n_expert] host copy of the GPU map
+        std::vector<float>   map_cold; // [2, n_expert] host copy of the GPU map
+        std::vector<float>   score;    // [n_expert] decayed selection counts
+        std::vector<float>   acc;      // [n_expert] selections since the last round
+
+        bool dirty = false; // the maps changed since the last write
+    };
+
+    struct job {
+        int32_t layer;
+        int32_t expert;
+        int32_t slot;
+    };
+
+    ~llama_moe_cache();
+
+    // call after a decode: admit finished refills, and every n_interval graphs evict and refill experts
+    void update();
+
+    // the part of an update round for the tiers: swap experts into tier slots, at most n_swap_tier
+    void update_tiers();
+
+    // add the GPU selection counts to the scores and stats, then zero them; waits for the running graphs
