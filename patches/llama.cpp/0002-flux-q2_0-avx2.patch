+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK2_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_0 * GGML_RESTRICT x = vx;
+    const block_q8_0 * GGML_RESTRICT y = vy;
+
+#if defined(__AVX2__)
+    // Byte b of a block packs weights 4b..4b+3. Gathering the activations by stride 4 (per 16-byte lane) puts
+    // them in the order of the 2-bit planes, so one shift per 32-bit lane extracts a plane.
+    const __m256i gather = _mm256_setr_epi8(0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15,
+                                            0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15);
+    const __m256i shifts = _mm256_setr_epi32(0, 2, 4, 6, 0, 2, 4, 6);
+    const __m256i mask   = _mm256_set1_epi8(3);
+    const __m256i one    = _mm256_set1_epi8(1);
+
+    __m256 acc = _mm256_setzero_ps();
+
+    for (int i = 0; i < nb; i++) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+
+        // group 64: one Q2_0 block (64 weights) maps to two Q8_0 blocks (2 * 32 = 64)
+        for (int k = 0; k < 2; k++) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[i * 2 + k];
+
+            uint32_t lo, hi;
+            memcpy(&lo, x[i].qs + 8 * k, 4);
+            memcpy(&hi, x[i].qs + 8 * k + 4, 4);
+
+            const __m256i packed = _mm256_setr_epi32(lo, lo, lo, lo, hi, hi, hi, hi);
+            // map {0,1,2,3} -> {-1,0,1,2}
+            const __m256i qx = _mm256_sub_epi8(_mm256_and_si256(_mm256_srlv_epi32(packed, shifts), mask), one);
+            const __m256i qy = _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i *) yb->qs), gather);
+
+            const __m256 d = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(yb->d));
+            acc = _mm256_fmadd_ps(d, mul_sum_i8_pairs_float(qx, qy), acc);
+        }
+    }
+
+    *s = hsum_float_8(acc);
+#else
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
